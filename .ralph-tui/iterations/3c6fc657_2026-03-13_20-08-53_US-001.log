{"type":"tool_use","timestamp":1773393611606,"sessionID":"ses_b101e17e471a","part":{"type":"tool","callID":"call_wiohr7ze","tool":"read","state":{"status":"completed","input":{"file_path":"tests/unit/test_caption_generator_get_caption_generator.py"},"output":"     1\t\"\"\"Tests for get_caption_generator singleton behavior.\n     2\t\n     3\tTests for the get_caption_generator function which provides a singleton\n     4\tCaptionGenerator instance.\n     5\t\"\"\"\n     6\t\n     7\timport threading\n     8\t\n     9\tfrom caption_generator import get_caption_generator, CaptionGenerator\n    10\t\n    11\t\n    12\tclass TestGetCaptionGenerator:\n    13\t    \"\"\"Test suite for get_caption_generator singleton behavior.\"\"\"\n    14\t\n    15\t    def test_get_caption_generator_returns_instance(self):\n    16\t        \"\"\"Test that get_caption_generator returns CaptionGenerator instance.\"\"\"\n    17\t        result = get_caption_generator()\n    18\t        assert isinstance(result, CaptionGenerator)\n    19\t\n    20\t    def test_get_caption_generator_singleton(self):\n    21\t        \"\"\"Test that get_caption_generator returns the same instance.\"\"\"\n    22\t        instance1 = get_caption_generator()\n    23\t        instance2 = get_caption_generator()\n    24\t        assert instance1 is instance2\n    25\t\n    26\t    def test_get_caption_generator_initialization(self):\n    27\t        \"\"\"Test that returned instance has all expected attributes.\"\"\"\n    28\t        instance = get_caption_generator()\n    29\t        assert hasattr(instance, 'florence_model')\n    30\t        assert hasattr(instance, 'wd14_model')\n    31\t        assert instance.florence_model is None\n    32\t        assert instance.wd14_model is None\n    33\t\n    34\t    def test_get_caption_generator_no_side_effects(self):\n    35\t        \"\"\"Test that multiple calls don't create additional instances.\"\"\"\n    36\t        instances = [get_caption_generator() for _ in range(10)]\n    37\t        assert all(instance is instances[0] for instance in instances)\n    38\t\n    39\t    def test_get_caption_generator_thread_safety(self):\n    40\t        \"\"\"Test that get_caption_generator is thread safe.\"\"\"\n    41\t        instances = []\n    42\t        threads = []\n    43\t\n    44\t        def get_instance():\n    45\t            instances.append(get_caption_generator())\n    46\t\n    47\t        for _ in range(10):\n    48\t            thread = threading.Thread(target=get_instance)\n    49\t            threads.append(thread)\n    50\t            thread.start()\n    51\t\n    52\t        for thread in threads:\n    53\t            thread.join()\n    54\t\n    55\t        assert all(instance is instances[0] for instance in instances)\n    56\t\n    57\t    def test_get_caption_generator_global_state(self):\n    58\t        \"\"\"Test that the function uses a global variable _generator_instance.\"\"\"\n    59\t        # This is implicitly tested by the singleton behavior\n    60\t        # We can verify by checking the module has this attribute\n    61\t        import caption_generator\n    62\t        assert hasattr(caption_generator, '_generator_instance')\n    63\t\n    64\t    def test_get_caption_generator_initial_state(self):\n    65\t        \"\"\"Test that the returned instance has correct initial state.\"\"\"\n    66\t        instance = get_caption_generator()\n    67\t        assert hasattr(instance, '_florence_loaded')\n    68\t        assert hasattr(instance, '_wd14_loaded')\n    69\t        assert instance._florence_loaded is False\n    70\t        assert instance._wd14_loaded is False","time":{"start":1773393611606,"end":1773393611606}}}}
