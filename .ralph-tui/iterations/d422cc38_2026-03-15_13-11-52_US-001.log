{"type":"tool_use","timestamp":1773541930327,"sessionID":"ses_237f0053112a","part":{"type":"tool","callID":"call_mw0aqf9t","tool":"write","state":{"status":"completed","input":{"content":"\"\"\"Tests for CaptionWindow._setup_menu method.\"\"\"\n\nfrom PySide6.QtWidgets import QMenuBar, QMenu\nfrom PySide6.QtGui import QAction\nfrom caption_window import CaptionWindow\n\n\nclass TestCaptionWindowSetupMenu:\n    \"\"\"Test suite for CaptionWindow._setup_menu method.\"\"\"\n\n    def test_menu_bar_created(self):\n        \"\"\"Test that menuBar() returns a QMenuBar instance.\"\"\"\n        window = CaptionWindow([], 0)\n        menu_bar = window.menuBar()\n        assert isinstance(menu_bar, QMenuBar), \"menuBar() should return a QMenuBar instance\"\n\n    def test_options_menu_created(self):\n        \"\"\"Test that options menu is created in the menu bar.\"\"\"\n        window = CaptionWindow([], 0)\n        menu_bar = window.menuBar()\n        # Get all menus and find the one with title \"&Options\"\n        all_menus = menu_bar.findChildren(QMenu)\n        options_menus = [m for m in all_menus if m.title() == '&Options']\n        assert len(options_menus) == 1, f\"Should have exactly one '&Options' menu, found {len(options_menus)}\"\n\n    def test_fit_to_window_action_created(self):\n        \"\"\"Test that fit to window action is created correctly.\"\"\"\n        window = CaptionWindow([], 0)\n        assert window.fit_act is not None, \"fit_act should be created\"\n        assert isinstance(window.fit_act, QAction), \"fit_act should be a QAction\"\n        assert window.fit_act.text() == '&Fit to Window', \"Action text should be '&Fit to Window'\"\n        assert window.fit_act.isCheckable(), \"Action should be checkable\"\n        assert window.fit_act.isChecked() == window.fit_to_window, \"Checked state should match fit_to_window\"\n\n    def test_native_size_action_created(self):\n        \"\"\"Test that native size action is created correctly.\"\"\"\n        window = CaptionWindow([], 0)\n        assert window.native_act is not None, \"native_act should be created\"\n        assert isinstance(window.native_act, QAction), \"native_act should be a QAction\"\n        assert window.native_act.text() == '&Native Size', \"Action text should be '&Native Size'\"\n        assert window.native_act.isCheckable(), \"Action should be checkable\"\n        assert window.native_act.isChecked() == (not window.fit_to_window), \"Checked state should be opposite of fit_to_window\"\n\n    def test_fit_action_connected_to_toggle_fit_mode(self):\n        \"\"\"Test that fit action is connected to toggle_fit_mode method.\"\"\"\n        window = CaptionWindow([], 0)\n        # Verify the signal is connected by checking if the method exists and can be called\n        # We can't use receivers() reliably in PySide6, so we test by triggering the action\n        # and checking that it doesn't raise an error\n        try:\n            window.fit_act.trigger()\n            # If we get here, the signal was connected successfully\n            assert True\n        except Exception as e:\n            assert False, f\"fit_act.triggered should be connected to toggle_fit_mode: {e}\"\n\n    def test_native_action_connected_to_set_native_size(self):\n        \"\"\"Test that native size action is connected to set_native_size method.\"\"\"\n        window = CaptionWindow([], 0)\n        # Verify the signal is connected by triggering the action\n        try:\n            window.native_act.trigger()\n            # If we get here, the signal was connected successfully\n            assert True\n        except Exception as e:\n            assert False, f\"native_act.triggered should be connected to set_native_size: {e}\"\n\n    def test_actions_added_to_menu(self):\n        \"\"\"Test that actions are added to the options menu.\"\"\"\n        window = CaptionWindow([], 0)\n        menu_bar = window.menuBar()\n        # Get all menus and find the one with title \"&Options\"\n        all_menus = menu_bar.findChildren(QMenu)\n        options_menus = [m for m in all_menus if m.title() == '&Options']\n        assert len(options_menus) == 1, f\"Should have exactly one '&Options' menu, found {len(options_menus)}\"\n        options_menu = options_menus[0]\n        actions = options_menu.actions()\n        assert window.fit_act in actions, \"fit_act should be in options menu actions\"\n        assert window.native_act in actions, \"native_act should be in options menu actions\"\n","file_path":"tests/unit/test_caption_window_CaptionWindow__setup_menu.py"},"output":"Wrote 4156 bytes to tests/unit/test_caption_window_CaptionWindow__setup_menu.py","time":{"start":1773541930327,"end":1773541930327}}}}
