ns = pos_embed_shape[1]\n  1291\t\n  1292\t            # Try with CLS token (num_patches = num_positions - 1)\n  1293\t            num_patches = num_positions - 1\n  1294\t            if patch_size:\n  1295\t                # img_size = sqrt(num_patches) * patch_size\n  1296\t                import math\n  1297\t\n  1298\t                patches_per_side = math.sqrt(num_patches)\n  1299\t                if patches_per_side == int(patches_per_side):\n  1300\t                    img_size = int(patches_per_side) * patch_size\n  1301\t                    _debug(f\"Detected image size from pos_embed (with CLS): {img_size}\")\n  1302\t                else:\n  1303\t                    # Try without CLS token\n  1304\t                    patches_per_side = math.sqrt(num_positions)\n  1305\t                    if patches_per_side == int(patches_per_side):\n  1306\t                        img_size = int(patches_per_side) * patch_size\n  1307\t                        _debug(\n  1308\t                            f\"Detected image size from pos_embed (no CLS): {img_size}\"\n  1309\t                        )\n  1310\t\n  1311\t        # Determine base architecture from model key\n  1312\t        # Use generic names WITHOUT size suffix so timm respects the img_size parameter\n  1313\t        base_model = \"vit_base_patch16\"  # default\n  1314\t\n  1315\t        if \"vit\" in model_key.lower():\n  1316\t            # ViT-based models - use generic names without size suffix\n  1317\t            if patch_size == 14:\n  1318\t                base_model = \"vit_base_patch14\"\n  1319\t            elif patch_size == 16:\n  1320\t                base_model = \"vit_base_patch16\"\n  1321\t        elif \"swin\" in model_key.lower():\n  1322\t            base_model = \"swinv2_base_window12to16_192to256\"\n  1323\t            img_size = 256  # SwinV2 uses different size\n  1324\t        elif \"convnext\" in model_key.lower():\n  1325\t            base_model = \"convnextv2_base\"\n  1326\t            img_size = 224  # ConvNeXt default\n  1327\t        elif \"moat\" in model_key.lower():\n  1328\t            base_model = \"mobilevitv2_150\"\n  1329\t            img_size = 256  # MobileVit default\n  1330\t\n  1331\t        return base_model, img_size\n  1332\t\n  1333\t    def generate_wd14(\n  1334\t        self, image_path: str, model_key: str = \"vit-v2\", threshold: float = 0.35\n  1335\t    ) -> str:\n  1336\t        \"\"\"Generate tags using WD14 tagger.\n  1337\t\n  1338\t        Args:","time":{"start":1773335360850,"end":1773335360850}}}}
