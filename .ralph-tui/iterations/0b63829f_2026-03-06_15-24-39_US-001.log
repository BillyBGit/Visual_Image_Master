        backend_row.addWidget(QLabel(\"Backend:\"))\n    53\t        self.backend_combo = QComboBox()\n    54\t        self.backend_combo.addItem(\"Florence2 (Local)\", \"florence2\")\n    55\t        self.backend_combo.addItem(\"WD14 Tagger (Local)\", \"wd14\")\n    56\t        self.backend_combo.addItem(\"Ollama (Server)\", \"ollama\")\n    57\t        self.backend_combo.currentIndexChanged.connect(self._on_backend_changed)\n    58\t        backend_row.addWidget(self.backend_combo, 1)\n    59\t        backend_layout.addLayout(backend_row)\n    60\t\n    61\t        # Florence2 settings\n    62\t        self.florence_widget = QGroupBox(\"Florence2 Settings\")\n    63\t        florence_layout = QVBoxLayout(self.florence_widget)\n    64\t\n    65\t        model_row = QHBoxLayout()\n    66\t        model_row.addWidget(QLabel(\"Model:\"))\n    67\t        self.florence_model_combo = QComboBox()\n    68\t        self.florence_model_combo.addItem(\"Base (~460MB)\", \"base\")\n    69\t        self.florence_model_combo.addItem(\"Large (~1.5GB)\", \"large\")\n    70\t        self.florence_model_combo.addItem(\"Base Fine-tuned (~460MB)\", \"base-ft\")\n    71\t        self.florence_model_combo.addItem(\"Large Fine-tuned (~1.5GB)\", \"large-ft\")\n    72\t        model_row.addWidget(self.florence_model_combo, 1)\n    73\t        florence_layout.addLayout(model_row)\n    74\t\n    75\t        detail_row = QHBoxLayout()\n    76\t        detail_row.addWidget(QLabel(\"Detail:\"))\n    77\t        self.florence_detail_combo = QComboBox()\n    78\t        self.florence_detail_combo.addItem(\"Brief (short caption)\", \"brief\")\n    79\t        self.florence_detail_combo.addItem(\"Standard\", \"standard\")\n    80\t        self.florence_detail_combo.addItem(\"Detailed (comprehensive)\", \"detailed\")\n    81\t        self.florence_detail_combo.setCurrentIndex(2)\n    82\t        detail_row.addWidget(self.florence_detail_combo, 1)\n    83\t        florence_layout.addLayout(detail_row