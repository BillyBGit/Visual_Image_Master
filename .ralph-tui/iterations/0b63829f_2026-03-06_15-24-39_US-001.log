end hides other widgets.\"\"\"\n        dialog = AutoCaptionDialog([])\n        \n        # First set to florence2\n        dialog.backend_combo.setCurrentData(\"florence2\")\n        dialog._on_backend_changed(0)\n        assert dialog.florence_widget.isVisible() is True\n        assert dialog.wd14_widget.isVisible() is False\n        assert dialog.ollama_widget.isVisible() is False\n        \n        # Then change to wd14\n        dialog.backend_combo.setCurrentData(\"wd14\")\n        dialog._on_backend_changed(1)\n        assert dialog.florence_widget.isVisible() is False\n        assert dialog.wd14_widget.isVisible() is True\n        assert dialog.ollama_widget.isVisible() is False\n\n    def test_backend_change_updates_visibility_correctly(self):\n        \"\"\"Test that backend changes update visibility correctly for all options.\"\"\"\n        dialog = AutoCaptionDialog([])\n        \n        # Test florence2\n        dialog.backend_combo.setCurrentData(\"florence2\")\n        dialog._on_backend_changed(0)\n        assert dialog.florence_widget.isVisible() is True\n        assert dialog.wd14_widget.isVisible() is False\n        assert dialog.ollama_widget.isVisible() is False\n        \n        # Test wd14\n        dialog.backend_combo.setCurrentData(\"wd14\")\n        dialog._on_backend_changed(1)\n        assert dialog.florence_widget.isVisible() is False\n        assert dialog.wd14_widget.isVisible() is True\n        assert dialog.ollama_widget.isVisible() is False\n        \n        # Test ollama\n        dialog.backend_combo.setCurrentData(\"ollama\")\n        dialog._on_backend_changed(2)\n        assert dialog.florence_widget.isVisible() is False\n        assert dialog.wd14_widget.isVisible() is False\n        assert dialog.ollama_widget.isVisible() is True\n\n    def test_backend_change_with_invalid_index(self):\n        \"\"\"Test that invalid index doesn't crash and maintains default state.\"\"\"\n        dialog = AutoCaptionDialog([])\n        dialog._on_backend_changed(999)  # Invalid index\n        \n        # Should be in default state (all widgets hidden)\n        assert dialog.florence_widget.isVisible() is False\n        assert dialog.wd14_widget.isVisible() is False\n        assert dialog.ollama_widget.isVisible() is False\n\n    def test_backend_change_preserves_other_ui_elements(self):\n        \"\"\"Test that changing backend preserves other UI elements.\"\"\"\n        dialog = AutoCaptionDialog([])\n        \n        # Store initial state of other UI elements\n        initial_progress_visible = dialog.progress_bar.isVisible()\n        initial_button_text = dialog.generate_button.text()\n        \n        # Change backend\n        dialog.backend_combo.setCurrentData(\"florence2\")\n        dialog._on_backend_changed(0)\n        \n        # Verify other UI elements are unchanged\n        assert dialog.progress_bar.isVisible() == initial_progress_visible\n        assert dialog.generate_button.text() == initial_button_text\n"},"output":"Wrote 4546 bytes to tests/unit/test_autocaption_dialog_AutoCaptionDialog__on_backend_changed.py","time":{"start":1772771320017,"end":1772771320017}}}}
