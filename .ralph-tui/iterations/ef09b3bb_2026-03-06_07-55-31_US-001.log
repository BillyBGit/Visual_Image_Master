{"type":"tool_use","timestamp":1772744154664,"sessionID":"ses_ac7495e7883c","part":{"type":"tool","callID":"call_09u45cwr","tool":"read","state":{"status":"completed","input":{"file_path":"tests/unit/test_advanced_filter_dialog_AdvancedFilterDialog_setup_ui.py"},"output":"     1\t\"\"\"Tests for AdvancedFilterDialog.setup_ui method.\"\"\"\n     2\t\n     3\timport pytest\n     4\tfrom PyQt6.QtWidgets import QApplication, QVBoxLayout, QScrollArea, QCheckBox, QPushButton\n     5\tfrom advanced_filter_dialog import AdvancedFilterDialog\n     6\t\n     7\t\n     8\t# Qt application instance for testing\n     9\t@pytest.fixture(scope=\"module\")\n    10\tdef qt_app():\n    11\t    \"\"\"Qt application fixture for testing.\"\"\"\n    12\t    app = QApplication.instance()\n    13\t    if app is None:\n    14\t        app = QApplication([])\n    15\t    yield app\n    16\t    # app.quit()  # Don't quit, as other tests might need it\n    17\t\n    18\t\n    19\tclass TestAdvancedFilterDialogSetupUi:\n    20\t    \"\"\"Test suite for AdvancedFilterDialog.setup_ui method.\"\"\"\n    21\t\n    22\t    def test_setup_ui_creates_main_layout(self):\n    23\t        \"\"\"Test that the dialog has a QVBoxLayout as its main layout.\"\"\"\n    24\t        dialog = AdvancedFilterDialog()\n    25\t        assert dialog.layout() is not None\n    26\t        assert isinstance(dialog.layout(), QVBoxLayout)\n    27\t\n    28\t    def test_setup_ui_creates_scroll_area(self):\n    29\t        \"\"\"Test that the dialog contains a QScrollArea widget.\"\"\"\n    30\t        dialog = AdvancedFilterDialog()\n    31\t        # Find the scroll area in the layout\n    32\t        scroll_area = None\n    33\t        for i in range(dialog.layout().count()):\n    34\t            widget = dialog.layout().itemAt(i).widget()\n    35\t            if isinstance(widget, QScrollArea):\n    36\t                scroll_area = widget\n    37\t                break\n    38\t        assert scroll_area is not None\n    39\t\n    40\t    def test_setup_ui_creates_filter_sections(self):\n    41\t        \"\"\"Test that the scroll area contains all filter sections.\"\"\"\n    42\t        dialog = AdvancedFilterDialog()\n    43\t        # Find the scroll area\n    44\t        scroll_area = None\n    45\t        for i in range(dialog.layout().count()):\n    46\t            widget = dialog.layout().itemAt(i).widget()\n    47\t            if isinstance(widget, QScrollArea):\n    48\t                scroll_area = widget\n    49\t                break\n    50\t        assert scroll_area is not None\n    51\t\n    52\t        # Get the scroll widget and its layout\n    53\t        scroll_widget = scroll_area.widget()\n    54\t        scroll_layout = scroll_widget.layout()\n    55\t\n    56\t        # Check that all filter sections are present\n    57\t        assert scroll_layout.count() == 5, \"Should have 5 filter sections\"\n    58\t\n    59\t    def test_setup_ui_creates_global_invert_checkbox(self):\n    60\t        \"\"\"Test that the dialog contains the global invert checkbox.\"\"\"\n    61\t        dialog = AdvancedFilterDialog()\n    62\t        # Find the global invert checkbox\n    63\t        global_invert_cb = None\n    64\t        for i in range(dialog.layout().count()):\n    65\t            widget = dialog.layout().itemAt(i).widget()\n    66\t            if isinstance(widget, QCheckBox):\n    67\t                global_invert_cb = widget\n    68\t                break\n    69\t        assert global_invert_cb is not None\n    70\t        assert global_invert_cb.text() == \"Invert entire filter (show what does NOT match)\"\n    71\t\n    72\t    def test_setup_ui_creates_buttons(self):\n    73\t        \"\"\"Test that the dialog contains all three buttons.\"\"\"\n    74\t        dialog = AdvancedFilterDialog()\n    75\t        # Find the button layout (should be the last item in main layout)\n    76\t        button_layout = None\n    77\t        for i in range(dialog.layout().count()):\n    78\t            item = dialog.layout().itemAt(i)\n    79\t            if item.layout() is not None:\n    80\t                button_layout = item.layout()\n    81\t\n    82\t        assert button_layout is not None\n    83\t\n    84\t        # Check that all three buttons are present\n    85\t        button_texts = []\n    86\t        for i in range(button_layout.count()):\n    87\t            widget = button_layout.itemAt(i).widget()\n    88\t            if isinstance(widget, QPushButton):\n    89\t                button_texts.append(widget.text())\n    90\t\n    91\t        assert \"Apply Filters\" in button_texts\n    92\t        assert \"Clear All\" in button_texts\n    93\t        assert \"Cancel\" in button_texts\n    94\t\n    95\t    def test_setup_ui_connects_signals(self):\n    96\t        \"\"\"Test that all signal connections are properly set up.\"\"\"\n    97\t        dialog = AdvancedFilterDialog()\n    98\t\n    99\t        # Check global_invert_cb connection\n   100\t        assert dialog.global_invert_cb.stateChanged.connect is not None\n   101\t\n   102\t        # Check button connections\n   103\t        assert dialog.apply_btn.clicked.connect is not None\n   104\t        assert dialog.clear_btn.clicked.connect is not None\n   105\t        assert dialog.cancel_btn.clicked.connect is not None\n   106\t\n   107\t    def test_setup_ui_layout_structure(self):\n   108\t        \"\"\"Test the layout hierarchy structure.\"\"\"\n   109\t        dialog = AdvancedFilterDialog()\n   110\t        main_layout = dialog.layout()\n   111\t\n   112\t        # Find scroll area\n   113\t        scroll_area = None\n   114\t        global_invert_cb = None\n   115\t        button_layout = None\n   116\t\n   117\t        for i in range(main_layout.count()):\n   118\t            item = main_layout.itemAt(i)\n   119\t            widget = item.widget() if item.widget() else None\n   120\t            layout = item.layout() if item.layout() else None\n   121\t\n   122\t            if isinstance(widget, QScrollArea):\n   123\t                scroll_area = widget\n   124\t            elif isinstance(widget, QCheckBox):\n   125\t                global_invert_cb = widget\n   126\t            elif layout is not None:\n   127\t                button_layout = layout\n   128\t\n   129\t        assert scroll_area is not None, \"Scroll area should be in main layout\"\n   130\t        assert global_invert_cb is not None, \"Global invert checkbox should be in main layout\"\n   131\t        assert button_layout is not None, \"Button layout should be in main layout\"\n   132\t\n   133\t        # Check button layout contains the three buttons\n   134\t        button_widgets = []\n   135\t        for i in range(button_layout.count()):\n   136\t            widget = button_layout.itemAt(i).widget()\n   137\t            if isinstance(widget, QPushButton):\n   138\t                button_widgets.append(widget)\n   139\t\n   140\t        assert len(button_widgets) == 3, \"Button layout should contain 3 buttons\"","time":{"start":1772744154664,"end":1772744154664}}}}
