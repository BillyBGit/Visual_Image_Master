{"type":"tool_use","timestamp":1773238539641,"sessionID":"ses_8eb1d7064a9a","part":{"type":"tool","callID":"call_11pkx4k5","tool":"write","state":{"status":"completed","input":{"file_path":"tests/unit/test_caption_generator_CaptionGenerator_is_wd14_available.py","content":"\"\"\"Tests for CaptionGenerator.is_wd14_available() method.\"\"\"\n\nimport sys\nfrom unittest.mock import patch\nimport pytest\n\nfrom caption_generator import CaptionGenerator\n\n\nclass TestCaptionGeneratorIsWd14Available:\n    \"\"\"Test suite for CaptionGenerator.is_wd14_available() method.\"\"\"\n\n    def test_is_wd14_available_with_onnx_and_torch(self):\n        \"\"\"Test with both ONNX and PyTorch backends available.\"\"\"\n        with patch.dict(sys.modules, {\n            'onnxruntime': type(sys)('onnxruntime'),\n            'torch': type(sys)('torch'),\n            'huggingface_hub': type(sys)('huggingface_hub')\n        }):\n            generator = CaptionGenerator()\n            result = generator.is_wd14_available()\n            assert result == (True, 'WD14 ready (ONNX, PyTorch)')\n\n    def test_is_wd14_available_with_only_onnx(self):\n        \"\"\"Test with only ONNX backend available.\"\"\"\n        with patch.dict(sys.modules, {\n            'onnxruntime': type(sys)('onnxruntime'),\n            'huggingface_hub': type(sys)('huggingface_hub')\n        }):\n            generator = CaptionGenerator()\n            result = generator.is_wd14_available()\n            assert result == (True, 'WD14 ready (ONNX)')\n\n    def test_is_wd14_available_with_only_torch(self):\n        \"\"\"Test with only PyTorch backend available.\"\"\"\n        with patch.dict(sys.modules, {\n            'torch': type(sys)('torch'),\n            'huggingface_hub': type(sys)('huggingface_hub')\n        }):\n            generator = CaptionGenerator()\n            result = generator.is_wd14_available()\n            assert result == (True, 'WD14 ready (PyTorch)')\n\n    def test_is_wd14_available_without_onnx_or_torch(self):\n        \"\"\"Test with neither ONNX nor PyTorch backend available.\"\"\"\n        with patch.dict(sys.modules, {\n            'huggingface_hub': type(sys)('huggingface_hub')\n        }):\n            generator = CaptionGenerator()\n            result = generator.is_wd14_available()\n            assert result == (\n                False,\n                \"Missing model backend. Install onnxruntime or torch: pip install onnxruntime\"\n            )\n\n    def test_is_wd14_available_without_huggingface_hub(self):\n        \"\"\"Test with huggingface_hub unavailable.\"\"\"\n        generator = CaptionGenerator()\n        result = generator.is_wd14_available()\n        assert result == (\n            False,\n            \"Missing: huggingface_hub. Install with: pip install huggingface-hub\"\n        )\n\n    def test_is_wd14_available_without_onnx_or_torch_and_huggingface_hub(self):\n        \"\"\"Test with all dependencies unavailable.\"\"\"\n        generator = CaptionGenerator()\n        result = generator.is_wd14_available()\n        assert result == (\n            False,\n            \"Missing: huggingface_hub. Install with: pip install huggingface-hub\"\n        )\n\n    def test_is_wd14_available_with_all_dependencies(self):\n        \"\"\"Test with all dependencies available.\"\"\"\n        with patch.dict(sys.modules, {\n            'onnxruntime': type(sys)('onnxruntime'),\n            'torch': type(sys)('torch'),\n            'huggingface_hub': type(sys)('huggingface_hub')\n        }):\n            generator = CaptionGenerator()\n            result = generator.is_wd14_available()\n            assert result == (True, 'WD14 ready (ONNX, PyTorch)')\n"},"output":"Wrote 3285 bytes to tests/unit/test_caption_generator_CaptionGenerator_is_wd14_available.py","time":{"start":1773238539641,"end":1773238539641}}}}
