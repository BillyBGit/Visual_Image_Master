  self.quality_meets_rb = QRadioButton(\"Meets criteria\")\n   293\t        self.quality_meets_rb.setChecked(True)\n   294\t        self.quality_meets_rb.toggled.connect(self.update_filter_settings)\n   295\t        self.quality_not_meets_rb = QRadioButton(\"Does NOT meet criteria\")\n   296\t        self.quality_not_meets_rb.toggled.connect(self.update_filter_settings)\n   297\t        mode_layout.addWidget(self.quality_meets_rb)\n   298\t        mode_layout.addWidget(self.quality_not_meets_rb)\n   299\t        mode_layout.addStretch()\n   300\t        layout.addLayout(mode_layout)","time":{"start":1772749325589,"end":1772749325589}}}}
