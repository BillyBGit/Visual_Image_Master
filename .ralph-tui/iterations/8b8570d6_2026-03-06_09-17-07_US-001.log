{"type":"tool_use","timestamp":1772749420764,"sessionID":"ses_fb9c021eb5b2","part":{"type":"tool","callID":"call_059ywx56","tool":"read","state":{"status":"completed","input":{"file_path":"tests/unit/test_advanced_filter_dialog_AdvancedFilterDialog_create_face_filter_section.py"},"output":"     1\t\"\"\"Tests for AdvancedFilterDialog.create_face_filter_section method.\"\"\"\n     2\t\n     3\timport sys\n     4\tfrom PySide6.QtWidgets import (\n     5\t    QApplication,\n     6\t    QGroupBox,\n     7\t    QCheckBox,\n     8\t    QRadioButton,\n     9\t    QSlider,\n    10\t    QLabel,\n    11\t)\n    12\tfrom advanced_filter_dialog import AdvancedFilterDialog\n    13\t\n    14\t# Create QApplication instance for testing\n    15\tapp = QApplication(sys.argv)\n    16\t\n    17\t\n    18\tdef test_create_face_filter_section_returns_qgroupbox():\n    19\t    \"\"\"Test that create_face_filter_section returns a QGroupBox instance.\"\"\"\n    20\t    dialog = AdvancedFilterDialog()\n    21\t    result = dialog.create_face_filter_section()\n    22\t    assert isinstance(result, QGroupBox), (\n    23\t        \"create_face_filter_section should return a QGroupBox\"\n    24\t    )\n    25\t\n    26\t\n    27\tdef test_face_filter_section_has_correct_title():\n    28\t    \"\"\"Test that the QGroupBox has the correct title.\"\"\"\n    29\t    dialog = AdvancedFilterDialog()\n    30\t    group = dialog.create_face_filter_section()\n    31\t    assert group.title() == \"Face Detection\", (\n    32\t        \"QGroupBox title should be 'Face Detection'\"\n    33\t    )\n    34\t\n    35\t\n    36\tdef test_face_filter_section_has_enable_checkbox():\n    37\t    \"\"\"Test that the section contains a QCheckBox with text 'Filter by faces'.\"\"\"\n    38\t    dialog = AdvancedFilterDialog()\n    39\t    group = dialog.create_face_filter_section()\n    40\t\n    41\t    # Find the checkbox in the group's layout\n    42\t    checkbox = None\n    43\t    for widget in group.findChildren(QCheckBox):\n    44\t        if widget.text() == \"Filter by faces\":\n    45\t            checkbox = widget\n    46\t            break\n    47\t\n    48\t    assert checkbox is not None, (\n    49\t        \"Should contain a QCheckBox with text 'Filter by faces'\"\n    50\t    )\n    51\t\n    52\t\n    53\tdef test_face_filter_section_has_contains_radio_button():\n    54\t    \"\"\"Test that the section contains a QRadioButton with text 'Contains'.\"\"\"\n    55\t    dialog = AdvancedFilterDialog()\n    56\t    group = dialog.create_face_filter_section()\n    57\t\n    58\t    # Find the radio button in the group's layout\n    59\t    radio_button = None\n    60\t    for widget in group.findChildren(QRadioButton):\n    61\t        if widget.text() == \"Contains\":\n    62\t            radio_button = widget\n    63\t            break\n    64\t\n    65\t    assert radio_button is not None, (\n    66\t        \"Should contain a QRadioButton with text 'Contains'\"\n    67\t    )\n    68\t    assert radio_button.isChecked(), (\n    69\t        \"Contains radio button should be checked by default\"\n    70\t    )\n    71\t\n    72\t\n    73\tdef test_face_filter_section_has_not_contains_radio_button():\n    74\t    \"\"\"Test that the section contains a QRadioButton with text 'Does NOT contain'.\"\"\"\n    75\t    dialog = AdvancedFilterDialog()\n    76\t    group = dialog.create_face_filter_section()\n    77\t\n    78\t    # Find the radio button in the group's layout\n    79\t    radio_button = None\n    80\t    for widget in group.findChildren(QRadioButton):\n    81\t        if widget.text() == \"Does NOT contain\":\n    82\t            radio_button = widget\n    83\t            break\n    84\t\n    85\t    assert radio_button is not None, (\n    86\t        \"Should contain a QRadioButton with text 'Does NOT contain'\"\n    87\t    )\n    88\t\n    89\t\n    90\tdef test_face_filter_section_has_minimum_faces_slider():\n    91\t    \"\"\"Test that the section contains a QSlider with range 0-10 and initial value 0.\"\"\"\n    92\t    dialog = AdvancedFilterDialog()\n    93\t    group = dialog.create_face_filter_section()\n    94\t\n    95\t    # Find the slider in the group's layout\n    96\t    slider = None\n    97\t    for widget in group.findChildren(QSlider):\n    98\t        slider = widget\n    99\t        break\n   100\t\n   101\t    assert slider is not None, \"Should contain a QSlider\"\n   102\t    assert slider.minimum() == 0, \"Slider minimum should be 0\"\n   103\t    assert slider.maximum() == 10, \"Slider maximum should be 10\"\n   104\t    assert slider.value() == 0, \"Slider initial value should be 0\"\n   105\t\n   106\t\n   107\tdef test_face_filter_section_has_minimum_faces_label():\n   108\t    \"\"\"Test that the section contains a QLabel with initial text '0'.\"\"\"\n   109\t    dialog = AdvancedFilterDialog()\n   110\t    group = dialog.create_face_filter_section()\n   111\t\n   112\t    # Find the label in the group's layout\n   113\t    label = None\n   114\t    for widget in group.findChildren(QLabel):\n   115\t        if widget.text() == \"0\":\n   116\t            label = widget\n   117\t            break\n   118\t\n   119\t    assert label is not None, \"Should contain a QLabel with initial text '0'\"","time":{"start":1772749420764,"end":1772749420764}}}}
