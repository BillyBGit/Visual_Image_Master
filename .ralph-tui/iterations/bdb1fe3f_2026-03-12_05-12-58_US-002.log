{"type":"tool_use","timestamp":1773253452655,"sessionID":"ses_1af0df1346aa","part":{"type":"tool","callID":"call_w0uxwdkg","tool":"read","state":{"status":"completed","input":{"file_path":"tests/unit/test_caption_generator_CaptionGenerator_load_florence.py"},"output":"     1\t\"\"\"Tests for CaptionGenerator.load_florence() method.\"\"\"\n     2\t\n     3\timport pytest\n     4\timport sys\n     5\tfrom unittest.mock import patch\n     6\tfrom caption_generator import CaptionGenerator\n     7\t\n     8\t\n     9\tclass TestCaptionGeneratorLoadFlorence:\n    10\t    \"\"\"Test suite for CaptionGenerator.load_florence() method.\"\"\"\n    11\t\n    12\t    def test_load_florence_base_model(self):\n    13\t        \"\"\"Test loading the base Florence2 model.\"\"\"\n    14\t        caption_gen = CaptionGenerator()\n    15\t        result = caption_gen.load_florence(model_key=\"base\")\n    16\t        assert result is True\n    17\t        assert caption_gen._florence_loaded is True\n    18\t        assert \"base\" in caption_gen._current_florence_model\n    19\t\n    20\t    def test_load_florence_large_model(self):\n    21\t        \"\"\"Test loading the large Florence2 model.\"\"\"\n    22\t        caption_gen = CaptionGenerator()\n    23\t        result = caption_gen.load_florence(model_key=\"large\")\n    24\t        assert result is True\n    25\t        assert caption_gen._florence_loaded is True\n    26\t        assert \"large\" in caption_gen._current_florence_model\n    27\t    def test_load_florence_invalid_key(self):\n    28\t        \"\"\"Test loading with invalid key falls back to base model.\"\"\"\n    29\t        caption_gen = CaptionGenerator()\n    30\t        result = caption_gen.load_florence(model_key=\"invalid\")\n    31\t        assert result is True\n    32\t        assert caption_gen._florence_loaded is True\n    33\t        assert \"base\" in caption_gen._current_florence_model\n    34\t\n    35\t    def test_load_florence_already_loaded(self):\n    36\t        \"\"\"Test that loading the same model twice returns True without reloading.\"\"\"\n    37\t        caption_gen = CaptionGenerator()\n    38\t        result1 = caption_gen.load_florence(model_key=\"base\")\n    39\t        model_name = caption_gen._current_florence_model\n    40\t        result2 = caption_gen.load_florence(model_key=\"base\")\n    41\t        assert result1 is True\n    42\t        assert result2 is True\n    43\t        assert caption_gen._florence_loaded is True\n    44\t        assert caption_gen._current_florence_model == model_name\n    45\t\n    46\t    def test_load_florence_switch_model(self):\n    47\t        \"\"\"Test switching from base to large model.\"\"\"\n    48\t        caption_gen = CaptionGenerator()\n    49\t        caption_gen.load_florence(model_key=\"base\")\n    50\t        base_model = caption_gen._current_florence_model\n    51\t        caption_gen.load_florence(model_key=\"large\")\n    52\t        assert caption_gen._florence_loaded is True\n    53\t        assert caption_gen._current_florence_model != base_model\n    54\t        assert \"large\" in caption_gen._current_florence_model\n    55\t\n    56\t    def test_load_florence_missing_dependencies(self):\n    57\t        \"\"\"Test that missing dependencies raise RuntimeError.\"\"\"\n    58\t        caption_gen = CaptionGenerator()\n    59\t        with patch.dict(\"sys.modules\", {\"torch\": None, \"transformers\": None}):\n    60\t            with pytest.raises(RuntimeError, match=\"Failed to load Florence2\"):\n    61\t                caption_gen.load_florence(model_key=\"base\")","time":{"start":1773253452655,"end":1773253452655}}}}
