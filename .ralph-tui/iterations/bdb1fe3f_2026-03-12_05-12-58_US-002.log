e = 448  # Model input image size (detected from model)\n   184\t        self._wd14_loaded = False\n   185\t        self._current_wd14_model = None  # Track which WD14 model is loaded\n   186\t        self.wd14_custom_paths = {}  # Dict mapping model_key to custom model file path\n   187\t\n   188\t    def is_florence_available(self) -> Tuple[bool, str]:\n   189\t        \"\"\"Check if Florence2 dependencies are available.\n   190\t\n   191\t        Returns:\n   192\t            Tuple of (available, message)\n   193\t        \"\"\"\n   194\t        try:\n   195\t            import torch  # noqa: F401\n   196\t            import transformers  # noqa: F401\n   197\t\n   198\t            return True, \"Florence2 ready\"\n   199\t        except ImportError as e:\n   200\t       \n... (truncated at 8000 chars)","time":{"start":1773252954796,"end":1773252954796}}}}
