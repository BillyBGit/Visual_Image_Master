{"type":"tool_use","timestamp":1773255161744,"sessionID":"ses_1af0df1346aa","part":{"type":"tool","callID":"call_ww416cu4","tool":"edit","state":{"status":"completed","input":{"new_string":"\"\"\"Tests for CaptionGenerator.load_florence() method.\"\"\"\n\nimport pytest\nimport sys\nfrom unittest.mock import patch\nfrom caption_generator import CaptionGenerator\n\n\nclass TestCaptionGeneratorLoadFlorence:\n    \"\"\"Test suite for CaptionGenerator.load_florence() method.\"\"\"\n\n    def test_load_florence_base_model(self):\n        \"\"\"Test loading the base Florence2 model.\"\"\"\n        caption_gen = CaptionGenerator()\n        result = caption_gen.load_florence(model_key=\"base\")\n        assert result is True\n        assert caption_gen._florence_loaded is True\n        assert \"base\" in caption_gen._current_florence_model\n\n    def test_load_florence_large_model(self):\n        \"\"\"Test loading the large Florence2 model.\"\"\"\n        caption_gen = CaptionGenerator()\n        result = caption_gen.load_florence(model_key=\"large\")\n        assert result is True\n        assert caption_gen._florence_loaded is True\n        assert \"large\" in caption_gen._current_florence_model\n    def test_load_florence_invalid_key(self):\n        \"\"\"Test loading with invalid key falls back to base model.\"\"\"\n        caption_gen = CaptionGenerator()\n        result = caption_gen.load_florence(model_key=\"invalid\")\n        assert result is True\n        assert caption_gen._florence_loaded is True\n        assert \"base\" in caption_gen._current_florence_model\n\n    def test_load_florence_already_loaded(self):\n        \"\"\"Test that loading the same model twice returns True without reloading.\"\"\"\n        caption_gen = CaptionGenerator()\n        result1 = caption_gen.load_florence(model_key=\"base\")\n        model_name = caption_gen._current_florence_model\n        result2 = caption_gen.load_florence(model_key=\"base\")\n        assert result1 is True\n        assert result2 is True\n        assert caption_gen._florence_loaded is True\n        assert caption_gen._current_florence_model == model_name\n\n    def test_load_florence_switch_model(self):\n        \"\"\"Test switching from base to large model.\"\"\"\n        caption_gen = CaptionGenerator()\n        caption_gen.load_florence(model_key=\"base\")\n        base_model = caption_gen._current_florence_model\n        caption_gen.load_florence(model_key=\"large\")\n        assert caption_gen._florence_loaded is True\n        assert caption_gen._current_florence_model != base_model\n        assert \"large\" in caption_gen._current_florence_model\n\n    def test_load_florence_missing_dependencies(self):\n        \"\"\"Test that missing dependencies raise RuntimeError.\"\"\"\n        caption_gen = CaptionGenerator()\n        with patch.dict(\"sys.modules\", {\"torch\": None, \"transformers\": None}):\n            with pytest.raises(RuntimeError, match=\"Failed to load Florence2\"):\n                caption_gen.load_florence(model_key=\"base\")","old_string":"\"\"\"Tests for CaptionGenerator.load_florence() method.\"\"\"\n\nimport pytest\nimport sys\nfrom unittest.mock import patch\nfrom caption_generator import CaptionGenerator\n\n\nclass TestCaptionGeneratorLoadFlorence:\n    \"\"\"Test suite for CaptionGenerator.load_florence() method.\"\"\"\n\n    def test_load_florence_missing_dependencies(self):\n        \"\"\"Test that missing dependencies raise RuntimeError.\"\"\"\n        caption_gen = CaptionGenerator()\n        with patch.dict(\"sys.modules\", {\"torch\": None, \"transformers\": None}):\n            with pytest.raises(RuntimeError, match=\"Failed to load Florence2\"):\n                caption_gen.load_florence(model_key=\"base\")","file_path":"tests/unit/test_caption_generator_CaptionGenerator_load_florence.py"},"output":"Edited tests/unit/test_caption_generator_CaptionGenerator_load_florence.py: replaced 1 occurrence","time":{"start":1773255161744,"end":177