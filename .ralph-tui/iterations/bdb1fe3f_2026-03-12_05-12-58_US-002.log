{"type":"tool_use","timestamp":1773253681007,"sessionID":"ses_1af0df1346aa","part":{"type":"tool","callID":"call_346ixyaj","tool":"read","state":{"status":"completed","input":{"file_path":"caption_generator.py","limit":100,"offset":374},"output":"   374\t    def load_florence(self, model_key: str = \"base\") -> bool:\n   375\t        \"\"\"Load Florence2 model (lazy loading on first use).\n   376\t\n   377\t        Args:\n   378\t            model_key: Key from FLORENCE_MODELS dict, or 'custom' to use custom_model_path\n   379\t\n   380\t        Returns:\n   381\t            True if loaded successfully\n   382\t        \"\"\"\n   383\t        # Resolve model name from key or custom path\n   384\t        if model_key == \"custom\" and self.custom_model_path:\n   385\t            model_name = self.custom_model_path\n   386\t        elif model_key in FLORENCE_MODELS:\n   387\t            model_name = FLORENCE_MODELS[model_key][0]  # Tuple: (path, size)\n   388\t        else:\n   389\t            # Fallback to base model\n   390\t            model_name = FLORENCE_MODELS[\"base\"][0]\n   391\t\n   392\t        # Check if same model is already loaded\n   393\t        if self._florence_loaded and self._current_florence_model == model_name:\n   394\t            _debug(f\"Florence2 model '{model_name}' already loaded, skipping\")\n   395\t            return True\n   396\t\n   397\t        # Unload current model if a different one is requested\n   398\t        if self._florence_loaded and self._current_florence_model != model_name:\n   399\t            _debug(\n   400\t                f\"Different model requested, unloading '{self._current_florence_model}'\"\n   401\t            )\n   402\t            self.unload_florence()\n   403\t\n   404\t        try:\n   405\t            import torch\n   406\t            import transformers\n   407\t            from transformers import AutoProcessor, Florence2ForConditionalGeneration\n   408\t\n   409\t            _debug(\"=== Loading Florence2 ===\")\n   410\t            _debug(f\"Model key: {model_key}\")\n   411\t            _debug(f\"Model name: {model_name}\")\n   412\t            _debug(f\"torch version: {torch.__version__}\")\n   413\t            _debug(f\"transformers version: {transformers.__version__}\")\n   414\t\n   415\t            # Determine device\n   416\t            if torch.cuda.is_available():\n   417\t                self.device = \"cuda\"\n   418\t            elif hasattr(torch.backends, \"mps\") and torch.backends.mps.is_available():\n   419\t                self.device = \"mps\"\n   420\t            else:\n   421\t                self.device = \"cpu\"\n   422\t            _debug(f\"Using device: {self.device}\")\n   423\t\n   424\t            # Load processor\n   425\t            # use_fast=False is required: transformers 5.x switched CLIPImageProcessor\n   426\t            # to a \"fast\" (Rust) implementation by default, but Florence-2 was trained\n   427\t            # with the slow (Python) processor. The fast processor produces different\n   428\t            # pixel value ranges that corrupt the vision encoder output \u2192 garbage captions.\n   429\t            _debug(\"Loading processor...\")\n   430\t            self.florence_processor = AutoProcessor.from_pretrained(\n   431\t                model_name, use_fast=False\n   432\t            )\n   433\t            _debug(f\"Processor type: {type(self.florence_processor)}\")\n   434\t            _debug(f\"Processor class: {self.florence_processor.__class__.__name__}\")\n   435\t\n   436\t            # Load model using native Florence2ForConditionalGeneration class\n   437\t            _debug(\"Loading model (this may take a while)...\")\n   438\t            self.florence_model = Florence2ForConditionalGeneration.from_pretrained(\n   439\t                model_name,\n   440\t                torch_dtype=torch.float16 if self.device == \"cuda\" else torch.float32,\n   441\t                device_map=\"auto\" if self.device != \"cpu\" else None,\n   442\t            )\n   443\t            _debug(f\"Model type: {type(self.florence_model)}\")\n   444\t            _debug(f\"Model class: {self.florence_model.__class__.__name__}\")\n   445\t\n   446\t            # Set to evaluation mode\n   447\t            self.florence_model.eval()\n   448\t            _debug(\"Model set to eval mode\")\n   449\t\n   450\t            self._florence_loaded = True\n   451\t            self._current_florence_model = model_name\n   452\t            _debug(\"=== Florence2 loaded successfully ===\")\n   453\t            return True\n   454\t\n   455\t        except Exception as e:\n   456\t            _debug(\"=== Florence2 load FAILED ===\")\n   457\t            _debug(f\"Error: {e}\")\n   458\t            import traceback\n   459\t\n   460\t            traceback.print_exc()\n   461\t            raise RuntimeError(f\"Failed to load Florence2: {e}\")\n   462\t\n   463\t    def generate_florence(\n   464\t        self, image_path: str, model_key: str = \"base\", detail_level: str = \"detailed\"\n   465\t    ) -> str:\n   466\t        \"\"\"Generate caption using Florence2.\n   467\t\n   468\t        Args:\n   469\t            image_path: Path to image file\n   470\t            model_key: Key from FLORENCE_MODELS dict (base, large, base-ft, large-ft, custom)\n   471\t            detail_level: Key from FLORENCE_DETAIL_LEVELS dict (brief, standard, detailed)\n   472\t\n   473\t        Returns:","time":{"start":1773253681007,"end":1773253681007}}}}
