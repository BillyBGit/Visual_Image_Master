{"type":"tool_use","timestamp":1773536340419,"sessionID":"ses_8a87693d4652","part":{"type":"tool","callID":"call_4b7erhsw","tool":"read","state":{"status":"completed","input":{"file_path":"tests/unit/test_caption_window_CaptionWindow__setup_menu.py"},"output":"     1\t\"\"\"Tests for CaptionWindow._setup_menu method.\"\"\"\n     2\t\n     3\tfrom PySide6.QtWidgets import QMenuBar, QMenu\n     4\tfrom PySide6.QtGui import QAction\n     5\tfrom caption_window import CaptionWindow\n     6\t\n     7\t\n     8\tclass TestCaptionWindowSetupMenu:\n     9\t    \"\"\"Test suite for CaptionWindow._setup_menu method.\"\"\"\n    10\t\n    11\t    def test_menu_bar_created(self):\n    12\t        \"\"\"Test that menuBar() returns a QMenuBar instance.\"\"\"\n    13\t        window = CaptionWindow([], 0)\n    14\t        menu_bar = window.menuBar()\n    15\t        assert isinstance(menu_bar, QMenuBar), \"menuBar() should return a QMenuBar instance\"\n    16\t\n    17\t    def test_options_menu_created(self):\n    18\t        \"\"\"Test that options menu is created in the menu bar.\"\"\"\n    19\t        window = CaptionWindow([], 0)\n    20\t        menu_bar = window.menuBar()\n    21\t        options_menus = menu_bar.findChildren(QMenu, '&Options')\n    22\t        assert len(options_menus) == 1, \"Should have exactly one '&Options' menu\"\n    23\t\n    24\t    def test_fit_to_window_action_created(self):\n    25\t        \"\"\"Test that fit to window action is created correctly.\"\"\"\n    26\t        window = CaptionWindow([], 0)\n    27\t        assert window.fit_act is not None, \"fit_act should be created\"\n    28\t        assert isinstance(window.fit_act, QAction), \"fit_act should be a QAction\"\n    29\t        assert window.fit_act.text() == '&Fit to Window', \"Action text should be '&Fit to Window'\"\n    30\t        assert window.fit_act.isCheckable(), \"Action should be checkable\"\n    31\t        assert window.fit_act.isChecked() == window.fit_to_window, \"Checked state should match fit_to_window\"\n    32\t\n    33\t    def test_native_size_action_created(self):\n    34\t        \"\"\"Test that native size action is created correctly.\"\"\"\n    35\t        window = CaptionWindow([], 0)\n    36\t        assert window.native_act is not None, \"native_act should be created\"\n    37\t        assert isinstance(window.native_act, QAction), \"native_act should be a QAction\"\n    38\t        assert window.native_act.text() == '&Native Size', \"Action text should be '&Native Size'\"\n    39\t        assert window.native_act.isCheckable(), \"Action should be checkable\"\n    40\t        assert window.native_act.isChecked() == (not window.fit_to_window), \"Checked state should be opposite of fit_to_window\"\n    41\t\n    42\t    def test_fit_action_connected_to_toggle_fit_mode(self):\n    43\t        \"\"\"Test that fit action is connected to toggle_fit_mode method.\"\"\"\n    44\t        window = CaptionWindow([], 0)\n    45\t        # Mock the toggle_fit_mode method to track if it's called\n    46\t        original_method = window.toggle_fit_mode\n    47\t        call_count = [0]\n    48\t\n    49\t        def mock_toggle_fit_mode(checked):\n    50\t            call_count[0] += 1\n    51\t            return original_method(checked)\n    52\t\n    53\t        window.toggle_fit_mode = mock_toggle_fit_mode\n    54\t\n    55\t        # Trigger the action\n    56\t        window.fit_act.trigger()\n    57\t\n    58\t        # Verify the method was called\n    59\t        assert call_count[0] == 1, \"toggle_fit_mode should be called when fit_act is triggered\"\n    60\t\n    61\t    def test_native_action_connected_to_set_native_size(self):\n    62\t        \"\"\"Test that native size action is connected to set_native_size method.\"\"\"\n    63\t        window = CaptionWindow([], 0)\n    64\t        # Mock the set_native_size method to track if it's called\n    65\t        original_method = window.set_native_size\n    66\t        call_count = [0]\n    67\t\n    68\t        def mock_set_native_size():\n    69\t            call_count[0] += 1\n    70\t            return original_method()\n    71\t\n    72\t        window.set_native_size = mock_set_native_size\n    73\t\n    74\t        # Trigger the action\n    75\t        window.native_act.trigger()\n    76\t\n    77\t        # Verify the method was called\n    78\t        assert call_count[0] == 1, \"set_native_size should be called when native_act is triggered\"\n    79\t\n    80\t\n    81\t    def test_actions_added_to_menu(self):\n    82\t        \"\"\"Test that actions are added to the options menu.\"\"\"\n    83\t        window = CaptionWindow([], 0)\n    84\t        menu_bar = window.menuBar()\n    85\t        options_menu = menu_bar.findChildren(QMenu, '&Options')[0]\n    86\t        actions = options_menu.actions()\n    87\t        assert window.fit_act in actions, \"fit_act should be in options menu actions\"\n    88\t        assert window.native_act in actions, \"native_act should be in options menu actions\"","time":{"start":1773536340419,"end":1773536340419}}}}
