{"type":"tool_use","timestamp":1772745674816,"sessionID":"ses_5ebf1a07f8b6","part":{"type":"tool","callID":"call_rb0y6q1a","tool":"write","state":{"status":"completed","input":{"file_path":"tests/unit/test_advanced_filter_dialog_AdvancedFilterDialog_create_face_filter_section.py","content":"\"\"\"Tests for AdvancedFilterDialog.create_face_filter_section method.\"\"\"\n\nfrom PyQt6.QtWidgets import QGroupBox, QCheckBox, QRadioButton, QSlider, QLabel\nfrom advanced_filter_dialog import AdvancedFilterDialog\n\n\nclass TestAdvancedFilterDialogCreateFaceFilterSection:\n    \"\"\"Test suite for AdvancedFilterDialog.create_face_filter_section method.\"\"\"\n\n    def test_create_face_filter_section_returns_qgroupbox(self):\n        \"\"\"Test that create_face_filter_section returns a QGroupBox instance.\"\"\"\n        dialog = AdvancedFilterDialog()\n        result = dialog.create_face_filter_section()\n        assert isinstance(result, QGroupBox), \"create_face_filter_section should return a QGroupBox\"\n\n    def test_face_filter_section_has_correct_title(self):\n        \"\"\"Test that the QGroupBox has the correct title.\"\"\"\n        dialog = AdvancedFilterDialog()\n        group_box = dialog.create_face_filter_section()\n        assert group_box.title() == \"Face Detection\", \"QGroupBox title should be 'Face Detection'\"\n\n    def test_face_filter_section_has_enable_checkbox(self):\n        \"\"\"Test that the section contains a QCheckBox with text 'Filter by faces'.\"\"\"\n        dialog = AdvancedFilterDialog()\n        group_box = dialog.create_face_filter_section()\n        \n        # Find the QCheckBox in the layout\n        checkbox = None\n        for widget in group_box.findChildren(QCheckBox):\n            if widget.text() == \"Filter by faces\":\n                checkbox = widget\n                break\n        \n        assert checkbox is not None, \"Should contain a QCheckBox with text 'Filter by faces'\"\n\n    def test_face_filter_section_has_contains_radio_button(self):\n        \"\"\"Test that the section contains a QRadioButton with text 'Contains'.\"\"\"\n        dialog = AdvancedFilterDialog()\n        group_box = dialog.create_face_filter_section()\n        \n        # Find the QRadioButton in the layout\n        radio_button = None\n        for widget in group_box.findChildren(QRadioButton):\n            if widget.text() == \"Contains\":\n                radio_button = widget\n                break\n        \n        assert radio_button is not None, \"Should contain a QRadioButton with text 'Contains'\"\n\n    def test_face_filter_section_has_not_contains_radio_button(self):\n        \"\"\"Test that the section contains a QRadioButton with text 'Does NOT contain'.\"\"\"\n        dialog = AdvancedFilterDialog()\n        group_box = dialog.create_face_filter_section()\n        \n        # Find the QRadioButton in the layout\n        radio_button = None\n        for widget in group_box.findChildren(QRadioButton):\n            if widget.text() == \"Does NOT contain\":\n                radio_button = widget\n                break\n        \n        assert radio_button is not None, \"Should contain a QRadioButton with text 'Does NOT contain'\"\n\n    def test_face_filter_section_has_minimum_faces_slider(self):\n        \"\"\"Test that the section contains a QSlider with range 0-10 and initial value 0.\"\"\"\n        dialog = AdvancedFilterDialog()\n        group_box = dialog.create_face_filter_section()\n        \n        # Find the QSlider in the layout\n        slider = None\n        for widget in group_box.findChildren(QSlider):\n            slider = widget\n            break\n        \n        assert slider is not None, \"Should contain a QSlider\"\n        assert slider.minimum() == 0, \"QSlider minimum should be 0\"\n        assert slider.maximum() == 10, \"QSlider maximum should be 10\"\n        assert slider.value() == 0, \"QSlider initial value should be 0\"\n\n    def test_face_filter_section_has_minimum_faces_label(self):\n        \"\"\"Test that the section contains a QLabel with initial text '0'.\"\"\"\n        dialog = AdvancedFilterDialog()\n        group_box = dialog.create_face_filter_section()\n        \n        # Find the QLabel in the layout\n        label = None\n        for widget in group_box.findChildren(QLabel):\n            if widget.text() == \"0\":\n                label = widget\n                break\n        \n        assert label is not None, \"Should contain a QLabel with initial text '0'\"\n"},"output":"Wrote 4058 bytes to tests/unit/test_advanced_filter_dialog_AdvancedFilterDialog_create_face_filter_section.py","time":{"start":1772745674816,"end":1772745674816}}}}
