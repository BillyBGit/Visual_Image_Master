eate_face_filter_section()\n    35\t\n    36\t        # Find the QCheckBox in the layout\n    37\t        checkbox = None\n    38\t        for widget in group_box.findChildren(QCheckBox):\n    39\t            if widget.text() == \"Filter by faces\":\n    40\t                checkbox = widget\n    41\t                break\n    42\t\n    43\t        assert checkbox is not None, (\n    44\t            \"Should contain a QCheckBox with text 'Filter by faces'\"\n    45\t        )\n    46\t\n    47\t    def test_face_filter_section_has_contains_radio_button(self):\n    48\t        \"\"\"Test that the section contains a QRadioButton with text 'Contains'.\"\"\"\n    49\t        dialog = AdvancedFilterDialog()\n    50\t        group_box = dialog.create_face_filter_section()\n    51\t\n    52\t        # Find the QRadioButton in the layout\n    53\t        radio_button = None\n    54\t        for widget in group_box.findChildren(QRadioButton):\n    55\t            if widget.text() == \"Contains\":\n    56\t                radio_button = widget\n    57\t                break\n    58\t\n    59\t        assert radio_button is not None, (\n    60\t            \"Should contain a QRadioButton with text 'Contains'\"\n    61\t        )\n    62\t\n    63\t    def test_face_filter_section_has_not_contains_radio_button(self):\n    64\t        \"\"\"Test that the section contains a QRadioButton with text 'Does NOT contain'.\"\"\"\n    65\t        dialog = AdvancedFilterDialog()\n    66\t        group_box = dialog.create_face_filter_section()\n    67\t\n    68\t        # Find the QRadioButton in the layout\n    69\t        radio_button = None\n    70\t        for widget in group_box.findChildren(QRadioButton):\n    71\t            if widget.text() == \"Does NOT contain\":\n    72\t                radio_button = widget\n    73\t                break\n    74\t\n    75\t        assert radio_button is not None, (\n    76\t            \"Should contain a QRadioButton with text 'Does NOT contain'\"\n    77\t        )\n    78\t\n    79\t    def test_face_filter_section_has_minimum_faces_slider(self):\n    80\t        \"\"\"Test that the section contains a QSlider with range 0-10 and initial value 0.\"\"\"\n    81\t        dialog = AdvancedFilterDialog()\n    82\t        group_box = dialog.create_face_filter_section()\n    83\t\n    84\t        # Find the QSlider in the layout\n    85\t        slider = None\n    86\t        for widget in group_box.findChildren(QSlider):\n    87\t            slider = widget\n    88\t            break\n    89\t\n    90\t        assert slider is not None, \"Should contain a QSlider\"\n    91\t        assert slider.minimum() == 0, \"QSlider minimum should be 0\"\n    92\t        assert slider.maximum() == 10, \"QSlider maximum should be 10\"\n    93\t        assert slider.value() == 0, \"QSlider initial value should be 0\"\n    94\t\n    95\t    def test_face_filter_section_has_minimum_faces_label(self):\n    96\t        \"\"\"Test that the section contains a QLabel with initial text '0'.\"\"\"\n    97\t        dialog = AdvancedFilterDialog()\n    98\t        group_box = dialog.create_face_filter_section()\n    99\t\n   100\t        # Find the QLabel in the layout\n   101\t        label = None\n   102\t        for widget in group_box.findChildren(QLabel):\n   103\t            if widget.text() == \"0\":\n   104\t                label = widget\n   105\t                break\n   106\t\n   107\t        assert label is not None, (\n   108\t            \"Should contain a QLabel with initial text '0'\"\n   109\t        )","time":{"start":1772746593775,"end":1772746593775}}}}
