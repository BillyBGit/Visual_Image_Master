orence2 ===\")\n   410\t            _debug(f\"Model key: {model_key}\")\n   411\t            _debug(f\"Model name: {model_name}\")\n   412\t            _debug(f\"torch version: {torch.__version__}\")\n   413\t            _debug(f\"transformers version: {transformers.__version__}\")\n   414\t\n   415\t            # Determine device\n   416\t            if torch.cuda.is_available():\n   417\t                self.device = \"cuda\"\n   418\t            elif hasattr(torch.backends, \"mps\") and torch.backends.mps.is_available():\n   419\t                self.device = \"mps\"\n   420\t            else:\n   421\t                self.device = \"cpu\"\n   422\t            _debug(f\"Using device: {self.device}\")\n   423\t\n   424\t            # Load processor\n   425\t            # use_fast=False is required: transformers 5.x switched CLIPImageProcessor\n   426\t            # to a \"fast\" (Rust) implementation by default, but Florence-2 was trained\n   427\t            # with the slow (Python) processor. The fast processor produces different\n   428\t            # pixel value ranges that corrupt the vision encoder output \u2192 garbage captions.\n   429\t            _debug(\"Loading processor...\")\n   430\t            self.florence_processor = AutoProcessor.from_pretrained(\n   431\t                model_name, use_fast=False\n   432\t            )\n   433\t            _debug(f\"Processor type: {type(self.florence_processor)}\")\n   434\t            _debug(f\"Processor class: {self.florence_processor.__class__.__name__}\")\n   435\t\n   436\t            # Load model using native Florence2ForConditionalGeneration class\n   437\t            _debug(\"Loading model (this may take a while)...\")\n   438\t            self.florence_model = Florence2ForConditionalGeneration.from_pretrained(\n   439\t                model_name,\n   440\t                torch_dtype=torch.float16 if self.device == \"cuda\" else torch.float32,\n   441\t                device_map=\"auto\" if self.device != \"cpu\" else None,\n   442\t            )\n   443\t            _debug(f\"Model type: {type(self.florence_model)}\")\n   444\t            _debug(f\"Model class: {self.florence_model.__class__.__name__}\")\n   445\t\n   446\t            # Set to evaluation mode\n   447\t            self.florence_model.eval()\n   448\t            _debug(\"Model set to eval mode\")\n   449\t\n   450\t            self._florence_loaded = True\n   451\t            self._current_florence_model = model_name\n   452\t            _debug(\"=== Florence2 loaded successfully ===\")\n   453\t            return True\n   454\t\n   455\t        except Exception as e:\n   456\t            _debug(\"=== Florence2 load FAILED ===\")\n   457\t            _debug(f\"Error: {e}\")\n   458\t            import traceback\n   459\t\n   460\t            traceback.print_exc()\n   461\t            raise RuntimeError(f\"Failed to load Florence2: {e}\")\n   462\t\n   463\t    def generate_florence(\n   464\t        self, image_path: str, model_key: str = \"base\", detail_level: str = \"detailed\"\n   465\t    ) -> str:\n   466\t        \"\"\"Generate caption using Florence2.\n   467\t\n   468\t        Args:\n   469\t            image_path: Path to image file\n   470\t            model_key: Key from FLORENCE_MODELS dict (base, large, base-ft, large-ft, custom)\n   471\t            detail_level: Key from FLORENCE_DETAIL_LEVELS dict (brief, standard, detailed)\n   472\t\n   473\t        Returns:","time":{"start":1773251833747,"end":1773251833747}}}}
