350MB\"),\n    41\t}\n    42\t\n    43\t\n    44\tclass CaptionWorker(QThread):\n    45\t    \"\"\"Worker thread for caption generation to avoid blocking UI.\"\"\"\n    46\t\n    47\t    finished = Signal(str)  # Caption result\n    48\t    error = Signal(str)  # Error message\n    49\t    progress = Signal(str)  # Progress updates\n    50\t","time":{"start":1773269389129,"end":1773269389129}}}}
