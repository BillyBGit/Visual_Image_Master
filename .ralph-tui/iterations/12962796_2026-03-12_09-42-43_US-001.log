 as mock_onnx, \\\n             patch('builtins.open', create=True) as mock_open:\n            \n            mock_file = MagicMock()\n            mock_file.__enter__ = MagicMock(return_value=mock_file)\n            mock_file.__exit__ = MagicMock(return_value=None)\n            mock_file.read = MagicMock(return_value=\"name,category\\n1girl,0\\n1boy,0\")\n            mock_open.return_value = mock_file\n            \n            mock_download.return_value = \"/fake/path/model.onnx\"\n            \n            # Call with specific model key\n            result = caption_gen.load_wd14(model_key='vit-v2')\n            \n            assert result is True\n            assert caption_gen._wd14_loaded is True\n\n    def test_load_wd14_invalid_model_key(self):\n        \"\"\"Test loading WD14 with invalid model key.\"\"\"\n        caption_gen = CaptionGenerator()\n\n        # Should not raise an exception for invalid key (falls back to vit-v2)\n        with patch('caption_generator.hf_hub_download') as mock_download, \\\n             patch('caption_generator.onnxruntime') as mock_onnx, \\\n             patch('builtins.open', create=True) as mock_open:\n            \n            mock_file = MagicMock()\n            mock_file.__enter__ = MagicMock(return_value=mock_file)\n            mock_file.__exit__ = MagicMock(return_value=None)\n            mock_file.read = MagicMock(return_value=\"name,category\\n1girl,0\\n1boy,0\")\n            mock_open.return_value = mock_file\n            \n            mock_download.return_value = \"/fake/path/model.onnx\"\n            \n            # Should fall back to vit-v2 instead of raising error\n            result = caption_gen.load_wd14(model_key='invalid')\n            \n            assert result is True\n            assert caption_gen._wd14_loaded is True\n\n    def test_load_wd14_already_loaded(self):\n        \"\"\"Test that loading already loaded model returns True without reloading.\"\"\"\n        caption_gen = CaptionGenerator()\n\n        with patch('caption_generator.hf_hub_download') as mock_download, \\\n             patch('caption_generator.onnxruntime') as mock_onnx, \\\n             patch('builtins.open', create=True) as mock_open:\n            \n            mock_file = MagicMock()\n            mock_file.__enter__ = MagicMock(return_value=mock_file)\n            mock_file.__exit__ = MagicMock(return_value=None)\n            mock_file.read = MagicMock(return_value=\"name,category\\n1girl,0\\n1boy,0\")\n            mock_open.return_value = mock_file\n            \n            mock_download.return_value = \"/fake/path/model.onnx\"\n            \n            # First load\n            result1 = caption_gen.load_wd14()\n            assert result1 is True\n            assert caption_gen._wd14_loaded is True\n            \n            # Second load should return True without reloading\n            result2 = caption_gen.load_wd14()\n            assert result2 is True\n            assert caption_gen._wd14_loaded is True\n\n    def test_load_wd14_different_model(self):\n        \"\"\"Test loading a different model unloads the previous one.\"\"\"\n        caption_gen = CaptionGenerator()\n\n        with patch('caption_generator.hf_hub_download') as mock_download, \\\n             patch('caption_generator.onnxruntime') as mock_onnx, \\\n             patch('builtins.open', create=True) as mock_open:\n            \n            mock_file = MagicMock()\n            mock_file.__enter__ = MagicMock(return_value=mock_file)\n            mock_file.__exit__ = MagicMock(return_value=None)\n            mock_file.read = MagicMock(return_value=\"name,category\\n1girl,0\\n1boy,0\")\n            mock_open.return_value = mock_file\n            \n            mock_download.return_value = \"/fake/path/model.onnx\"\n            \n            # Load first model\n            result1 = caption_gen.load_wd14(model_key='vit-v2')\n            assert result1 is True\n            \n            # Load different model\n            result2 = caption_gen.load_wd14(model_key='swinv2-v2')\n            assert result2 is True\n            assert caption_gen._wd14_loaded is True\n\n    def test_load_wd14_no_backend(self):\n        \"\"\"Test that missing dependencies raise RuntimeError.\"\"\"\n        caption_gen = CaptionGenerator()\n\n        # Mock missing dependencies\n        with patch.dict('sys.modules', {'onnxruntime': None, 'torch': None}):\n            with pytest.raises(RuntimeError) as exc_info:\n                caption_gen.load_wd14()\n            \n            assert \"No model backend available\" in str(exc_info.value)\n\n    def test_load_wd14_custom_path(self):\n        \"\"\"Test loading WD14 with custom model path.\"\"\"\n        caption_gen = CaptionGenerator()\n\n        # Set custom path\n        caption_gen.set_wd14_custom_path('vit-v2', '/fake/custom/path/model.onnx')\n\n        with patch('caption_generator.hf_hub_download') as mock_download, \\\n             patch('caption_generator.onnxruntime') as mock_onnx, \\\n             patch('builtins.open', create=True) as mock_open:\n            \n            mock_file = MagicMock()\n            mock_file.__enter__ = MagicMock(return_value=mock_file)\n            mock_file.__exit__ = MagicMock(return_value=None)\n            mock_file.read = MagicMock(return_value=\"name,category\\n1girl,0\\n1boy,0\")\n            mock_open.return_value = mock_file\n            \n            # Should use custom path instead of downloading\n            result = caption_gen.load_wd14()\n            \n            assert result is True\n            assert caption_gen._wd14_loaded is True\n"},"output":"Wrote 7096 bytes to tests/unit/test_caption_generator_CaptionGenerator_load_wd14.py","time":{"start":1773269324045,"end":1773269324045}}}}
