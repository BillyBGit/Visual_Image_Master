{"type":"tool_use","timestamp":1772943712266,"sessionID":"ses_1b50744d413f","part":{"type":"tool","callID":"call_52ihi5dk","tool":"edit","state":{"status":"completed","input":{"file_path":"tests/unit/test_autocaption_dialog_AutoCaptionDialog__on_caption_error.py","new_string":"\"\"\"Tests for AutoCaptionDialog._on_caption_error method.\"\"\"\n\nfrom unittest.mock import Mock, patch\nfrom autocaption_dialog import AutoCaptionDialog\n\n\nclass TestAutoCaptionDialogOnCaptionError:\n    \"\"\"Test suite for AutoCaptionDialog._on_caption_error method.\"\"\"\n\n    def test_on_caption_error_records_error(self):\n        \"\"\"Test that error is recorded in self.results with correct image path and error message.\"\"\"\n        # Setup\n        image_paths = [\"/path/to/image1.jpg\", \"/path/to/image2.jpg\"]\n        dialog = AutoCaptionDialog(image_paths)\n        dialog.current_index = 0\n        dialog.results = []\n\n        # Mock the progress bar\n        dialog.progress_bar = Mock()\n\n        # Call the method\n        test_error = \"Failed to generate caption\"\n        dialog._on_caption_error(test_error)\n\n        # Assert\n        assert len(dialog.results) == 1\n        assert dialog.results[0][0] == \"/path/to/image1.jpg\"\n        assert dialog.results[0][1] is None\n        assert dialog.results[0][2] == f\"error: {test_error}\"","old_string":"\"\"\"Tests for AutoCaptionDialog._on_caption_error method.\"\"\"\n\nimport pytest\nfrom unittest.mock import Mock, MagicMock, patch\nfrom autocaption_dialog import AutoCaptionDialog\n\n\nclass TestAutoCaptionDialogOnCaptionError:\n    \"\"\"Test suite for AutoCaptionDialog._on_caption_error method.\"\"\"\n\n    def test_on_caption_error_records_error(self):\n        \"\"\"Test that error is recorded in self.results with correct image path and error message.\"\"\"\n        # Setup\n        image_paths = [\"/path/to/image1.jpg\", \"/path/to/image2.jpg\"]\n        dialog = AutoCaptionDialog(image_paths)\n        dialog.current_index = 0\n        dialog.results = []\n        \n        # Mock the progress bar\n        dialog.progress_bar = Mock()\n        \n        # Call the method\n        test_error = \"Failed to generate caption\"\n        dialog._on_caption_error(test_error)\n        \n        # Assert\n        assert len(dialog.results) == 1\n        assert dialog.results[0][0] == \"/path/to/image1.jpg\"\n        assert dialog.results[0][1] is None\n        assert dialog.results[0][2] == f\"error: {test_error}\""},"output":"Edited tests/unit/test_autocaption_dialog_AutoCaptionDialog__on_caption_error.py: replaced 1 occurrence","time":{"start":1772943712266,"end":1772943712266}}}}
