~350MB\"),\n    41\t}\n    42\t\n    43\t\n    44\tclass CaptionWorker(QThread):\n    45\t    \"\"\"Worker thread for caption generation to avoid blocking UI.\"\"\"\n    46\t\n    47\t    finished = Signal(str)  # Caption result\n    48\t    error = Signal(str)  # Error message\n    49\t    progress = Signal(str)  # Progress updates\n    50\t\n    51\t    def __init__(\n    52\t        self,\n    53\t        generator,\n    54\t        image_path: str,\n    55\t        backend: str,\n    56\t        ollama_url: str = \"\",\n    57\t        ollama_model: str = \"\",\n    58\t        florence_model: str = \"base\",\n    59\t        florence_detail: str = \"detailed\",\n    60\t        wd14_model: str = \"vit-v2\",\n    61\t        wd14_threshold: float = 0.35,\n    62\t    ):\n    63\t        super().__init__()\n    64\t        self.generator = generator\n    65\t        self.image_path = image_path\n    66\t        self.backend = backend\n    67\t        self.ollama_url = ollama_url\n    68\t        self.ollama_model = ollama_model\n    69\t        self.florence_model = florence_model\n    70\t        self.florence_detail = florence_detail\n    71\t        self.wd14_model = wd14_model\n    72\t        self.wd14_threshold = wd14_threshold\n    73\t\n    74\t    def run(self):\n    75\t        try:\n    76\t            # Validate image first\n    77\t            self.progress.emit(\"Validating image...\")\n    78\t            valid, message = self.generator.validate_image(self.image_path)\n    79\t            if not valid:\n    80\t                self.error.emit(f\"Image validation failed: {message}\")\n    81\t                return\n    82\t\n    83\t            if self.backend == \"florence2\":\n    84\t                self.progress.emit(\"Loading Florence2 model...\")\n    85\t                caption = self.generator.generate_florence(\n    86\t                    self.image_path,\n    87\t                    model_key=self.florence_model,\n    88\t               