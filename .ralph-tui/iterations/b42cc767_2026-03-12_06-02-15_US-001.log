{"type":"tool_use","timestamp":1773256220488,"sessionID":"ses_e57cc4fe1a5f","part":{"type":"tool","callID":"call_pgi3s84z","tool":"read","state":{"status":"completed","input":{"file_path":"caption_generator.py","limit":250,"offset":463},"output":"   463\t    def generate_florence(\n   464\t        self, image_path: str, model_key: str = \"base\", detail_level: str = \"detailed\"\n   465\t    ) -> str:\n   466\t        \"\"\"Generate caption using Florence2.\n   467\t\n   468\t        Args:\n   469\t            image_path: Path to image file\n   470\t            model_key: Key from FLORENCE_MODELS dict (base, large, base-ft, large-ft, custom)\n   471\t            detail_level: Key from FLORENCE_DETAIL_LEVELS dict (brief, standard, detailed)\n   472\t\n   473\t        Returns:\n   474\t            Generated caption string\n   475\t        \"\"\"\n   476\t        import torch\n   477\t\n   478\t        _debug(\"=== Starting Florence2 caption generation ===\")\n   479\t        _debug(f\"Image path: {image_path}\")\n   480\t        _debug(f\"Model key: {model_key}, Detail level: {detail_level}\")\n   481\t\n   482\t        # Validate image first\n   483\t        _debug(\"Validating image...\")\n   484\t        valid, message = self.validate_image(image_path)\n   485\t        _debug(f\"Validation result: valid={valid}, message={message}\")\n   486\t        if not valid:\n   487\t            raise RuntimeError(f\"Image validation failed: {message}\")\n   488\t\n   489\t        # Ensure model is loaded (will reload if different model requested)\n   490\t        _debug(\"Ensuring model is loaded...\")\n   491\t        self.load_florence(model_key)\n   492\t\n   493\t        # Load and preprocess image with explicit error handling\n   494\t        _debug(\"Opening image with PIL...\")\n   495\t        try:\n   496\t            image = Image.open(image_path)\n   497\t            _debug(\n   498\t                f\"Image opened: format={image.format}, mode={image.mode}, size={image.size}\"\n   499\t            )\n   500\t            # Force load the image data\n   501\t            image.load()\n   502\t            _debug(\"Image data loaded\")\n   503\t            # Convert to RGB\n   504\t            image = image.convert(\"RGB\")\n   505\t            _debug(f\"Converted to RGB: mode={image.mode}, size={image.size}\")\n   506\t        except Exception as e:\n   507\t            _debug(f\"Failed to load image: {e}\")\n   508\t            import traceback\n   509\t\n   510\t            traceback.print_exc()\n   511\t            raise RuntimeError(f\"Failed to load image: {e}\")\n   512\t\n   513\t        # Store original size for post-processing\n   514\t        original_size = (image.width, image.height)\n   515\t        _debug(f\"Original size: {original_size}\")\n   516\t\n   517\t        # Resize very large images to prevent memory issues\n   518\t        max_size = 1024\n   519\t        if image.width > max_size or image.height > max_size:\n   520\t            ratio = min(max_size / image.width, max_size / image.height)\n   521\t            new_size = (int(image.width * ratio), int(image.height * ratio))\n   522\t            _debug(f\"Resizing from {image.size} to {new_size}\")\n   523\t            image = image.resize(new_size, Image.Resampling.LANCZOS)\n   524\t\n   525\t        # Verify image has valid data by converting to numpy array\n   526\t        _debug(\"Converting to numpy array...\")\n   527\t        try:\n   528\t            img_array = np.array(image)\n   529\t            _debug(f\"Array shape: {img_array.shape}, dtype: {img_array.dtype}\")\n   530\t            if img_array is None or img_array.size == 0:\n   531\t                raise RuntimeError(\"Image converted to empty array\")\n   532\t            if len(img_array.shape) != 3 or img_array.shape[2] != 3:\n   533\t                raise RuntimeError(\n   534\t                    f\"Invalid image shape: {img_array.shape}, expected (H, W, 3)\"\n   535\t                )\n   536\t            _debug(\"Array validation passed\")\n   537\t        except Exception as e:\n   538\t            _debug(f\"Array conversion failed: {e}\")\n   539\t            import traceback\n   540\t\n   541\t            traceback.print_exc()\n   542\t            raise RuntimeError(f\"Image array conversion failed: {e}\")\n   543\t\n   544\t        # Get task prompt based on detail level\n   545\t        task_prompt = FLORENCE_DETAIL_LEVELS.get(\n   546\t            detail_level, FLORENCE_DETAIL_LEVELS[\"detailed\"]\n   547\t        )\n   548\t        _debug(f\"Task prompt: {task_prompt} (detail level: {detail_level})\")\n   549\t\n   550\t        # Process inputs - Florence2 expects specific format\n   551\t        _debug(\"Calling florence_processor...\")\n   552\t        _debug(f\"Processor type: {type(self.florence_processor)}\")\n   553\t        try:\n   554\t            inputs = self.florence_processor(\n   555\t                text=task_prompt, images=image, return_tensors=\"pt\"\n   556\t            )\n   557\t            _debug(f\"Processor returned: {type(inputs)}\")\n   558\t        except Exception as e:\n   559\t            _debug(f\"Processor call failed: {e}\")\n   560\t            import traceback\n   561\t\n   562\t            traceback.print_exc()\n   563\t            raise RuntimeError(f\"Florence2 processor failed: {e}\")\n   564\t\n   565\t        # Verify we have the expected inputs\n   566\t        _debug(f\"inputs is None: {inputs is None}\")\n   567\t        if inputs is None:\n   568\t            raise RuntimeError(\"Florence2 processor returned None\")\n   569\t\n   570\t        _debug(f\"inputs type: {type(inputs)}\")\n   571\t        _debug(\n   572\t            f\"inputs keys: {list(inputs.keys()) if hasattr(inputs, 'keys') else 'N/A'}\"\n   573\t        )\n   574\t\n   575\t        if \"pixel_values\" not in inputs:\n   576\t            raise RuntimeError(\n   577\t                f\"Florence2 processor missing pixel_values. Got keys: {list(inputs.keys())}\"\n   578\t            )\n   579\t\n   580\t        _debug(f\"pixel_values is None: {inputs['pixel_values'] is None}\")\n   581\t        if inputs[\"pixel_values\"] is None:\n   582\t            raise RuntimeError(\"Florence2 processor created None for pixel_values\")\n   583\t\n   584\t        # Verify pixel_values has valid shape\n   585\t        pv = inputs[\"pixel_values\"]\n   586\t        _debug(f\"pixel_values type: {type(pv)}\")\n   587\t        _debug(f\"pixel_values has shape: {hasattr(pv, 'shape')}\")\n   588\t        if not hasattr(pv, \"shape\"):\n   589\t            raise RuntimeError(f\"pixel_values has no shape attribute, type: {type(pv)}\")\n   590\t        _debug(f\"pixel_values shape: {pv.shape}\")\n   591\t        if len(pv.shape) != 4:\n   592\t            raise RuntimeError(\n   593\t                f\"Invalid pixel_values shape: {pv.shape}, expected 4D tensor\"\n   594\t            )\n   595\t\n   596\t        # Move inputs to model device, with pixel_values in model dtype\n   597\t        _debug(\"Moving inputs to model device...\")\n   598\t        _debug(\n   599\t            f\"Model device: {self.florence_model.device}, dtype: {self.florence_model.dtype}\"\n   600\t        )\n   601\t\n   602\t        # Move each tensor appropriately - pixel_values needs float16, input_ids stays int\n   603\t        inputs_dict = {}\n   604\t        for key, value in inputs.items():\n   605\t            if hasattr(value, \"to\"):\n   606\t                if key == \"pixel_values\":\n   607\t                    # Convert pixel_values to model dtype (float16)\n   608\t                    inputs_dict[key] = value.to(\n   609\t                        self.florence_model.device, self.florence_model.dtype\n   610\t                    )\n   611\t                    _debug(\n   612\t                        f\"{key} moved to {self.florence_model.device} with dtype {self.florence_model.dtype}\"\n   613\t                    )\n   614\t                else:\n   615\t                    # Keep other tensors (input_ids, attention_mask) as-is but move to device\n   616\t                    inputs_dict[key] = value.to(self.florence_model.device)\n   617\t                    _debug(f\"{key} moved to {self.florence_model.device}\")\n   618\t            else:\n   619\t                inputs_dict[key] = value\n   620\t\n   621\t        # Generate using official HuggingFace pattern\n   622\t        _debug(\"Starting model.generate()...\")\n   623\t        try:\n   624\t            with torch.no_grad():\n   625\t                generated_ids = self.florence_model.generate(\n   626\t                    **inputs_dict,\n   627\t\n... (truncated at 8000 chars)","time":{"start":1773256220488,"end":1773256220488}}}}
