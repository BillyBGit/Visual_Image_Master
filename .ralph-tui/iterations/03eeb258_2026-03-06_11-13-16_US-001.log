{"type":"tool_use","timestamp":1772756769390,"sessionID":"ses_869c7cd180ba","part":{"type":"tool","callID":"call_mcr6badg","tool":"edit","state":{"status":"completed","input":{"file_path":"tests/unit/test_advanced_filter_dialog_AdvancedFilterDialog_select_indoor_scenes.py","new_string":"\"\"\"Tests for AdvancedFilterDialog.select_indoor_scenes method.\"\"\"\n\nfrom unittest.mock import patch\nfrom advanced_filter_dialog import AdvancedFilterDialog\n\n\nclass TestAdvancedFilterDialogSelectIndoorScenes:\n    \"\"\"Test suite for AdvancedFilterDialog.select_indoor_scenes method.\"\"\"\n\n    def test_select_indoor_scenes_checks_indoor_groups(self):\n        \"\"\"Test that select_indoor_scenes checks indoor scene groups.\"\"\"\n        dialog = AdvancedFilterDialog()\n        dialog.select_indoor_scenes()\n        \n        # Assert that indoor groups are checked\n        assert dialog.scene_group_cbs[\"indoor_home\"].isChecked()\n        assert dialog.scene_group_cbs[\"indoor_commercial\"].isChecked()\n        assert dialog.scene_group_cbs[\"entertainment\"].isChecked()","old_string":"\"\"\"Tests for AdvancedFilterDialog.select_indoor_scenes method.\"\"\"\n\nimport pytest\nfrom unittest.mock import MagicMock, patch\nfrom advanced_filter_dialog import AdvancedFilterDialog\n\n\nclass TestAdvancedFilterDialogSelectIndoorScenes:\n    \"\"\"Test suite for AdvancedFilterDialog.select_indoor_scenes method.\"\"\"\n\n    def test_select_indoor_scenes_checks_indoor_groups(self):\n        \"\"\"Test that select_indoor_scenes checks indoor scene groups.\"\"\"\n        dialog = AdvancedFilterDialog()\n        dialog.select_indoor_scenes()\n        \n        # Assert that indoor groups are checked\n        assert dialog.scene_group_cbs[\"indoor_home\"].isChecked()\n        assert dialog.scene_group_cbs[\"indoor_commercial\"].isChecked()\n        assert dialog.scene_group_cbs[\"entertainment\"].isChecked()"},"output":"Edited tests/unit/test_advanced_filter_dialog_AdvancedFilterDialo