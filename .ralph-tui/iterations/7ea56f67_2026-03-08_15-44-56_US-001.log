{"type":"tool_use","timestamp":1772945932412,"sessionID":"ses_53860e160cd5","part":{"type":"tool","callID":"call_itfxpafe","tool":"edit","state":{"status":"completed","input":{"file_path":"tests/unit/test_autocaption_dialog_AutoCaptionDialog__cancel_generation.py","new_string":"    def test_cancel_generation_with_partial_results(self):\n        \"\"\"Test cancel generation with partial results.\"\"\"\n        # Create AutoCaptionDialog with mock image paths\n        image_paths = [\"/path/to/image1.jpg\", \"/path/to/image2.jpg\"]\n        dialog = AutoCaptionDialog(image_paths)\n        \n        # Set caption_worker to a mock object\n        dialog.caption_worker = Mock()\n        \n        # Mock _finish_generation to avoid actual UI updates\n        dialog._finish_generation = Mock()\n        \n        # Populate results with some entries (path, caption, status format)\n        dialog.results = [\n            (\"/path/to/image1.jpg\", \"Caption 1\", \"success\"),\n            (\"/path/to/image2.jpg\", None, \"processing\")  # Partial result\n        ]\n        \n        # Call _cancel_generation\n        dialog._cancel_generation()\n        \n        # Assert results are preserved\n        assert dialog.results == [\n            (\"/path/to/image1.jpg\", \"Caption 1\", \"success\"),\n            (\"/path/to/image2.jpg\", None, \"processing\")\n        ]\n        \n        # Assert _finish_generation is called with cancelled=True\n        dialog._finish_generation.assert_called_once_with(cancelled=True)","old_string":"    def test_cancel_generation_with_partial_results(self):\n        \"\"\"Test cancel generation with partial results.\"\"\"\n        # Create AutoCaptionDialog with mock image paths\n        image_paths = [\"/path/to/image1.jpg\", \"/path/to/image2.jpg\"]\n        dialog = AutoCaptionDialog(image_paths)\n        \n        # Set caption_worker to a mock object\n        dialog.caption_worker = Mock()\n        \n        # Populate results with some entries\n        dialog.results = {\n            \"/path/to/image1.jpg\": \"Caption 1\",\n            \"/path/to/image2.jpg\": None  # Partial result\n        }\n        \n        # Call _cancel_generation\n        dialog._cancel_generation()\n        \n        # Assert results are preserved\n        assert dialog.results == {\n            \"/path/to/image1.jpg\": \"Caption 1\",\n            \"/path/to/image2.jpg\": None\n        }\n        \n        # Assert _finish_generation is called with cancelled=True\n        dialog._finish_generation.assert_called_once_with(cancelled=True)"},"output":"Edited tests/unit/test_autocaption_dialog_AutoCaptionDialog__cancel_generation.py: replaced 1 occurrence","time":{"start":1772945932412,"end":1772945932412}}}}
