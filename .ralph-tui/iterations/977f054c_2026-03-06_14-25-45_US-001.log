\"oven\",\n   140\t        \"toaster\",\n   141\t    ],\n   142\t    \"sports\": [\n   143\t        \"frisbee\",\n   144\t        \"skis\",\n   145\t        \"snowboard\",\n   146\t        \"sports ball\",\n   147\t        \"kite\",\n   148\t        \"baseball bat\",\n   149\t        \"baseball glove\",\n   150\t        \"skateboard\",\n   151\t        \"surfboard\",\n   152\t        \"tennis racket\",\n   153\t    ],\n   154\t}\n   155\t\n   156\t\n   157\tclass ObjectDetector:\n   158\t    \"\"\"Detects objects in images using YOLO.\"\"\"\n   159\t\n   160\t    def __init__(self, confidence_threshold=0.5):\n   161\t        self.confidence_threshold = confidence_threshold\n   162\t        self.net = None\n   163\t        self.output_layers = None\n   164\t        self._yolo_model = None  # For ultralytics models\n   165\t        self._is_ultralytics = False\n   166\t        self._load_model()\n   167\t        self._cache = {}\n   168\t\n   169\t    def _load_model(self):\n   170\t        \"\"\"Load YOLOv4-tiny model (CPU-friendly).\"\"\"\n   171\t        models_dir = Path(__file__).parent / \"models\"\n   172\t\n   173\t        # Check for custom model first (set via set_custom_model)\n   174\t        if hasattr(self, \"_custom_model_path\") and self._custom_model_path:\n   175\t            try:\n   176\t                self._load_custom_model(self._custom_model_path)\n   177\t                return\n   178\t            except Exception as e:\n   179\t                print(f\"Failed to load custom model: {e}\")\n   180\t                print(\"Falling back to default YOLO model...\")\n   181\t\n   182\t        # Paths to default model files\n   183\t        weights_path = models_dir / \"yolov4-tiny.weights\"\n   184\t        config_path = models_dir / \"yolov4-tiny.cfg\"\n   185\t\n   186\t        if not weights_path.exists() or not config_path.exists():\n   187\t            print(f\"\\n{'=' * 60}\")\n   188\t            print(\"WARNING: YOLO model files not found!\")\n   189\t            print(f\"Location: {models_dir}\")\n   190\t            print(\"\\nTo enable object detection filtering, please run:\")\n   191\t            print(\"  cd models\")\n   192\t            print(\"  python3 download_models.py\")\n   193\t            print(f\"{'=' * 60}\\n\")\n   194\t            self.net = None\n   195\t            self.model_loaded = False\n   196\t            return\n   197\t\n   198\t        try:\n   199\t            self.net = cv2.dnn.readNet(str(weights_path), str(config_path))\n   200\t            self.net.setPreferableBackend(cv2.dnn.DNN_BACKEND_OPENCV)\n   201\t            self.net.setPreferableTarget(cv2.dnn.DNN_TARGET_CPU)\n   202\t\n   203\t            # Get output layer names\n   204\t            layer_names = self.net.getLayerNames()\n   205\t            self.output_layers = [\n   206\t                layer_names[i - 1] for i in self.net.getUnconnectedOutLayers()\n   207\t            ]\n   208\t\n   209\t            self.model_loaded = True\n   210\t            print(\"\u2713 YOLO object detector loaded successfully (CPU mode)\")\n   211\t        except Exception as e:\n   212\t            print(f\"\u2717 Failed to load YOLO model: {e}\")\n   213\t            self.net = None\n   214\t            self.model_loaded = False\n   215\t\n   216\t    def _load_custom_model(self, model_path):\n   217\t        \"\"\"Load a custom YOLO model (.pt, .pth, .safetensors, .weights, or .onnx).\"\"\"\n   218\t        model_path = Path(model_path)\n   219\t\n   220\t        if not model_path.exists():\n   221\t            raise FileNotFoundError(f\"Model file not found: {model_path}\")\n   222\t\n   223\t        suffix = model_path.suffix.lower()\n   224\t\n   225\t        if suffix in [\".weights\"]:\n   226\t            # Darknet weights format - need .cfg file\n   227\t            cfg_path = model_path.with_suffix(\".cfg\")\n   228\t            if not cfg_path.exists():\n   229\t                raise FileNotFoundError(f\"Config file not found: {cfg_path}\")\n   230\t\n   231\t            self.net = cv2.dnn.readNet(str(model_path), str(cfg_path))\n   232\t            self.net.setPreferableBackend(cv2.dnn.DNN_BACKEND_OPENCV)\n   233\t            self.net.setPreferableTarget(cv2.dnn.DNN_TARGET_CPU)\n   234\t\n   235\t            layer_names = self.net.getLayerNames()\n   236\t            self.output_layers = [\n   237\t                layer_names[i - 1] for i in self.net.getUnconnectedOutLayers()\n   238\t            ]\n   239\t            self.model_loaded = True\n   240\t            print(f\"\u2713 Custom YOLO model loaded: {model_path.name}\")\n   241\t\n   242\t        elif suffix == \".onnx\":\n   243\t            # ONNX format\n   244\t            self.net = cv2.dnn.readNetFromONNX(str(model_path))\n   245\t            self.net.setPreferableBackend(cv2.dnn.DNN_BACKEND_OPENCV)\n   246\t            self.net.setPreferableTarget(cv2.dnn.DNN_TARGET_CPU)\n   247\t\n   248\t            # For ONNX, output layers might be different\n   249\t            self.output_layers = self.net.getUnconnectedOut\n... (truncated at 8000 chars)","time":{"start":1772767874708,"end":1772767874708}}}}
