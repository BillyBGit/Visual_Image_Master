.object(mock_caption_window, '_load_settings'), \\\n             patch('caption_window.QScrollArea') as mock_scroll_area:\n            \n            scroll_area_mock = MagicMock()\n            mock_scroll_area.return_value = scroll_area_mock\n            \n            window = mock_caption_window([], 0, parent)\n            \n            # Verify setup methods were called\n            mock_caption_window._setup_ui.assert_called_once()\n            mock_caption_window._setup_menu.assert_called_once()\n            mock_caption_window._setup_shortcuts.assert_called_once()\n            mock_caption_window._load_settings.assert_called_once()\n\n    def test_init_sets_window_title(self, mock_caption_window):\n        \"\"\"Test that window title is set correctly.\"\"\"\n        # Mock all the setup methods and UI elements\n        with patch.object(mock_caption_window, '_setup_ui'), \\\n             patch.object(mock_caption_window, '_setup_menu'), \\\n             patch.object(mock_caption_window, '_setup_shortcuts'), \\\n             patch.object(mock_caption_window, '_load_settings'), \\\n             patch('caption_window.QScrollArea') as mock_scroll_area:\n            \n            scroll_area_mock = MagicMock()\n            mock_scroll_area.return_value = scroll_area_mock\n            \n            window = mock_caption_window([], 0)\n            \n            assert window.windowTitle() == 'Auto Caption Tool'\n\n    def test_init_sets_focus_policy(self, mock_caption_window):\n        \"\"\"Test that focus policy is set correctly.\"\"\"\n        # Mock all the setup methods and UI elements\n        with patch.object(mock_caption_window, '_setup_ui'), \\\n             patch.object(mock_caption_window, '_setup_menu'), \\\n             patch.object(mock_caption_window, '_setup_shortcuts'), \\\n             patch.object(mock_caption_window, '_load_settings'), \\\n             patch('caption_window.QScrollArea') as mock_scroll_area:\n            \n            scroll_area