dialog.generate_btn.setEnabled.assert_called_once_with(False)\n    41\t        mock_dialog.cancel_btn.setEnabled.assert_called_once_with(True)\n    42\t        mock_dialog.close_btn.setEnabled.assert_called_once_with(False)\n    43\t\n    44\t    def test_start_generation_disables_backend_combo(self, mock_dialog):\n    45\t        \"\"\"Test that _start_generation disables backend_combo.\"\"\"\n    46\t        mock_dialog._start_generation()\n    47\t\n    48\t        mock_dialog.backend_combo.setEnabled.assert_called_once_with(False)\n    49\t\n    50\t    def test_start_generation_resets_progress_bar(self, mock_dialog):\n    51\t        \"\"\"Test that _start_generation resets progress_bar to 0.\"\"\"\n    52\t        mock_dialog._start_generation()\n    53\t\n    54\t        mock_dialog.progress_bar.setValue.assert_called_once_with(0)\n    55\t\n    56\t    def test_start_generation_calls_save_settings(self, mock_dialog):\n    57\t        \"\"\"Test that _start_generation calls _save_settings.\"\"\"\n    58\t        with patch.object(mock_dialog, '_save_settings') as mock_save:\n    59\t            mock_dialog._start_generation()\n    60\t\n    61\t            mock_save.assert_called_once()\n    62\t\n    63\t    def test_start_generation_calls_process_next_image(self, mock_dialog):\n    64\t        \"\"\"Test that _start_generation calls _process_next_image.\"\"\"\n    65\t        with patch.object(mock_dialog, '_process_next_image') as mock_process:\n    66\t            mock_dialog._start_generation()\n    67\t\n    68\t            mock_process.assert_called_once()\n    69\t\n    70\t    def test_start_generation_preserves_image_paths(self, mock_dialog):\n    71\t        \"\"\"Test that _start_generation doesn't modify image_paths.\"\"\"\n    72\t        original_paths = mock_dialog.image_paths.copy()\n    73\t\n    74\t        mock_dialog._start_generation()\n    75\t\n    76\t        assert mock_dialog.image_paths == original_paths","time":{"start":1772914057