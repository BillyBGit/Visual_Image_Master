ox and widgets\n    36\t        dialog.backend_combo = MagicMock()\n    37\t        dialog.backend_combo.currentData.return_value = \"wd14\"\n    38\t        dialog.florence_widget = MagicMock()\n    39\t        dialog.wd14_widget = MagicMock()\n    40\t        dialog.ollama_widget = MagicMock()\n    41\t\n    42\t        # Call the method\n    43\t        dialog._on_backend_changed(1)\n    44\t\n    45\t        # Verify visibility changes\n    46\t        dialog.florence_widget.setVisible.assert_called_once_with(False)\n    47\t        dialog.wd14_widget.setVisible.assert_called_once_with(True)\n    48\t        dialog.ollama_widget.setVisible.assert_called_once_with(False)\n    49\t\n    50\t    def test_ollama_backend_shows_ollama_widget(self):\n    51\t        \"\"\"Test ollama backend shows ollama_widget and hides others.\"\"\"\n    52\t        # Create AutoCaptionDialog with mock image paths\n    53\t        dialog = AutoCaptionDialog([\"mock_image.jpg\"])\n    54\t\n    55\t        # Mock the combo box and widgets\n    56\t        dialog.backend_combo = MagicMock()\n    57\t        dialog.backend_combo.currentData.return_value = \"ollama\"\n    58\t        dialog.florence_widget = MagicMock()\n    59\t        dialog.wd14_widget = MagicMock()\n    60\t        dialog.ollama_widget = MagicMock()\n    61\t\n    62\t        # Call the method\n    63\t        dialog._on_backend_changed(2)\n    64\t\n    65\t        # Verify visibility changes\n    66\t        dialog.florence_widget.setVisible.assert_called_once_with(False)\n    67\t        dialog.wd14_widget.setVisible.assert_called_once_with(False)\n    68\t        dialog.ollama_widget.setVisible.assert_called_once_with(True)\n    69\t\n    70\t    def test_backend_changed_updates_visibility_correctly(self):\n    71\t        \"\"\"Test all three backends in sequence, verifying visibility changes.\"\"\"\n    72\t        # Create AutoCaptionDialog with mock image paths\n    73\t        dialog = AutoCaptionDialog([\"mock_image.jpg\"])\n    74\t\n    75\t        # Mock the combo box and widgets\n    76\t        dialog.backend_combo = MagicMock()\n    77\t        dialog.florence_widget = MagicMock()\n    78\t        dialog.wd14_widget = MagicMock()\n    79\t        dialog.ollama_widget = MagicMock()\n    80\t\n    81\t        # Test florence2 backend\n    82\t        dialog.backend_combo.currentData.return_value = \"florence2\"\n    83\t        dialog._on_backend_changed(0)\n    84\t        dialog.florence_widget.setVisible.assert_called_with(True)\n    85\t        dialog.wd14_widget.setVisible.assert_called_with(False)\n    86\t        dialog.ollama_widget.setVisible.assert_called_with(False)\n    87\t\n    88\t        # Test wd14 backend\n    89\t        dialog.backend_combo.currentData.return_value = \"wd14\"\n    90\t        dialog._on_backend_changed(1)\n    91\t        dialog.florence_widget.setVisible.assert_called_with(False)\n    92\t        dialog.wd14_widget.setVisible.assert_called_with(True)\n    93\t        dialog.ollama_widget.setVisible.assert_called_with(False)\n    94\t\n    95\t        # Test ollama backend\n    96\t        dialog.backend_combo.currentData.return_value = \"ollama\"\n    97\t        dialog._on_backend_changed(2)\n    98\t        dialog.florence_widget.setVisible.assert_called_with(False)\n    99\t        dialog.wd14_widget.setVisible.assert_called_with(False)\n   100\t        dialog.ollama_widget.setVisible.assert_called_with(True)\n   101\t\n   102\t    def test_initial_state_all_hidden(self):\n   103\t        \"\"\"Test all backend-specific widgets are hidden initially.\"\"\"\n   104\t        # Create AutoCaptionDialog with mock image paths\n   105\t        dialog = AutoCaptionDialog([\"mock_image.jpg\"])\n   106\t\n   107\t        # Mock the combo box and widgets\n   108\t        dialog.backend_combo = MagicMock()\n   109\t        dialog.backend_combo.currentData.return_value = None  # No backend selected\n   110\t        dialog.florence_widge