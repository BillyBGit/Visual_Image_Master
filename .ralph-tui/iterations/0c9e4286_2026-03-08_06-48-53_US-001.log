 image_paths = [\"path1.jpg\", \"path2.jpg\", \"path3.jpg\"]\n    35\t        with patch(\"autocaption_dialog.get_caption_generator\"):\n    36\t            dialog = AutoCaptionDialog(image_paths)\n    37\t            assert dialog.windowTitle() == \"Auto Caption - 3 image(s)\"\n    38\t\n    39\t    def test_init_sets_minimum_width(self):\n    40\t        \"\"\"Test that __init__ sets minimum width correctly.\"\"\"\n    41\t        with patch(\"autocaption_dialog.get_caption_generator\"):\n    42\t            dialog = AutoCaptionDialog([\"path1.jpg\"])\n    43\t            assert dialog.minimumWidth() == 450\n    44\t\n    45\t    def test_init_sets_modal(self):\n    46\t        \"\"\"Test that __init__ sets window as modal.\"\"\"\n    47\t        with patch(\"autocaption_dialog.get_caption_generator\"):\n    48\t            dialog = AutoCaptionDialog([\"path1.jpg\"])\n    49\t            assert dialog.isModal()\n    50\t\n    51\t    def test_init_calls_setup_ui(self):\n    52\t        \"\"\"Test that __init__ calls _setup_ui method.\"\"\"\n    53\t        with patch(\"autocaption_dialog.get_caption_generator\"):\n    54\t            with patch.object(AutoCaptionDialog, \"_setup_ui\"):\n    55\t                with patch.object(AutoCaptionDialog, \"_load_settings\"):\n    56\t                    AutoCaptionDialog([\"path1.jpg\"])\n    57\t                    AutoCaptionDialog._setup_ui.assert_called_once()\n    58\t\n    59\t    def test_init_calls_load_settings(self):\n    60\t        \"\"\"Test that __init__ calls _load_settings method.\"\"\"\n    61\t        with patch(\"autocaption_dialog.get_caption_generator\"):\n    62\t            with patch.object(AutoCaptionDialog, \"_setup_ui\"):\n    63\t                with patch.object(AutoCaptionDialog, \"_load_settings\") as mock_load:\n    64\t                    AutoCaptionDialog([\"path1.jpg\"])\n    65\t                    mock_load.assert_called_once()","time":{"start":1772913932474,"end":1772913932478}}}}
