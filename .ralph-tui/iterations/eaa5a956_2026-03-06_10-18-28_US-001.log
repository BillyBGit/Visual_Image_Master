{"type":"tool_use","timestamp":1772752974142,"sessionID":"ses_d908964174d4","part":{"type":"tool","callID":"call_iki88f5h","tool":"read","state":{"status":"completed","input":{"file_path":"advanced_filter_dialog.py"},"output":"     1\t\"\"\"\n     2\tAdvanced filtering dialog for AI-powered image filtering.\n     3\tCombines face detection, object detection, scene recognition, and quality assessment.\n     4\t\"\"\"\n     5\t\n     6\tfrom PySide6.QtWidgets import (\n     7\t    QDialog,\n     8\t    QVBoxLayout,\n     9\t    QHBoxLayout,\n    10\t    QGroupBox,\n    11\t    QCheckBox,\n    12\t    QLabel,\n    13\t    QPushButton,\n    14\t    QSlider,\n    15\t    QScrollArea,\n    16\t    QWidget,\n    17\t    QRadioButton,\n    18\t    QFileDialog,\n    19\t    QLineEdit,\n    20\t)\n    21\tfrom PySide6.QtCore import Qt\n    22\t\n    23\tfrom object_detection import OBJECT_CATEGORIES\n    24\tfrom scene_recognition import SCENE_GROUPS\n    25\t\n    26\t\n    27\tclass AdvancedFilterDialog(QDialog):\n    28\t    \"\"\"Dialog for configuring advanced AI-powered filters.\"\"\"\n    29\t\n    30\t    def __init__(self, parent=None):\n    31\t        super().__init__(parent)\n    32\t        self.setWindowTitle(\"Advanced AI Filters\")\n    33\t        self.resize(700, 600)\n    34\t\n    35\t        # Store filter settings\n    36\t        self.filter_settings = {\n    37\t            \"global_invert\": False,  # Invert entire filter result\n    38\t            \"face_detection\": False,\n    39\t            \"face_count_min\": 0,\n    40\t            \"face_inverse\": False,  # True = does NOT contain\n    41\t            \"object_detection\": False,\n    42\t            \"object_categories\": [],\n    43\t            \"object_confidence\": 0.5,\n    44\t            \"object_inverse\": False,  # True = does NOT contain\n    45\t            \"custom_model_path\": None,  # Path to custom YOLO model\n    46\t            \"scene_recognition\": False,\n    47\t            \"scene_groups\": [],\n    48\t            \"scene_confidence\": 0.3,\n    49\t            \"scene_inverse\": False,  # True = does NOT contain\n    50\t            \"quality_filter\": False,\n    51\t            \"quality_min_score\": 60,\n    52\t            \"quality_sharpness_min\": 40,\n    53\t            \"quality_brightness_min\": 50,\n    54\t            \"quality_brightness_max\": 200,\n    55\t            \"quality_inverse\": False,  # True = does NOT meet criteria\n    56\t            \"filesize_filter\": False,\n    57\t            \"filesize_min_kb\": 0,  # Minimum file size in KB\n    58\t            \"filesize_max_kb\": 10240,  # Maximum file size in KB (10MB default)\n    59\t        }\n    60\t\n    61\t        self.setup_ui()\n    62\t\n    63\t    def setup_ui(self):\n    64\t        \"\"\"Setup the dialog UI.\"\"\"\n    65\t        main_layout = QVBoxLayout()\n    66\t\n    67\t        # Create scroll area for filters\n    68\t        scroll = QScrollArea()\n    69\t        scroll.setWidgetResizable(True)\n    70\t        scroll_widget = QWidget()\n    71\t        scroll_layout = QVBoxLayout(scroll_widget)\n    72\t\n    73\t        # Add filter sections\n    74\t        scroll_layout.addWidget(self.create_face_filter_section())\n    75\t        scroll_layout.addWidget(self.create_object_filter_section())\n    76\t        scroll_layout.addWidget(self.create_scene_filter_section())\n    77\t        scroll_layout.addWidget(self.create_quality_filter_section())\n    78\t        scroll_layout.addWidget(self.create_filesize_filter_section())\n    79\t\n    80\t        scroll.setWidget(scroll_widget)\n    81\t        main_layout.addWidget(scroll)\n    82\t\n    83\t        # Global invert option\n    84\t        self.global_invert_cb = QCheckBox(\n    85\t            \"Invert entire filter (show what does NOT match)\"\n    86\t        )\n    87\t        self.global_invert_cb.setStyleSheet(\"font-weight: bold; color: #FF5722;\")\n    88\t        self.global_invert_cb.stateChanged.connect(self.update_filter_settings)\n    89\t        main_layout.addWidget(self.global_invert_cb)\n    90\t\n    91\t        # Buttons\n    92\t        button_layout = QHBoxLayout()\n    93\t        self.apply_btn = QPushButton(\"Apply Filters\")\n    94\t        self.apply_btn.clicked.connect(self.accept)\n    95\t        self.clear_btn = QPushButton(\"Clear All\")\n    96\t        self.clear_btn.clicked.connect(self.clear_all_filters)\n    97\t        self.cancel_btn = QPushButton(\"Cancel\")\n    98\t        self.cancel_btn.clicked.connect(self.reject)\n    99\t\n   100\t        button_layout.addWidget(self.clear_btn)\n   101\t        button_layout.addStretch()\n   102\t        button_layout.addWidget(self.cancel_btn)\n   103\t        button_layout.addWidget(self.apply_btn)\n   104\t\n   105\t        main_layout.addLayout(button_layout)\n   106\t        self.setLayout(main_layout)\n   107\t\n   108\t    def create_face_filter_section(self):\n   109\t        \"\"\"Create face detection filter section.\"\"\"\n   110\t        group = QGroupBox(\"Face Detection\")\n   111\t        layout = QVBoxLayout()\n   112\t\n   113\t        self.face_enable_cb = QCheckBox(\"Filter by faces\")\n   114\t        self.face_enable_cb.stateChanged.connect(self.update_filter_settings)\n   115\t        layout.addWidget(self.face_enable_cb)\n   116\t\n   117\t        # Contains/Does not contain\n   118\t        mode_layout = QHBoxLayout()\n   119\t        self.face_contains_rb = QRadioButton(\"Contains\")\n   120\t        self.face_contains_rb.setChecked(True)\n   121\t        self.face_contains_rb.toggled.connect(self.update_filter_settings)\n   122\t        self.face_not_contains_rb = QRadioButton(\"Does NOT contain\")\n   123\t        self.face_not_contains_rb.toggled.connect(self.update_filter_settings)\n   124\t        mode_layout.addWidget(self.face_contains_rb)\n   125\t        mode_layout.addWidget(self.face_not_contains_rb)\n   126\t        mode_layout.addStretch()\n   127\t        layout.addLayout(mode_layout)\n   128\t\n   129\t        # Minimum face count\n   130\t        face_count_layout = QHBoxLayout()\n   131\t        face_count_layout.addWidget(QLabel(\"Minimum faces:\"))\n   132\t        self.face_count_slider = QSlider(Qt.Orientation.Horizontal)\n   133\t        self.face_count_slider.setRange(0, 10)\n   134\t        self.face_count_slider.setValue(0)\n   135\t        self.face_count_slider.valueChanged.connect(self.update_filter_settings)\n   136\t        self.face_count_label = QLabel(\"0\")\n   137\t        face_count_layout.addWidget(self.face_count_slider)\n   138\t        face_count_layout.addWidget(self.face_count_label)\n   139\t        layout.addLayout(face_count_layout)\n   140\t\n   141\t        self.face_count_slider.valueChanged.connect(\n   142\t            lambda v: self.face_count_label.setText(str(v))\n   143\t        )\n   144\t\n   145\t        group.setLayout(layout)\n   146\t        return group\n   147\t\n   148\t    def create_object_filter_section(self):\n   149\t        \"\"\"Create object detection filter section.\"\"\"\n   150\t        group = QGroupBox(\"Object Detection (YOLO)\")\n   151\t        layout = QVBoxLayout()\n   152\t\n   153\t        self.object_enable_cb = QCheckBox(\"Filter by objects\")\n   154\t        self.object_enable_cb.stateChanged.connect(self.update_filter_settings)\n   155\t        layout.addWidget(self.object_enable_cb)\n   156\t\n   157\t        # Contains/Does not contain\n   158\t        mode_layout = QHBoxLayout()\n   159\t        self.object_contains_rb = QRadioButton(\"Contains\")\n   160\t        self.object_contains_rb.setChecked(True)\n   161\t        self.object_contains_rb.toggled.connect(self.update_filter_settings)\n   162\t        self.object_not_contains_rb = QRadioButton(\"Does NOT contain\")\n   163\t        self.object_not_contains_rb.toggled.connect(self.update_filter_settings)\n   164\t        mode_layout.addWidget(self.