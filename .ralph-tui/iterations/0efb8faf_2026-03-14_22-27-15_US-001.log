3\t        self.has_unsaved_changes = False\n    54\t        self.current_caption_path = None\n    55\t        self.caption_worker = None\n    56\t        self.blend_worker = None\n    57\t\n    58\t        # Undo/redo history for generated caption (stores previous states)\n    59\t        self._generated_undo_stack = []  # Stack of previous texts\n    60\t        self._generated_redo_stack = []  # Stack for redo\n    61\t\n    62\t        # Initialization flag - prevents re-initialization on subsequent show events\n    63\t        self._initialized = False\n    64\t        self._maximize_attempts = 0\n    65\t\n    66\t        # Caption generator (singleton)\n    67\t        self.generator = get_caption_generator()\n    68\t\n    69\t        # Set window title\n    70\t        self.setWindowTitle(\"Auto Caption Tool\")\n    71\t\n    72\t        # Setup UI\n    73\t        self._setup_ui()\n    74\t        self._setup_menu()\n    75\t        self._setup_shortcuts()\n    76\t        self._load_settings()\n    77\t\n    78\t        # Event configuration\n    79\t        self.setFocusPolicy(Qt.FocusPolicy.StrongFocus)\n    80\t        self.scroll_area.installEventFilter(self)\n    81\t\n    82\t    def _setup_ui(self):\n    83\t        \"\"\"Setup the main UI with splitter layout.\"\"\"\n    84\t        # Main splitter\n    85\t        self.splitter = QSplitter(Qt.Orientation.Horizontal)\n    86\t        self.setCentralWidget(self.splitter)\n    87\t\n    88\t        # Left side: Image display area\n    89\t        self.scroll_area = QScrollArea()\n    90\t        self.image_label = QLabel()\n    91\t        self.image_label.setAlignment(Qt.AlignmentFlag.AlignCenter)\n    92\t        self.scroll_area.setWidget(self.image_label)\n    93\t        self.scroll_area.setWidgetResizable(True)\n    94\t        self.splitter.addWidget(self.scroll_area)\n    95\t\n    96\t        # Right side: Caption panel\n    97\t        self.right_panel = QWidget()\n    98\t        self.right_panel_layout = QVBoxLayout(self.right_panel)\n    99\t        self.right_panel_layout.setContentsMargins(10, 10, 10, 10)\n   100\t        self.right_panel_layout.setSpacing(10)\n   101\t\n   102\t        # Backend selection group\n   103\t        backend_group = QGroupBox(\"Caption Backend\")\n   104\t        backend_layout = QVBoxLayout(backend_group)\n   105\t\n   106\t        # Backend dropdown\n   107\t        backend_row = QHBoxLayout()\n   108\t        backend_row.addWidget(QLabel(\"Backend:\"))\n   109\t        self.backend_combo = QComboBox()\n   110\t        self.backend_combo.addItem(\"Florence2 (Local)\", \"florence2\")\n   111\t        self.backend_combo.addItem(\"WD14 Tagger (Local)\", \"wd14\")\n   112\t        self.backend_combo.addItem(\"Ollama (Server)\", \"ollama\")\n   113\t        self.backend_combo.currentIndexChanged.connect(self._on_backend_changed)\n   114\t        backend_row.addWidget(self.backend_combo, 1)\n   115\t        backend_layout.addLayout(backend_row)\n   116\t\n   117\t        # Status label (used by Florence2 and WD14)\n   118\t        self.backend_status = QLabel()\n   119\t        self.backend_status.setWordWrap(True)\n   120\t        self.backend_status.setStyleSheet(\"QLabel { color: gray; font-size: 11px; }\")\n   121\t        backend_layout.addWidget(self.backend_status)\n   122\t\n   123\t        # Florence2 settings widget\n   124\t        self.florence_widget = QWidget()\n   125\t        florence_layout = QVBoxLayout(self.florence_widget)\n   126\t        florence_layout.setContentsMargins(0, 5, 0, 0)\n   127\t\n   128\t        # Model size dropdown with sizes\n   129\t        model_row = QHBoxLayout()\n   130\t        model_row.addWidget(QLabel(\"Model:\"))\n   131\t        self.florence_model_combo = QComboBox()\n   132\t        self.florence_model_combo.addItem(\"Base (~460MB)\", \"base\")\n   133\t        self.florence_model_combo.addItem(\"Large (~1.5GB)\", \"large\")\n   134\t        self.florence_model_combo.a