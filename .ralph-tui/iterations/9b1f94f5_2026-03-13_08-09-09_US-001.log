{"type":"tool_use","timestamp":1773350649061,"sessionID":"ses_6b1566888077","part":{"type":"tool","callID":"call_9xnt3fmt","tool":"write","state":{"status":"completed","input":{"content":"\"\"\"Tests for CaptionGenerator.generate_wd14 method.\"\"\"\n\nfrom unittest.mock import patch, MagicMock\nfrom caption_generator import CaptionGenerator\n\n\nclass TestCaptionGeneratorGenerateWD14:\n    \"\"\"Test suite for CaptionGenerator.generate_wd14 method.\"\"\"\n\n    def test_generate_wd14_valid_image(self):\n        \"\"\"Test generate_wd14 with valid image and ONNX format.\"\"\"\n        generator = CaptionGenerator()\n\n        with patch.object(generator, 'validate_image', return_value=(True, \"Image OK\")):\n            with patch.object(generator, 'load_wd14'):\n                with patch.object(generator, '_generate_wd14_onnx', return_value=[0.5, 0.6, 0.2]):\n                    generator.wd14_tags = [\n                        {'name': 'cat', 'category': 1},\n                        {'name': 'dog', 'category': 1},\n                        {'name': 'car', 'category': 2}\n                    ]\n                    generator.wd14_format = \"onnx\"\n                    generator.wd14_img_size = 224\n\n                    result = generator.generate_wd14('test.jpg', 'vit-v2', 0.35)\n\n                    assert result == 'cat, dog'\n\n    def test_generate_wd14_invalid_image(self):\n        \"\"\"Test generate_wd14 with invalid image raises RuntimeError.\"\"\"\n        generator = CaptionGenerator()\n\n        with patch.object(generator, 'validate_image', return_value=(False, \"Image not found\")):\n            try:\n                generator.generate_wd14('invalid.jpg', 'vit-v2', 0.35)\n                assert False, \"Should have raised RuntimeError\"\n            except RuntimeError as e:\n                assert 'Image validation failed' in str(e)\n\n    def test_generate_wd14_threshold_filtering(self):\n        \"\"\"Test generate_wd14 filters tags based on threshold.\"\"\"\n        generator = CaptionGenerator()\n\n        with patch.object(generator, 'validate_image', return_value=(True, \"Image OK\")):\n            with patch.object(generator, 'load_wd14'):\n                with patch.object(generator, '_generate_wd14_pytorch', return_value=[0.2, 0.8, 0.4]):\n                    generator.wd14_tags = [\n                        {'name': 'cat', 'category': 1},\n                        {'name': 'dog', 'category': 1},\n                        {'name': 'car', 'category': 2}\n                    ]\n                    generator.wd14_format = \"pytorch\"\n                    generator.wd14_img_size = 224\n\n                    result = generator.generate_wd14('test.jpg', 'vit-v2', 0.5)\n\n                    assert result == 'dog'\n\n    def test_generate_wd14_category_filtering(self):\n        \"\"\"Test generate_wd14 skips rating category tags.\"\"\"\n        generator = CaptionGenerator()\n\n        with patch.object(generator, 'validate_image', return_value=(True, \"Image OK\")):\n            with patch.object(generator, 'load_wd14'):\n                with patch.object(generator, '_generate_wd14_onnx', return_value=[0.6, 0.7, 0.5]):\n                    generator.wd14_tags = [\n                        {'name': 'cat', 'category': 1},\n                        {'name': 'dog', 'category': 1},\n                        {'name': 'car', 'category': 9}\n                    ]\n                    generator.wd14_format = \"onnx\"\n                    generator.wd14_img_size = 224\n\n                    result = generator.generate_wd14('test.jpg', 'vit-v2', 0.35)\n\n                    assert result == 'cat, dog'\n\n    def test_generate_wd14_sorting(self):\n        \"\"\"Test generate_wd14 sorts tags by probability.\"\"\"\n        generator = CaptionGenerator()\n\n        with patch.object(generator, 'validate_image', return_value=(True, \"Image OK\")):\n            with patch.object(generator, 'load_wd14'):\n                with patch.object(generator, '_generate_wd14_onnx', return_value=[0.7, 0.5, 0.8]):\n                    generator.wd14_tags = [\n                        {'name': 'cat', 'category': 1},\n                        {'name': 'dog', 'category': 1},\n                        {'name': 'car', 'category': 2}\n                    ]\n                    generator.wd14_format = \"onnx\"\n                    generator.wd14_img_size = 224\n\n                    result = generator.generate_wd14('test.jpg', 'vit-v2', 0.35)\n\n                    assert result == 'car, cat, dog'\n\n    def test_generate_wd14_underscore_replacement(self):\n        \"\"\"Test generate_wd14 replaces underscores with spaces.\"\"\"\n        generator = CaptionGenerator()\n\n        with patch.object(generator, 'validate_image', return_value=(True, \"Image OK\")):\n            with patch.object(generator, 'load_wd14'):\n                with patch.object(generator, '_generate_wd14_onnx', return_value=[0.6]):\n                    generator.wd14_tags = [\n                        {'name': 'black_cat', 'category': 1}\n                    ]\n                    generator.wd14_format = \"onnx\"\n                    generator.wd14_img_size = 224\n\n                    result = generator.generate_wd14('test.jpg', 'vit-v2', 0.35)\n\n                    assert result == 'black cat'\n\n    def test_generate_wd14_pytorch_path(self):\n        \"\"\"Test generate_wd14 uses PyTorch path when format is not ONNX.\"\"\"\n        generator = CaptionGenerator()\n\n        with patch.object(generator, 'validate_image', return_value=(True, \"Image OK\")):\n            with patch.object(generator, 'load_wd14'):\n                with patch.object(generator, '_generate_wd14_pytorch', return_value=[0.6]):\n                    generator.wd14_tags = [\n                        {'name': 'cat', 'category': 1}\n                    ]\n                    generator.wd14_format = \"pytorch\"\n                    generator.wd14_img_size = 224\n\n                    result = generator.generate_wd14('test.jpg', 'vit-v2', 0.35)\n\n                    assert result == 'cat'\n","file_path":"tests/unit/test_caption_generator_CaptionGenerator_generate_wd14.py"},"output":"Wrote 5719 bytes to tests/unit/test_caption_generator_CaptionGenerator_generate_wd14.py","time":{"start":1773350649061,"end":1773350649061}}}}
