ing backend hides other widgets.\"\"\"\n        dialog = AutoCaptionDialog([])\n        \n        # First set to florence2\n        dialog.backend_combo.setCurrentIndex(0)\n        dialog._on_backend_changed(0)\n        assert dialog.florence_widget.isVisible() is True\n        assert dialog.wd14_widget.isVisible() is False\n        assert dialog.ollama_widget.isVisible() is False\n        \n        # Then change to wd14\n        dialog.backend_combo.setCurrentIndex(1)\n        dialog._on_backend_changed(1)\n        assert dialog.florence_widget.isVisible() is False\n        assert dialog.wd14_widget.isVisible() is True\n        assert dialog.ollama_widget.isVisible() is False\n\n    def test_backend_change_updates_visibility_correctly(self):\n        \"\"\"Test that backend changes update visibility correctly for all options.\"\"\"\n        dialog = AutoCaptionDialog([])\n        \n        # Test florence2\n        dialog.backend_combo.setCurrentIndex(0)\n        dialog._on_backend_changed(0)\n        assert dialog.florence_widget.isVisible() is True\n        assert dialog.wd14_widget.isVisible() is False\n        assert dialog.ollama_widget.isVisible() is False\n        \n        # Test wd14\n        dialog.backend_combo.setCurrentIndex(1)\n        dialog._on_backend_changed(1)\n        assert dialog.florence_widget.isVisible() is False\n        assert dialog.wd14_widget.isVisible() is True\n        assert dialog.ollama_widget.isVisible() is False\n        \n        # Test ollama\n        dialog.backend_combo.setCurrentIndex(2)\n        dialog._on_backend_changed(2)\n        assert dialog.florence_widget.isVisible() is False\n        assert dialog.wd14_widget.isVisible() is False\n        assert dialog.ollama_widget.isVisible() is True\n\n    def test_backend_change_with_invalid_index(self):\n        \"\"\"Test that invalid index doesn't crash and maintains default state.\"\"\"\n        dialog = AutoCaptionDialog([])\n        dialog._on_backend_changed(999)  # Invalid index\n        \n        # Should maintain default state (all widgets hidden)\n        assert dialog.florence_widget.isVisible() is False\n        assert dialog.wd14_widget.isVisible() is False\n        assert dialog.ollama_widget.isVisible() is False\n\n    def test_backend_change_preserves_other_ui_elements(self):\n        \"\"\"Test that changing backend preserves other UI elements.\"\"\"\n        dialog = AutoCaptionDialog([])\n        \n        # Store initial state of other UI elements\n        initial_progress_visible = dialog.progress_bar.isVisible()\n        initial_button_text = dialog.generate_btn.text()\n        \n        # Change backend\n        dialog.backend_combo.setCurrentIndex(0)\n        dialog._on_backend_changed(0)\n        \n        # Verify other UI elements are unchanged\n        assert dialog.progress_bar.isVisible() == initial_progress_visible\n        assert dialog.generate_btn.text() == initial_button_text\n","old_string":"\"\"\"Tests for AutoCaptionDialog._on_backend_changed method.\"\"\"\n\nimport pytest\nfrom autocaption_dialog import AutoCaptionDialog\n\n\nclass TestAutoCaptionDialogBackendChanged:\n    \"\"\"Test suite for AutoCaptionDialog._on_backend_changed method.\"\"\"\n\n    def test_backend_florence2_shows_florence_widget(self):\n        \"\"\"Test that selecting florence2 backend shows florence_widget.\"\"\"\n        dialog = AutoCaptionDialog([])\n        dialog.backend_combo.setCurrentData(\"florence2\")\n        dialog._on_backend_changed(0)\n        \n        assert dialog.florence_widget.isVisible() is True\n        assert dialog.wd14_widget.isVisible() is False\n        assert dialog.ollama_widget.isVisible() is False\n\n    def test_backend_wd14_shows_wd14_widget(self):\n        \"\"\"Test that selecting wd14 backend shows wd14_widget.\"\"\"\n        dialog = AutoCaptionDialog([])\n        dialog.backend_combo.setCurrentData(\"wd14\")\n        dialog._on_backend_changed(1)\n        \n        assert dialog.wd14_wi