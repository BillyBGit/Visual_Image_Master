ded(self):\n    38\t        \"\"\"Test that loading the same model twice returns True without reloading.\"\"\"\n    39\t        caption_gen = CaptionGenerator()\n    40\t        result1 = caption_gen.load_florence(model_key=\"base\")\n    41\t        model_name = caption_gen._current_florence_model\n    42\t        result2 = caption_gen.load_florence(model_key=\"base\")\n    43\t        assert result1 is True\n    44\t        assert result2 is True\n    45\t        assert caption_gen._florence_loaded is True\n    46\t        assert caption_gen._current_florence_model == model_name\n    47\t\n    48\t    def test_load_florence_switch_model(self):\n    49\t        \"\"\"Test switching from base to large model.\"\"\"\n    50\t        caption_gen = CaptionGenerator()\n    51\t        caption_gen.load_florence(model_key=\"base\")\n    52\t        base_model = caption_gen._current_florence_model\n    53\t        caption_gen.load_florence(model_key=\"large\")\n    54\t        assert caption_gen._florence_loaded is True\n    55\t        assert caption_gen._current_florence_model != base_model\n    56\t        assert \"large\" in caption_gen._current_florence_model\n    57\t\n    58\t    def test_load_florence_missing_dependencies(self):\n    59\t        \"\"\"Test that missing dependencies raise RuntimeError.\"\"\"\n    60\t        caption_gen = CaptionGenerator()\n    61\t        with patch.dict(\"sys.modules\", {\"torch\": None, \"transformers\": None}):\n    62\t            with pytest.raises(RuntimeError, match=\"Failed to load Florence2\"):\n    63\t                caption_gen.load_florence(model_key=\"base\")","time":{"start":1773252697394,"end":1773252697394}}}}
