{"type":"tool_use","timestamp":1773252088281,"sessionID":"ses_c0a0bcef7f2d","part":{"type":"tool","callID":"call_48557kra","tool":"read","state":{"status":"completed","input":{"file_path":"caption_generator.py","offset":200,"limit":200},"output":"   200\t            missing = str(e).split(\"'\")[1] if \"'\" in str(e) else str(e)\n   201\t            return (\n   202\t                False,\n   203\t                f\"Missing '{missing}' \u2014 install with: pip install transformers torch\",\n   204\t            )\n   205\t\n   206\t    def is_wd14_available(self) -> Tuple[bool, str]:\n   207\t        \"\"\"Check if WD14 dependencies are available.\n   208\t\n   209\t        Returns:\n   210\t            Tuple of (available, message)\n   211\t        \"\"\"\n   212\t        # Check for at least one model loading backend\n   213\t        has_onnx = False\n   214\t        has_torch = False\n   215\t\n   216\t        try:\n   217\t            import onnxruntime  # noqa: F401\n   218\t\n   219\t            has_onnx = True\n   220\t        except ImportError:\n   221\t            pass\n   222\t\n   223\t        try:\n   224\t            import torch  # noqa: F401\n   225\t\n   226\t            has_torch = True\n   227\t        except ImportError:\n   228\t            pass\n   229\t\n   230\t        # Need huggingface_hub for downloading\n   231\t        try:\n   232\t            import huggingface_hub  # noqa: F401\n   233\t        except ImportError:\n   234\t            return (\n   235\t                False,\n   236\t                \"Missing: huggingface_hub. Install with: pip install huggingface-hub\",\n   237\t            )\n   238\t\n   239\t        # Need at least one backend\n   240\t        if not has_onnx and not has_torch:\n   241\t            return (\n   242\t                False,\n   243\t                \"Missing model backend. Install onnxruntime or torch: pip install onnxruntime\",\n   244\t            )\n   245\t\n   246\t        backends = []\n   247\t        if has_onnx:\n   248\t            backends.append(\"ONNX\")\n   249\t        if has_torch:\n   250\t            backends.append(\"PyTorch\")\n   251\t\n   252\t        return True, f\"WD14 ready ({', '.join(backends)})\"\n   253\t\n   254\t    def validate_image(self, image_path: str) -> Tuple[bool, str]:\n   255\t        \"\"\"Validate an image before caption generation.\n   256\t\n   257\t        Args:\n   258\t            image_path: Path to image file\n   259\t\n   260\t        Returns:\n   261\t            Tuple of (valid, message)\n   262\t        \"\"\"\n   263\t        # Check file exists\n   264\t        if not os.path.isfile(image_path):\n   265\t            return False, f\"Image file not found: {image_path}\"\n   266\t\n   267\t        # Check file size (reject empty files)\n   268\t        file_size = os.path.getsize(image_path)\n   269\t        if file_size == 0:\n   270\t            return False, \"Image file is empty (0 bytes)\"\n   271\t\n   272\t        try:\n   273\t            # Try to open and validate the image\n   274\t            with Image.open(image_path) as img:\n   275\t                # Check format\n   276\t                if img.format is None:\n   277\t                    return False, \"Unable to determine image format\"\n   278\t\n   279\t                # Check mode (must be convertible to RGB)\n   280\t                valid_modes = [\n   281\t                    \"RGB\",\n   282\t                    \"RGBA\",\n   283\t                    \"L\",\n   284\t                    \"LA\",\n   285\t                    \"P\",\n   286\t                    \"1\",\n   287\t                    \"CMYK\",\n   288\t                    \"YCbCr\",\n   289\t                    \"LAB\",\n   290\t                    \"HSV\",\n   291\t                ]\n   292\t                if img.mode not in valid_modes:\n   293\t                    return False, f\"Unsupported image mode: {img.mode}\"\n   294\t\n   295\t                # Check dimensions\n   296\t                width, height = img.size\n   297\t                if width < 10 or height < 10:\n   298\t                    return (\n   299\t                        False,\n   300\t                        f\"Image too small: {width}x{height}. Minimum 10x10 pixels required.\",\n   301\t                    )\n   302\t\n   303\t                if width > 10000 or height > 10000:\n   304\t                    return (\n   305\t                        False,\n   306\t                        f\"Image too large: {width}x{height}. Maximum 10000x10000 pixels.\",\n   307\t                    )\n   308\t\n   309\t                # Try to actually load the image data to catch corrupt files\n   310\t                try:\n   311\t                    img.load()\n   312\t                except Exception as e:\n   313\t                    return False, f\"Image data is corrupt: {e}\"\n   314\t\n   315\t                # Try converting to RGB to catch conversion issues\n   316\t                try:\n   317\t                    rgb_img = img.convert(\"RGB\")\n   318\t                    # Verify we got valid data\n   319\t                    if rgb_img.size[0] <= 0 or rgb_img.size[1] <= 0:\n   320\t                        return False, \"Failed to convert image to RGB\"\n   321\t                except Exception as e:\n   322\t                    return False, f\"Cannot convert to RGB: {e}\"\n   323\t\n   324\t        except Image.UnidentifiedImageError:\n   325\t            return False, \"File is not a valid image or format is not supported\"\n   326\t        except Exception as e:\n   327\t            return False, f\"Error reading image: {e}\"\n   328\t\n   329\t        return True, f\"Image OK ({width}x{height})\"\n   330\t\n   331\t    def set_custom_model_path(self, path: str):\n   332\t        \"\"\"Set a custom Florence2 model path (local directory or HuggingFace ID).\n   333\t\n   334\t        Args:\n   335\t            path: Path to local model directory or HuggingFace model ID\n   336\t        \"\"\"\n   337\t        self.custom_model_path = path if path else None\n   338\t\n   339\t    def set_wd14_custom_path(self, model_key: str, path: str):\n   340\t        \"\"\"Set a custom path for a specific WD14 model.\n   341\t\n   342\t        Args:\n   343\t            model_key: Key from WD14_MODELS dict (e.g., \"vit-v2\")\n   344\t            path: Path to local model file (.onnx, .safetensors, .pt, etc.)\n   345\t        \"\"\"\n   346\t        if path and os.path.isfile(path):\n   347\t            self.wd14_custom_paths[model_key] = path\n   348\t            _debug(f\"Set custom path for WD14 model '{model_key}': {path}\")\n   349\t        elif model_key in self.wd14_custom_paths:\n   350\t            # Clear custom path if empty path provided\n   351\t            del self.wd14_custom_paths[model_key]\n   352\t            _debug(f\"Cleared custom path for WD14 model '{model_key}'\")\n   353\t\n   354\t    def unload_florence(self):\n   355\t        \"\"\"Unload the current Florence2 model to free memory.\"\"\"\n   356\t        if self._florence_loaded:\n   357\t            _debug(\"Unloading Florence2 model...\")\n   358\t            import gc\n   359\t\n   360\t            self.florence_model = None\n   361\t            self.florence_processor = None\n   362\t            self._florence_loaded = False\n   363\t            self._current_florence_model = None\n   364\t            gc.collect()\n   365\t            try:\n   366\t                import torch\n   367\t\n   368\t                if torch.cuda.is_available():\n   369\t                    torch.cuda.empty_cache()\n   370\t            except Exception:\n   371\t                pass\n   372\t            _debug(\"Florence2 model unloaded\")\n   373\t\n   374\t    def load_florence(self, model_key: str = \"base\") -> bool:\n   375\t        \"\"\"Load Florence2 model (lazy loading on first use).\n   376\t\n   377\t        Args:\n   378\t            model_key: Key from FLORENCE_MODELS dict, or 'custom' to use custom_model_path\n   379\t\n   380\t        Returns:\n   381\t            True if loaded successfully\n   382\t        \"\"\"\n   383\t        # Resolve model name from key or custom path\n   384\t        if model_key == \"custom\" and self.custom_model_path:\n   385\t            model_name = self.custom_model_path\n   386\t        elif model_key in FLORENCE_MODELS:\n   387\t            model_name = FLORENCE_MODELS[model_key][0]  # Tuple: (path, size)\n   388\t        else:\n   389\t            # Fallback to base model\n   390\t            model_name = FLORENCE_MODELS[\"base\"][0]\n   391\t\n   392\t        # Check if same model is already loaded\n   393\t        if self._florence_loaded and self._current_f\n... (truncated at 8000 chars)","time":{"start":1773252088281,"end":1773252088281}}}}
