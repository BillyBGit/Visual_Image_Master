{"type":"tool_use","timestamp":1773252066830,"sessionID":"ses_c0a0bcef7f2d","part":{"type":"tool","callID":"call_01tvuc7x","tool":"read","state":{"status":"completed","input":{"file_path":"tests/unit/test_caption_generator_CaptionGenerator_load_florence.py"},"output":"     1\t\"\"\"Tests for CaptionGenerator.load_florence() method.\"\"\"\n     2\t\n     3\timport pytest\n     4\tfrom unittest.mock import patch\n     5\tfrom caption_generator import CaptionGenerator\n     6\t\n     7\t\n     8\tclass TestCaptionGeneratorLoadFlorence:\n     9\t    \"\"\"Test suite for CaptionGenerator.load_florence() method.\"\"\"\n    10\t\n    11\t    def test_load_florence_base_model(self):\n    12\t        \"\"\"Test loading the base Florence2 model.\"\"\"\n    13\t        caption_gen = CaptionGenerator()\n    14\t        result = caption_gen.load_florence(model_key=\"base\")\n    15\t        assert result is True\n    16\t        assert caption_gen._florence_loaded is True\n    17\t        assert \"base\" in caption_gen._current_florence_model\n    18\t\n    19\t    def test_load_florence_large_model(self):\n    20\t        \"\"\"Test loading the large Florence2 model.\"\"\"\n    21\t        caption_gen = CaptionGenerator()\n    22\t        result = caption_gen.load_florence(model_key=\"large\")\n    23\t        assert result is True\n    24\t        assert caption_gen._florence_loaded is True\n    25\t        assert \"large\" in caption_gen._current_florence_model\n    26\t\n    27\t    def test_load_florence_custom_model(self):\n    28\t        \"\"\"Test loading a custom Florence2 model.\"\"\"\n    29\t        caption_gen = CaptionGenerator()\n    30\t        custom_path = \"/path/to/custom/model\"\n    31\t        caption_gen.custom_model_path = custom_path\n    32\t        result = caption_gen.load_florence(model_key=\"custom\")\n    33\t        assert result is True\n    34\t        assert caption_gen._florence_loaded is True\n    35\t        assert caption_gen._current_florence_model == custom_path\n    36\t\n    37\t    def test_load_florence_invalid_key(self):\n    38\t        \"\"\"Test loading with invalid key falls back to base model.\"\"\"\n    39\t        caption_gen = CaptionGenerator()\n    40\t        result = caption_gen.load_florence(model_key=\"invalid\")\n    41\t        assert result is True\n    42\t        assert caption_gen._florence_loaded is True\n    43\t        assert \"base\" in caption_gen._current_florence_model\n    44\t\n    45\t    def test_load_florence_already_loaded(self):\n    46\t        \"\"\"Test that loading the same model twice returns True without reloading.\"\"\"\n    47\t        caption_gen = CaptionGenerator()\n    48\t        result1 = caption_gen.load_florence(model_key=\"base\")\n    49\t        model_name = caption_gen._current_florence_model\n    50\t        result2 = caption_gen.load_florence(model_key=\"base\")\n    51\t        assert result1 is True\n    52\t        assert result2 is True\n    53\t        assert caption_gen._florence_loaded is True\n    54\t        assert caption_gen._current_florence_model == model_name\n    55\t\n    56\t    def test_load_florence_switch_model(self):\n    57\t        \"\"\"Test switching from base to large model.\"\"\"\n    58\t        caption_gen = CaptionGenerator()\n    59\t        caption_gen.load_florence(model_key=\"base\")\n    60\t        base_model = caption_gen._current_florence_model\n    61\t        caption_gen.load_florence(model_key=\"large\")\n    62\t        assert caption_gen._florence_loaded is True\n    63\t        assert caption_gen._current_florence_model != base_model\n    64\t        assert \"large\" in caption_gen._current_florence_model\n    65\t\n    66\t    def test_load_florence_missing_dependencies(self):\n    67\t        \"\"\"Test that missing dependencies raise RuntimeError.\"\"\"\n    68\t        caption_gen = CaptionGenerator()\n    69\t        with patch.dict(\"sys.modules\", {\"torch\": None, \"transformers\": None}):\n    70\t            with pytest.raises(RuntimeError, match=\"Failed to load Florence2\"):\n    71\t                caption_gen.load_florence(model_key=\"base\")","time":{"start":1773252066830,"end":1773252066830}}}}
