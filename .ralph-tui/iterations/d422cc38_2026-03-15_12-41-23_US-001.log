{"type":"tool_use","timestamp":1773539497238,"sessionID":"ses_ac837b7e1bbb","part":{"type":"tool","callID":"call_fh7epspl","tool":"read","state":{"status":"completed","input":{"file_path":"caption_window.py","limit":100},"output":"     1\t\"\"\"\n     2\tAuto Caption window for generating and editing image captions.\n     3\t\"\"\"\n     4\t\n     5\timport os\n     6\tfrom PySide6.QtWidgets import (\n     7\t    QMainWindow,\n     8\t    QScrollArea,\n     9\t    QLabel,\n    10\t    QSplitter,\n    11\t    QWidget,\n    12\t    QVBoxLayout,\n    13\t    QHBoxLayout,\n    14\t    QStatusBar,\n    15\t    QApplication,\n    16\t    QComboBox,\n    17\t    QGroupBox,\n    18\t    QPushButton,\n    19\t    QTextEdit,\n    20\t    QLineEdit,\n    21\t    QMessageBox,\n    22\t    QDoubleSpinBox,\n    23\t)\n    24\tfrom PySide6.QtCore import Qt, QTimer, QSize\n    25\tfrom PySide6.QtGui import QAction, QPixmap, QKeySequence, QShortcut\n    26\t\n    27\tfrom utils import find_main_window\n    28\tfrom caption_generator import get_caption_generator, CaptionWorker, BlendWorker\n    29\t\n    30\t\n    31\tclass CaptionWindow(QMainWindow):\n    32\t    \"\"\"Window for generating and editing image captions.\"\"\"\n    33\t\n    34\t    def __init__(self, image_list, current_index, parent=None):\n    35\t        super().__init__(parent)\n    36\t\n    37\t        # Establish the Main Window reference\n    38\t        self.parent_app = parent\n    39\t        if not self.parent_app:\n    40\t            self.parent_app = find_main_window()\n    41\t\n    42\t        # Core data\n    43\t        self.image_list = image_list\n    44\t        self.current_index = current_index\n    45\t        self.zoom_factor = 1.0\n    46\t        self.original_pixmap = QPixmap()\n    47\t        self.displayed_pixmap = QPixmap()\n    48\t\n    49\t        # View settings\n    50\t        self.fit_to_window = True  # Start in fit mode for caption viewing\n    51\t\n    52\t        # Caption state\n    53\t        self.has_unsaved_changes = False\n    54\t        self.current_caption_path = None\n    55\t        self.caption_worker = None\n    56\t        self.blend_worker = None\n    57\t\n    58\t        # Undo/redo history for generated caption (stores previous states)\n    59\t        self._generated_undo_stack = []  # Stack of previous texts\n    60\t        self._generated_redo_stack = []  # Stack for redo\n    61\t\n    62\t        # Initialization flag - prevents re-initialization on subsequent show events\n    63\t        self._initialized = False\n    64\t        self._maximize_attempts = 0\n    65\t\n    66\t        # Caption generator (singleton)\n    67\t        self.generator = get_caption_generator()\n    68\t\n    69\t        # Set window title\n    70\t        self.setWindowTitle(\"Auto Caption Tool\")\n    71\t\n    72\t        # Setup UI\n    73\t        self._setup_ui()\n    74\t        self._setup_menu()\n    75\t        self._setup_shortcuts()\n    76\t        self._load_settings()\n    77\t\n    78\t        # Event configuration\n    79\t        self.setFocusPolicy(Qt.FocusPolicy.StrongFocus)\n    80\t        self.scroll_area.installEventFilter(self)\n    81\t\n    82\t    def _setup_ui(self):\n    83\t        \"\"\"Setup the main UI with splitter layout.\"\"\"\n    84\t        # Main splitter\n    85\t        self.splitter = QSplitter(Qt.Orientation.Horizontal)\n    86\t        self.setCentralWidget(self.splitter)\n    87\t\n    88\t        # Left side: Image display area\n    89\t        self.scroll_area = QScrollArea()\n    90\t        self.image_label = QLabel()\n    91\t        self.image_label.setAlignment(Qt.AlignmentFlag.AlignCenter)\n    92\t        self.scroll_area.setWidget(self.image_label)\n    93\t        self.scroll_area.setWidgetResizable(True)\n    94\t        self.splitter.addWidget(self.scroll_area)\n    95\t\n    96\t        # Right side: Caption panel\n    97\t        self.right_panel = QWidget()\n    98\t        self.right_panel_layout = QVBoxLayout(self.right_panel)\n    99\t        self.right_panel_layout.setContentsMargins(10, 10, 10, 10)\n   100\t        self.right_panel_layout.setSpacing(10)","time":{"start":1773539497238,"end":1773539497238}}}}
