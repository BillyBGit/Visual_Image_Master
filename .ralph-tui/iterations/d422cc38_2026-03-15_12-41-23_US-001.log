cts of setup methods prove they were all called\n    77\t        assert window.windowTitle() == 'Auto Caption Tool'\n    78\t        assert window.scroll_area is not None  # set by mock _setup_ui\n    79\t\n    80\t    def test_init_sets_window_title(self, mock_caption_window):\n    81\t        \"\"\"Test that window title is set correctly.\"\"\"\n    82\t        window = mock_caption_window([], 0)\n    83\t\n    84\t        assert window.windowTitle() == 'Auto Caption Tool'\n    85\t\n    86\t    def test_init_sets_focus_policy(self, mock_caption_window):\n    87\t        \"\"\"Test that focus policy is set correctly.\"\"\"\n    88\t        window = mock_caption_window([], 0)\n    89\t\n    90\t        assert window.focusPolicy() == Qt.FocusPolicy.StrongFocus\n    91\t\n    92\t    def test_init_installs_event_filter(self, mock_caption_window):\n    93\t        \"\"\"Test that event filter is installed on scroll_area.\"\"\"\n    94\t        window = mock_caption_window([], 0)\n    95\t\n    96\t        # Verify event filter was installed on scroll_area\n    97\t        window.scroll_area.installEventFilter.assert_called_once_with(window)\n    98\t\n    99\t    def test_init_finds_main_window_when_parent_none(self, mock_caption_window):\n   100\t        \"\"\"Test that find_main_window is called when parent is None.\"\"\"\n   101\t        with patch('caption_window.find_main_window') as mock_find_main:\n   102\t            mock_main_window = MagicMock()\n   103\t            mock_find_main.return_value = mock_main_window\n   104\t\n   105\t            window = mock_caption_window([], 0, None)\n   106\t\n   107\t            mock_find_main.assert_called_once()\n   108\t            assert window.parent_app == mock_main_window\n   109\t\n   110\t    def test_init_uses_provided_parent(self, mock_caption_window):\n   111\t        \"\"\"Test that provided parent is used when available.\"\"\"\n   112\t        from PySide6.QtWidgets import QWidget\n   113\t        # Must use 