ombo is not None\n    33\t        assert window.backend_status is not None\n    34\t\n    35\t    def test_setup_ui_creates_backend_combo(self):\n    36\t        \"\"\"Test that _setup_ui creates backend combo with correct items.\"\"\"\n    37\t        window = CaptionWindow([], 0)\n    38\t        assert isinstance(window.backend_combo, QComboBox)\n    39\t        assert window.backend_combo.count() == 3\n    40\t        assert window.backend_combo.itemText(0) == \"Florence2 (Local)\"\n    41\t        assert window.backend_combo.itemText(1) == \"WD14 Tagger (Local)\"\n    42\t        assert window.backend_combo.itemText(2) == \"Ollama (Server)\"\n    43\t\n    44\t    def test_setup_ui_creates_florence_widget_hidden(self):\n    45\t        \"\"\"Test that florence_widget is visible initially (not hidden).\"\"\"\n    46\t        window = CaptionWindow([], 0)\n    47\t        assert window.florence_widget is not None\n    48\t        assert not window.florence_widget.isHidden()\n    49\t\n    50\t    def test_setup_ui_creates_ollama_widget_hidden(self):\n    51\t        \"\"\"Test that ollama_widget is hidden initially.\"\"\"\n    52\t        window = CaptionWindow([], 0)\n    53\t        assert window.ollama_widget is not None\n    54\t        assert window.ollama_widget.isHidden()\n    55\t\n    56\t    def test_setup_ui_crees_wd14_widget_hidden(self):\n    57\t        \"\"\"Test that wd14_widget is hidden initially.\"\"\"\n    58\t        window = CaptionWindow([], 0)\n    59\t        assert window.wd14_widget is not None\n    60\t        assert window.wd14_widget.isHidden()\n    61\t\n    62\t    def test_setup_ui_creates_generated_caption_group(self):\n    63\t        \"\"\"Test that generated caption group contains text area and button.\"\"\"\n    64\t        window = CaptionWindow([], 0)\n    65\t        assert window.generated_caption_text is not None\n    66\t        assert window.generate_btn is not None\n    67\t        assert window.progress_label is not None\n    68\t\n    69\t    def test_setup_ui_creates_actions_group(self):\n    70\t        \"\"\"Test that actions group contains replace, append, and blend buttons.\"\"\"\n    71\t        window = CaptionWindow([], 0)\n    72\t        assert window.replace_btn is not None\n    73\t        assert window.append_btn is not None\n    74\t        assert window.blend_btn is not None\n    75\t        assert window.blend_model_combo is not None\n    76\t        assert window.blend_instructions is not None\n    77\t\n    78\t    def test_setup_ui_creates_saved_caption_group(self):\n    79\t        \"\"\"Test that saved caption group contains text area and save button.\"\"\"\n    80\t        window = CaptionWindow([], 0)\n    81\t        assert window.saved_caption_text is not None\n    82\t        assert window.save_btn is not None\n    83\t\n    84\t    def test_setup_ui_sets_splitter_sizes(self):\n    85\t        \"\"\"Test that splitter has correct initial sizes.\"\"\"\n    86\t        window = CaptionWindow([], 0)\n    87\t        sizes = window.splitter.sizes()\n    88\t        assert len(sizes) == 2\n    89\t        # The exact sizes might vary, but we should have two non-zero values\n    90\t        assert sizes[0] > 0\n    91\t        assert sizes[1] > 0\n    92\t\n    93\t    def test_setup_ui_creates_status_bar(self):\n    94\t        \"\"\"Test that status bar is created with zoom label.\"\"\"\n    95\t        window = CaptionWindow([], 0)\n    96\t        assert isinstance(window.status_bar, QStatusBar)\n    97\t        assert window.zoom_label is not None\n    98\t        # Check that zoom_label is in status bar\n    99\t        assert window.status_bar.children().count(window.zoom_label) > 0\n   100\t\n   101\t    def test_setup_ui_connects_signals(self):\n   102\t        \"\"\"Test that backend combo signal is connected to handler.\"\"\"\n   103\t        window = CaptionWindow([], 0)\n   104\t        # Verify the connection exists by checking that the signal