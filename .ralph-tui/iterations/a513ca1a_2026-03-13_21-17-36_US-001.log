{"type":"tool_use","timestamp":1773397355932,"sessionID":"ses_c9e942dfe9f6","part":{"type":"tool","callID":"call_05ud1icg","tool":"read","state":{"status":"completed","input":{"file_path":"tests/unit/test_autocaption_dialog_AutoCaptionDialog___init__.py"},"output":"     1\t\"\"\"Tests for AutoCaptionDialog.__init__ method.\"\"\"\n     2\t\n     3\tfrom unittest.mock import patch, MagicMock\n     4\tfrom autocaption_dialog import AutoCaptionDialog\n     5\t\n     6\t\n     7\tclass TestAutoCaptionDialogInit:\n     8\t    \"\"\"Test suite for AutoCaptionDialog.__init__ initialization and setup.\"\"\"\n     9\t\n    10\t    def test_init_sets_image_paths(self):\n    11\t        \"\"\"Test that __init__ sets image_paths correctly.\"\"\"\n    12\t        image_paths = [\"path1.jpg\", \"path2.jpg\"]\n    13\t        with patch(\"autocaption_dialog.get_caption_generator\"):\n    14\t            dialog = AutoCaptionDialog(image_paths)\n    15\t            assert dialog.image_paths == image_paths\n    16\t\n    17\t    def test_init_sets_generator(self):\n    18\t        \"\"\"Test that __init__ sets generator (not None).\"\"\"\n    19\t        with patch(\"autocaption_dialog.get_caption_generator\") as mock_gen:\n    20\t            mock_gen.return_value = MagicMock()\n    21\t            dialog = AutoCaptionDialog([\"path1.jpg\"])\n    22\t            assert dialog.generator is not None\n    23\t\n    24\t    def test_init_sets_initial_state(self):\n    25\t        \"\"\"Test that __init__ sets initial state correctly.\"\"\"\n    26\t        with patch(\"autocaption_dialog.get_caption_generator\"):\n    27\t            dialog = AutoCaptionDialog([\"path1.jpg\"])\n    28\t            assert dialog.caption_worker is None\n    29\t            assert dialog.current_index == 0\n    30\t            assert dialog.results == []\n    31\t\n    32\t    def test_init_sets_window_title(self):\n    33\t        \"\"\"Test that __init__ sets window title correctly.\"\"\"\n    34\t        image_paths = [\"path1.jpg\", \"path2.jpg\", \"path3.jpg\"]\n    35\t        with patch(\"autocaption_dialog.get_caption_generator\"):\n    36\t            dialog = AutoCaptionDialog(image_paths)\n    37\t            assert dialog.windowTitle() == \"Auto Caption - 3 image(s)\"\n    38\t\n    39\t    def test_init_sets_minimum_width(self):\n    40\t        \"\"\"Test that __init__ sets minimum width correctly.\"\"\"\n    41\t        with patch(\"autocaption_dialog.get_caption_generator\"):\n    42\t            dialog = AutoCaptionDialog([\"path1.jpg\"])\n    43\t            assert dialog.minimumWidth() == 450\n    44\t\n    45\t    def test_init_sets_modal(self):\n    46\t        \"\"\"Test that __init__ sets window as modal.\"\"\"\n    47\t        with patch(\"autocaption_dialog.get_caption_generator\"):\n    48\t            dialog = AutoCaptionDialog([\"path1.jpg\"])\n    49\t            assert dialog.isModal()\n    50\t\n    51\t    def test_init_calls_setup_ui(self):\n    52\t        \"\"\"Test that __init__ calls _setup_ui method.\"\"\"\n    53\t        with patch(\"autocaption_dialog.get_caption_generator\"):\n    54\t            with patch.object(AutoCaptionDialog, \"_setup_ui\"):\n    55\t                with patch.object(AutoCaptionDialog, \"_load_settings\"):\n    56\t                    AutoCaptionDialog([\"path1.jpg\"])\n    57\t                    AutoCaptionDialog._setup_ui.assert_called_once()\n    58\t\n    59\t    def test_init_calls_load_settings(self):\n    60\t        \"\"\"Test that __init__ calls _load_settings method.\"\"\"\n    61\t        with patch(\"autocaption_dialog.get_caption_generator\"):\n    62\t            with patch.object(AutoCaptionDialog, \"_setup_ui\"):\n    63\t                with patch.object(AutoCaptionDialog, \"_load_settings\") as mock_load:\n    64\t                    AutoCaptionDialog([\"path1.jpg\"])\n    65\t                    mock_load.assert_called_once()","time":{"start":1773397355932,"end":1773397355932}}}}
