{"type":"tool_use","timestamp":1773397701978,"sessionID":"ses_c9e942dfe9f6","part":{"type":"tool","callID":"call_x02x9dl6","tool":"write","state":{"status":"completed","input":{"content":"\"\"\"Tests for CaptionWindow.__init__ method.\"\"\"\n\nfrom unittest.mock import patch, MagicMock\nfrom PyQt6.QtCore import Qt\n\n\nclass TestCaptionWindowInit:\n    \"\"\"Test suite for CaptionWindow.__init__ initialization and setup.\"\"\"\n\n    def test_init_sets_image_list_and_index(self):\n        \"\"\"Test that __init__ sets image_list and current_index correctly.\"\"\"\n        image_list = ['a.jpg', 'b.jpg']\n        current_index = 1\n        with patch('caption_window.find_main_window'):\n            with patch('caption_window.get_caption_generator'):\n                from caption_window import CaptionWindow\n                window = CaptionWindow(image_list, current_index)\n                assert window.image_list == image_list\n                assert window.current_index == current_index\n\n    def test_init_sets_default_zoom_factor(self):\n        \"\"\"Test that __init__ sets default zoom_factor to 1.0.\"\"\"\n        with patch('caption_window.find_main_window'):\n            with patch('caption_window.get_caption_generator'):\n                from caption_window import CaptionWindow\n                window = CaptionWindow(['a.jpg'], 0)\n                assert window.zoom_factor == 1.0\n\n    def test_init_sets_default_fit_to_window(self):\n        \"\"\"Test that __init__ sets default fit_to_window to True.\"\"\"\n        with patch('caption_window.find_main_window'):\n            with patch('caption_window.get_caption_generator'):\n                from caption_window import CaptionWindow\n                window = CaptionWindow(['a.jpg'], 0)\n                assert window.fit_to_window == True\n\n    def test_init_sets_default_has_unsaved_changes(self):\n        \"\"\"Test that __init__ sets default has_unsaved_changes to False.\"\"\"\n        with patch('caption_window.find_main_window'):\n            with patch('caption_window.get_caption_generator'):\n                from caption_window import CaptionWindow\n                window = CaptionWindow(['a.jpg'], 0)\n                assert window.has_unsaved_changes == False\n\n    def test_init_sets_default_current_caption_path(self):\n        \"\"\"Test that __init__ sets default current_caption_path to None.\"\"\"\n        with patch('caption_window.find_main_window'):\n            with patch('caption_window.get_caption_generator'):\n                from caption_window import CaptionWindow\n                window = CaptionWindow(['a.jpg'], 0)\n                assert window.current_caption_path is None\n\n    def test_init_sets_default_workers(self):\n        \"\"\"Test that __init__ sets default workers to None.\"\"\"\n        with patch('caption_window.find_main_window'):\n            with patch('caption_window.get_caption_generator'):\n                from caption_window import CaptionWindow\n                window = CaptionWindow(['a.jpg'], 0)\n                assert window.caption_worker is None\n                assert window.blend_worker is None\n\n    def test_init_sets_default_undo_redo_stacks(self):\n        \"\"\"Test that __init__ sets default undo/redo stacks to empty lists.\"\"\"\n        with patch('caption_window.find_main_window'):\n            with patch('caption_window.get_caption_generator'):\n                from caption_window import CaptionWindow\n                window = CaptionWindow(['a.jpg'], 0)\n                assert window._generated_undo_stack == []\n                assert window._generated_redo_stack == []\n\n    def test_init_sets_default_initialized_flag(self):\n        \"\"\"Test that __init__ sets default _initialized flag to False.\"\"\"\n        with patch('caption_window.find_main_window'):\n            with patch('caption_window.get_caption_generator'):\n                from caption_window import CaptionWindow\n                window = CaptionWindow(['a.jpg'], 0)\n                assert window._initialized == False\n\n    def test_init_sets_default_maximize_attempts(self):\n        \"\"\"Test that __init__ sets default _maximize_attempts to 0.\"\"\"\n        with patch('caption_window.find_main_window'):\n            with patch('caption_window.get_caption_generator'):\n                from caption_window import CaptionWindow\n                window = CaptionWindow(['a.jpg'], 0)\n                assert window._maximize_attempts == 0\n\n    def test_init_sets_window_title(self):\n        \"\"\"Test that __init__ sets the window title correctly.\"\"\"\n        with patch('caption_window.find_main_window'):\n            with patch('caption_window.get_caption_generator'):\n                from caption_window import CaptionWindow\n                window = CaptionWindow(['a.jpg'], 0)\n                assert window.windowTitle() == 'Auto Caption Tool'\n\n    def test_init_calls_setup_methods(self):\n        \"\"\"Test that __init__ calls setup methods.\"\"\"\n        with patch('caption_window.find_main_window'):\n            with patch('caption_window.get_caption_generator'):\n                from caption_window import CaptionWindow\n                with patch.object(CaptionWindow, '_setup_ui') as mock_setup_ui:\n                    with patch.object(CaptionWindow, '_setup_menu') as mock_setup_menu:\n                        with patch.object(CaptionWindow, '_setup_shortcuts') as mock_setup_shortcuts:\n                            with patch.object(CaptionWindow, '_load_settings') as mock_load_settings:\n                                window = CaptionWindow(['a.jpg'], 0)\n                                mock_setup_ui.assert_called_once()\n                                mock_setup_menu.assert_called_once()\n                                mock_setup_shortcuts.assert_called_once()\n                                mock_load_settings.assert_called_once()\n\n    def test_init_sets_focus_policy(self):\n        \"\"\"Test that __init__ sets focus policy to StrongFocus.\"\"\"\n        with patch('caption_window.find_main_window'):\n            with patch('caption_window.get_caption_generator'):\n                from caption_window import CaptionWindow\n                window = CaptionWindow(['a.jpg'], 0)\n                assert window.focusPolicy() == Qt.FocusPolicy.StrongFocus\n\n    def test_init_installs_event_filter(self):\n        \"\"\"Test that __init__ installs event filter on scroll_area.\"\"\"\n        with patch('caption_window.find_main_window'):\n            with patch('caption_window.get_caption_generator'):\n                from caption_window import CaptionWindow\n                window = CaptionWindow(['a.jpg'], 0)\n                # Verify that scroll_area exists and has installEventFilter method\n                assert hasattr(window, 'scroll_area')\n                assert hasattr(window.scroll_area, 'installEventFilter')\n","file_path":"tests/unit/test_caption_window_CaptionWindow___init__.py"},"output":"Wrote 6545 bytes to tests/unit/test_caption_window_CaptionWindow___init__.py","time":{"start":1773397701978,"end":1773397701978}}}}
