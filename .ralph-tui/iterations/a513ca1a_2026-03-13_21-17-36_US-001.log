{"type":"tool_use","timestamp":1773397324762,"sessionID":"ses_c9e942dfe9f6","part":{"type":"tool","callID":"call_789w85n8","tool":"write","state":{"status":"completed","input":{"file_path":"tests/unit/test_caption_window_CaptionWindow___init__.py","content":"\"\"\"Tests for CaptionWindow.__init__ method.\"\"\"\n\nimport pytest\nfrom unittest.mock import MagicMock, patch\nfrom PyQt6.QtWidgets import QApplication\nfrom PyQt6.QtCore import Qt\n\n\nclass TestCaptionWindowInit:\n    \"\"\"Test suite for CaptionWindow.__init__ initialization and setup.\"\"\"\n\n    @pytest.fixture\n    def mock_caption_window(self):\n        \"\"\"Create a mock CaptionWindow for testing.\"\"\"\n        with patch('caption_window.find_main_window') as mock_find_main:\n            with patch('caption_window.get_caption_generator') as mock_generator:\n                with patch('caption_window.QPixmap') as mock_pixmap:\n                    mock_instance = MagicMock()\n                    mock_instance.parent_app = None\n                    mock_instance.scroll_area = MagicMock()\n                    \n                    # Mock the super().__init__ call\n                    mock_instance.__class__.__bases__ = (object,)\n                    \n                    # Create the actual CaptionWindow instance\n                    from caption_window import CaptionWindow\n                    window = CaptionWindow(['a.jpg', 'b.jpg'], 1)\n                    \n                    return window\n\n    def test_init_sets_image_list_and_index(self, mock_caption_window):\n        \"\"\"Test that __init__ sets image_list and current_index correctly.\"\"\"\n        assert mock_caption_window.image_list == ['a.jpg', 'b.jpg']\n        assert mock_caption_window.current_index == 1\n\n    def test_init_sets_default_zoom_factor(self, mock_caption_window):\n        \"\"\"Test that __init__ sets default zoom_factor to 1.0.\"\"\"\n        assert mock_caption_window.zoom_factor == 1.0\n\n    def test_init_sets_default_fit_to_window(self, mock_caption_window):\n        \"\"\"Test that __init__ sets default fit_to_window to True.\"\"\"\n        assert mock_caption_window.fit_to_window == True\n\n    def test_init_sets_default_has_unsaved_changes(self, mock_caption_window):\n        \"\"\"Test that __init__ sets default has_unsaved_changes to False.\"\"\"\n        assert mock_caption_window.has_unsaved_changes == False\n\n    def test_init_sets_default_current_caption_path(self, mock_caption_window):\n        \"\"\"Test that __init__ sets default current_caption_path to None.\"\"\"\n        assert mock_caption_window.current_caption_path is None\n\n    def test_init_sets_default_workers(self, mock_caption_window):\n        \"\"\"Test that __init__ sets default workers to None.\"\"\"\n        assert mock_caption_window.caption_worker is None\n        assert mock_caption_window.blend_worker is None\n\n    def test_init_sets_default_undo_redo_stacks(self, mock_caption_window):\n        \"\"\"Test that __init__ sets default undo/redo stacks to empty lists.\"\"\"\n        assert mock_caption_window._generated_undo_stack == []\n        assert mock_caption_window._generated_redo_stack == []\n\n    def test_init_sets_default_initialized_flag(self, mock_caption_window):\n        \"\"\"Test that __init__ sets default _initialized flag to False.\"\"\"\n        assert mock_caption_window._initialized == False\n\n    def test_init_sets_default_maximize_attempts(self, mock_caption_window):\n        \"\"\"Test that __init__ sets default _maximize_attempts to 0.\"\"\"\n        assert mock_caption_window._maximize_attempts == 0\n\n    def test_init_sets_window_title(self, mock_caption_window):\n        \"\"\"Test that __init__ sets the window title correctly.\"\"\"\n        assert mock_caption_window.windowTitle() == 'Auto Caption Tool'\n\n    def test_init_calls_setup_methods(self, mock_caption_window):\n        \"\"\"Test that __init__ calls setup methods.\"\"\"\n        # Verify that setup methods were called\n        assert mock_caption_window._setup_ui.called\n        assert mock_caption_window._setup_menu.called\n        assert mock_caption_window._setup_shortcuts.called\n        assert mock_caption_window._load_settings.called\n\n    def test_init_sets_focus_policy(self, mock_caption_window):\n        \"\"\"Test that __init__ sets focus policy to StrongFocus.\"\"\"\n        assert mock_caption_window.focusPolicy() == Qt.FocusPolicy.StrongFocus\n\n    def test_init_installs_event_filter(self, mock_caption_window):\n        \"\"\"Test that __init__ installs event filter on scroll_area.\"\"\"\n        # Verify that installEventFilter was called with self\n        mock_caption_window.scroll_area.installEventFilter.assert_called_once_with(mock_caption_window)\n"},"output":"Wrote 4340 bytes to tests/unit/test_caption_window_CaptionWindow___init__.py","time":{"start":1773397324762,"end":1773397324762}}}}
