{"type":"tool_use","timestamp":1772949073968,"sessionID":"ses_224a573428bc","part":{"type":"tool","callID":"call_mywivn7w","tool":"read","state":{"status":"completed","input":{"file_path":"autocaption_dialog.py","offset":363},"output":"   363\t        # Move to next\n   364\t        self.current_index += 1\n   365\t        self.progress_bar.setValue(self.current_index)\n   366\t        QTimer.singleShot(10, self._process_next_image)\n   367\t\n   368\t    def _cancel_generation(self):\n   369\t        \"\"\"Cancel the current generation.\"\"\"\n   370\t        if self.caption_worker:\n   371\t            self.caption_worker.wait()\n   372\t            self.caption_worker.deleteLater()\n   373\t            self.caption_worker = None\n   374\t\n   375\t        self._finish_generation(cancelled=True)\n   376\t\n   377\t    def _finish_generation(self, cancelled=False):\n   378\t        \"\"\"Finish the generation process and show results.\"\"\"\n   379\t        # Re-enable UI\n   380\t        self.generate_btn.setEnabled(True)\n   381\t        self.cancel_btn.setEnabled(False)\n   382\t        self.close_btn.setEnabled(True)\n   383\t        self.backend_combo.setEnabled(True)\n   384\t\n   385\t        # Count results\n   386\t        success_count = sum(1 for _, _, status in self.results if status == \"success\")\n   387\t        skip_count = sum(1 for _, _, status in self.results if status == \"skipped\")\n   388\t        error_count = sum(\n   389\t            1 for _, _, status in self.results if status.startswith(\"error\")\n   390\t        )\n   391\t\n   392\t        if cancelled:\n   393\t            self.progress_label.setText(\n   394\t                f\"Cancelled. {success_count} completed, {len(self.image_paths) - self.current_index} remaining.\"\n   395\t            )\n   396\t        else:\n   397\t            self.progress_label.setText(\n   398\t                f\"Done! {success_count} generated, {skip_count} skipped, {error_count} errors.\"\n   399\t            )\n   400\t\n   401\t        # Show summary if there were errors\n   402\t        if error_count > 0:\n   403\t            errors = [\n   404\t                f\"- {os.path.basename(p)}: {s}\"\n   405\t                for p, _, s in self.results\n   406\t                if s.startswith(\"error\")\n   407\t            ]\n   408\t            error_text = \"\\n\".join(errors[:10])\n   409\t            if error_count > 10:\n   410\t                error_text += f\"\\n... and {error_count - 10} more\"\n   411\t\n   412\t            QMessageBox.warning(\n   413\t                self,\n   414\t                \"Some Errors Occurred\",\n   415\t                f\"{error_count} image(s) failed to generate captions:\\n\\n{error_text}\",\n   416\t            )\n   417\t\n   418\t    def closeEvent(self, event):\n   419\t        \"\"\"Handle dialog close.\"\"\"\n   420\t        if self.caption_worker:\n   421\t            self.caption_worker.wait()\n   422\t            self.caption_worker.deleteLater()\n   423\t            self.caption_worker = None\n   424\t        event.accept()","time":{"start":1772949073968,"end":1772949073968}}}}
