caption_gen = CaptionGenerator()\n        \n        # Mock the ONNX model\n        mock_model = MagicMock()\n        mock_input = MagicMock()\n        mock_input.name = \"test_input\"\n        mock_model.get_inputs.return_value = [mock_input]\n        mock_model.run.return_value = [np.random.randn(1, 425).astype(np.float32)]\n        caption_gen.wd14_model = mock_model\n        \n        # Create a PIL Image\n        image = Image.new('RGB', (224, 224), color='red')\n        \n        # Call the method\n        result = caption_gen._generate_wd14_onnx(image)\n        \n        # Assert the result\n        assert isinstance(result, np.ndarray)\n        assert result.shape == (425,)"},"output":"Edited tests/unit/test_caption_generator_CaptionGenerator__generate_wd14_onnx.py: replaced 1 occurrence","time":{"start":1773363273286,"end":1773363273286}}}}
