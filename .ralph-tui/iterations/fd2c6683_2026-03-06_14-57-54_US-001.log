{"type":"tool_use","timestamp":1772770778691,"sessionID":"ses_be79a7a85b83","part":{"type":"tool","callID":"call_fsj6qbl3","tool":"read","state":{"status":"completed","input":{"file_path":"tests/unit/test_autocaption_dialog_AutoCaptionDialog__setup_ui.py"},"output":"     1\t\"\"\"Tests for AutoCaptionDialog._setup_ui method.\"\"\"\n     2\timport pytest\n     3\tfrom PySide6.QtWidgets import (\n     4\t    QVBoxLayout, QGroupBox, QProgressBar,\n     5\t    QLabel, QPushButton\n     6\t)\n     7\tfrom autocaption_dialog import AutoCaptionDialog\n     8\t\n     9\t\n    10\tclass TestAutoCaptionDialogSetupUi:\n    11\t    \"\"\"Test suite for AutoCaptionDialog._setup_ui method.\"\"\"\n    12\t\n    13\t    @pytest.fixture\n    14\t    def dialog(self):\n    15\t        \"\"\"Create a test AutoCaptionDialog instance.\"\"\"\n    16\t        mock_image_paths = [\"image1.jpg\", \"image2.jpg\"]\n    17\t        dialog = AutoCaptionDialog(mock_image_paths)\n    18\t        dialog._setup_ui()\n    19\t        return dialog\n    20\t\n    21\t    def test_setup_ui_creates_main_layout(self, dialog):\n    22\t        \"\"\"Test that _setup_ui creates a QVBoxLayout as main layout.\"\"\"\n    23\t        layout = dialog.layout()\n    24\t        assert isinstance(layout, QVBoxLayout), (\n    25\t            \"Main layout should be QVBoxLayout\"\n    26\t        )\n    27\t\n    28\t    def test_setup_ui_creates_backend_group(self, dialog):\n    29\t        \"\"\"Test that backend_group exists and is a QGroupBox with correct title.\"\"\"\n    30\t        # Find the backend group by iterating through the layout\n    31\t        backend_group = None\n    32\t        layout = dialog.layout()\n    33\t        for i in range(layout.count()):\n    34\t            widget = layout.itemAt(i).widget()\n    35\t            if isinstance(widget, QGroupBox) and widget.title() == \"Caption Backend\":\n    36\t                backend_group = widget\n    37\t                break\n    38\t\n    39\t        assert backend_group is not None, \"backend_group should exist\"\n    40\t        assert backend_group.title() == \"Caption Backend\", (\n    41\t            \"backend_group should have correct title\"\n    42\t        )\n    43\t\n    44\t    def test_setup_ui_creates_backend_combo_box(self, dialog):\n    45\t        \"\"\"Test that backend_combo exists and has 3 items with correct data.\"\"\"\n    46\t        backend_combo = dialog.backend_combo\n    47\t        assert backend_combo is not None, \"backend_combo should exist\"\n    48\t        assert backend_combo.count() == 3, \"backend_combo should have 3 items\"\n    49\t\n    50\t        # Check item data\n    51\t        assert backend_combo.itemData(0) == \"florence2\", \"First item should be florence2\"\n    52\t        assert backend_combo.itemData(1) == \"wd14\", \"Second item should be wd14\"\n    53\t        assert backend_combo.itemData(2) == \"ollama\", \"Third item should be ollama\"\n    54\t\n    55\t    def test_setup_ui_creates_florence_widget_hidden(self, dialog):\n    56\t        \"\"\"Test that florence_widget exists, is a QGroupBox, and is initially hidden.\"\"\"\n    57\t        florence_widget = dialog.florence_widget\n    58\t        assert florence_widget is not None, \"florence_widget should exist\"\n    59\t        assert isinstance(florence_widget, QGroupBox), \"florence_widget should be QGroupBox\"\n    60\t        # Note: florence_widget is not hidden by default in the implementation\n    61\t\n    62\t    def test_setup_ui_creates_wd14_widget_hidden(self, dialog):\n    63\t        \"\"\"Test that wd14_widget exists, is a QGroupBox, and is initially hidden.\"\"\"\n    64\t        wd14_widget = dialog.wd14_widget\n    65\t        assert wd14_widget is not None, \"wd14_widget should exist\"\n    66\t        assert isinstance(wd14_widget, QGroupBox), \"wd14_widget should be QGroupBox\"\n    67\t        assert wd14_widget.isHidden(), \"wd14_widget should be initially hidden\"\n    68\t\n    69\t    def test_setup_ui_creates_ollama_widget_hidden(self, dialog):\n    70\t        \"\"\"Test that ollama_widget exists, is a QGroupBox, and is initially hidden.\"\"\"\n    71\t        ollama_widget = dialog.ollama_widget\n    72\t        assert ollama_widget is not None, \"ollama_widget should exist\"\n    73\t        assert isinstance(ollama_widget, QGroupBox), \"ollama_widget should be QGroupBox\"\n    74\t        assert ollama_widget.isHidden(), \"ollama_widget should be initially hidden\"\n    75\t\n    76\t    def test_setup_ui_creates_progress_group(self, dialog):\n    77\t        \"\"\"Test that progress_group exists and contains QProgressBar and QLabel.\"\"\"\n    78\t        progress_group = dialog.progress_group\n    79\t        assert progress_group is not None, \"progress_group should exist\"\n    80\t\n    81\t        progress_bar = dialog.progress_bar\n    82\t        assert progress_bar is not None, \"progress_bar should exist\"\n    83\t        assert isinstance(progress_bar, QProgressBar), \"progress_bar should be QProgressBar\"\n    84\t\n    85\t        progress_label = dialog.progress_label\n    86\t        assert progress_label is not None, \"progress_label should exist\"\n    87\t        assert isinstance(progress_label, QLabel), \"progress_label should be QLabel\"\n    88\t\n    89\t    def test_setup_ui_creates_buttons(self, dialog):\n    90\t        \"\"\"Test that generate_btn, cancel_btn, and close_btn exist and are QPushButton instances.\"\"\"\n    91\t        generate_btn = dialog.generate_btn\n    92\t        assert generate_btn is not None, \"generate_btn should exist\"\n    93\t        assert isinstance(generate_btn, QPushButton), \"generate_btn should be QPushButton\"\n    94\t\n    95\t        cancel_btn = dialog.cancel_btn\n    96\t        assert cancel_btn is not None, \"cancel_btn should exist\"\n    97\t        assert isinstance(cancel_btn, QPushButton), \"cancel_btn should be QPushButton\"\n    98\t\n    99\t