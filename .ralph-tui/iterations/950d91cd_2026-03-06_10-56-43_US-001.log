{"type":"tool_use","timestamp":1772755183645,"sessionID":"ses_645afa4faf21","part":{"type":"tool","callID":"call_qrdmhq0x","tool":"write","state":{"status":"completed","input":{"file_path":"tests/unit/test_advanced_filter_dialog_AdvancedFilterDialog_browse_custom_model.py","content":"\"\"\"Tests for AdvancedFilterDialog.browse_custom_model method.\"\"\"\n\nimport pytest\nfrom unittest.mock import patch, MagicMock\nfrom advanced_filter_dialog import AdvancedFilterDialog\n\n\nclass TestAdvancedFilterDialogBrowseCustomModel:\n    \"\"\"Test suite for AdvancedFilterDialog.browse_custom_model method.\"\"\"\n\n    @pytest.fixture\n    def dialog(self):\n        \"\"\"Create an AdvancedFilterDialog instance.\"\"\"\n        return AdvancedFilterDialog(parent=None)\n\n    @pytest.fixture\n    def mock_qfile_dialog(self):\n        \"\"\"Mock QFileDialog.getOpenFileName.\"\"\"\n        with patch('advanced_filter_dialog.QFileDialog.getOpenFileName') as mock:\n            yield mock\n\n    def test_browse_custom_model_updates_path_edit(\n        self, dialog, mock_qfile_dialog\n    ):\n        \"\"\"Test that browse_custom_model updates custom_model_path_edit with selected file.\"\"\"\n        mock_qfile_dialog.return_value = (\n            '/path/to/model.pt',\n            'YOLO Models (*.pt *.pth *.safetensors *.weights *.onnx)'\n        )\n        dialog.browse_custom_model()\n        assert dialog.custom_model_path_edit.text() == '/path/to/model.pt'\n\n    def test_browse_custom_model_with_empty_path(\n        self, dialog, mock_qfile_dialog\n    ):\n        \"\"\"Test that browse_custom_model handles empty path correctly.\"\"\"\n        mock_qfile_dialog.return_value = ('', '')\n        dialog.browse_custom_model()\n        assert dialog.custom_model_path_edit.text() == ''\n\n    def test_browse_custom_model_with_different_file_types(\n        self, dialog, mock_qfile_dialog\n    ):\n        \"\"\"Test that browse_custom_model works with different YOLO model file types.\"\"\"\n        mock_qfile_dialog.return_value = (\n            '/path/to/model.onnx',\n            'YOLO Models (*.pt *.pth *.safetensors *.weights *.onnx)'\n        )\n        dialog.browse_custom_model()\n        assert dialog.custom_model_path_edit.text() == '/path/to/model.onnx'\n\n    def test_browse_custom_model_with_all_files_filter(\n        self, dialog, mock_qfile_dialog\n    ):\n        \"\"\"Test that browse_custom_model works with All Files filter.\"\"\"\n        mock_qfile_dialog.return_value = (\n            '/path/to/model.weights',\n            'All Files (*)'\n        )\n        dialog.browse_custom_model()\n        assert dialog.custom_model_path_edit.text() == '/path/to/model.weights'\n\n    def test_browse_custom_model_updates_filter_settings(\n        self, dialog, mock_qfile_dialog\n    ):\n        \"\"\"Test that browse_custom_model updates filter_settings with custom model path.\"\"\"\n        mock_qfile_dialog.return_value = (\n            '/path/to/model.pt',\n            'YOLO Models (*.pt *.pth *.safetensors *.weights *.onnx)'\n        )\n        dialog.browse_custom_model()\n        assert dialog.filter_settings['custom_model_path'] == '/path/to/model.pt'\n\n    def test_browse_custom_model_with_no_selection(\n        self, dialog, mock_qfile_dialog\n    ):\n        \"\"\"Test that browse_custom_model handles no selection correctly.\"\"\"\n        mock_qfile_dialog.return_value = ('', '')\n        dialog.browse_custom_model()\n        assert dialog.filter_settings['custom_model_path'] is None\n\n    def test_browse_custom_model_with_invalid_path(\n        self, dialog, mock_qfile_dialog\n    ):\n        \"\"\"Test that browse_custom_model accepts invalid paths without validation.\"\"\"\n        mock_qfile_dialog.return_value = (\n            '/invalid/path/model.pt',\n            'YOLO Models (*.pt *.pth *.safetensors *.weights *.onnx)'\n        )\n        dialog.browse_custom_model()\n        assert dialog.custom_model_path_edit.text() == '/invalid/path/model.pt'\n"},"output":"Wrote 3586 bytes to tests/unit/test_advanced_filter_dialog_AdvancedFilterDialog_browse_custom_model.py","time":{"start":1772755183645,"end":1772755183645}}}}
