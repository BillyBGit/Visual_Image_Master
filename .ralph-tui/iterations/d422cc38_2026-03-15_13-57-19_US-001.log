{"type":"tool_use","timestamp":1773544738891,"sessionID":"ses_8d623da67e0e","part":{"type":"tool","callID":"call_8e9jcrem","tool":"write","state":{"status":"completed","input":{"content":"\"\"\"Tests for CaptionWindow._setup_menu method.\"\"\"\n\nfrom PySide6.QtWidgets import QMenuBar, QMenu\nfrom PySide6.QtGui import QAction\nfrom caption_window import CaptionWindow\n\n\nclass TestCaptionWindowSetupMenu:\n    \"\"\"Test suite for CaptionWindow._setup_menu method.\"\"\"\n\n    def test_menu_bar_created(self):\n        \"\"\"Test that menuBar() returns a QMenuBar instance.\"\"\"\n        window = CaptionWindow([], 0)\n        menu_bar = window.menuBar()\n        assert isinstance(menu_bar, QMenuBar), \"menuBar() should return a QMenuBar instance\"\n\n    def test_options_menu_created(self):\n        \"\"\"Test that options menu is created in the menu bar.\"\"\"\n        window = CaptionWindow([], 0)\n        menu_bar = window.menuBar()\n        # Find the Options menu by checking all children\n        options_menu = None\n        for child in menu_bar.children():\n            if isinstance(child, QMenu) and child.title() == '&Options':\n                options_menu = child\n                break\n        assert options_menu is not None, \"Should have an '&Options' menu\"\n\n    def test_fit_to_window_action_created(self):\n        \"\"\"Test that fit to window action is created correctly.\"\"\"\n        window = CaptionWindow([], 0)\n        assert window.fit_act is not None, \"fit_act should be created\"\n        assert isinstance(window.fit_act, QAction), \"fit_act should be a QAction\"\n        assert window.fit_act.text() == '&Fit to Window', \"Action text should be '&Fit to Window'\"\n        assert window.fit_act.isCheckable(), \"Action should be checkable\"\n        assert window.fit_act.isChecked() == window.fit_to_window, \"Checked state should match fit_to_window\"\n\n    def test_native_size_action_created(self):\n        \"\"\"Test that native size action is created correctly.\"\"\"\n        window = CaptionWindow([], 0)\n        assert window.native_act is not None, \"native_act should be created\"\n        assert isinstance(window.native_act, QAction), \"native_act should be a QAction\"\n        assert window.native_act.text() == '&Native Size', \"Action text should be '&Native Size'\"\n        assert window.native_act.isCheckable(), \"Action should be checkable\"\n        assert window.native_act.isChecked() == (not window.fit_to_window), \"Checked state should be opposite of fit_to_window\"\n\n    def test_fit_action_connected_to_toggle_fit_mode(self):\n        \"\"\"Test that fit action is connected to toggle_fit_mode method.\"\"\"\n        window = CaptionWindow([], 0)\n        # Verify the signal is connected by checking that the method exists\n        # and the signal is not None\n        assert window.fit_act.triggered is not None, \"fit_act should have a triggered signal\"\n        assert hasattr(window, 'toggle_fit_mode'), \"toggle_fit_mode method should exist\"\n        assert callable(window.toggle_fit_mode), \"toggle_fit_mode should be callable\"\n\n    def test_native_action_connected_to_set_native_size(self):\n        \"\"\"Test that native size action is connected to set_native_size method.\"\"\"\n        window = CaptionWindow([], 0)\n        # Verify the signal is connected by checking that the method exists\n        assert window.native_act.triggered is not None, \"native_act should have a triggered signal\"\n        assert hasattr(window, 'set_native_size'), \"set_native_size method should exist\"\n        assert callable(window.set_native_size), \"set_native_size should be callable\"\n\n    def test_actions_added_to_menu(self):\n        \"\"\"Test that actions are added to the options menu.\"\"\"\n        window = CaptionWindow([], 0)\n        menu_bar = window.menuBar()\n        # Find the Options menu by checking all children\n        options_menu = None\n        for child in menu_bar.children():\n            if isinstance(child, QMenu) and child.title() == '&Options':\n                options_menu = child\n                break\n        assert options_menu is not None, \"Should have an '&Options' menu\"\n        actions = options_menu.actions()\n        assert window.fit_act in actions, \"fit_act should be in options menu actions\"\n        assert window.native_act in actions, \"native_act should be in options menu actions\"\n","file_path":"tests/unit/test_caption_window_CaptionWindow__setup_menu.py"},"output":"Wrote 4083 bytes to tests/unit/test_caption_window_CaptionWindow__setup_menu.py","time":{"start":1773544738891,"end":1773544738891}}}}
