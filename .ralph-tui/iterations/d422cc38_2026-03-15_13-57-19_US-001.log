state\n    53\t        self.has_unsaved_changes = False\n    54\t        self.current_caption_path = None\n    55\t        self.caption_worker = None\n    56\t        self.blend_worker = None\n    57\t\n    58\t        # Undo/redo history for generated caption (stores previous states)\n    59\t        self._generated_undo_stack = []  # Stack of previous texts\n    60\t        self._generated_redo_stack = []  # Stack for redo\n    61\t\n    62\t        # Initialization flag - prevents re-initialization on subsequent show events\n    63\t        self._initialized = False\n    64\t        self._maximize_attempts = 0\n    65\t\n    66\t        # Caption generator (singleton)\n    67\t        self.generator = get_caption_generator()\n    68\t\n    69\t        # Set window title\n    70\t        self.setWindowTitle(\"Auto Caption Tool\")\n    71\t\n    72\t        # Setup UI\n    73\t        self._setup_ui()\n    74\t        self._setup_menu()\n    75\t        self._setup_shortcuts()\n    76\t        self._load_settings()\n    77\t\n    78\t        # Event configuration\n    79\t        self.setFocusPolicy(Qt.FocusPolicy.StrongFocus)\n    80\t        self.scroll_area.installEventFilter(self)\n    81\t\n    82\t    def _setup_ui(self):\n    83\t        \"\"\"Setup the main UI with splitter layout.\"\"\"\n    84\t        # Main splitter\n    85\t        self.splitter = QSplitter(Qt.Orientation.Horizontal)\n    86\t        self.setCentralWidget(self.splitter)\n    87\t\n    88\t        # Left side: Image display area\n    89\t        self.scroll_area = QScrollArea()\n    90\t        self.image_label = QLabel()\n    91\t        self.image_label.setAlignment(Qt.AlignmentFlag.AlignCenter)\n    92\t        self.scroll_area.setWidget(self.image_label)\n    93\t        self.scroll_area.setWidgetResizable(True)\n    94\t        self.splitter.addWidget(self.scroll_area)\n    95\t\n    96\t        # Right side: Caption panel\n    97\t        self.right_panel = QWidget()\n    98\t        self.right_panel_layout = QVBoxLayout(self.right_panel)\n    99\t        self.right_panel_layout.setContentsMargins(10, 10, 10, 10)\n   100\t        self.right_panel_layout.setSpacing(10)","time":{"start":1773544045508,"end":1773544045508}}}}
