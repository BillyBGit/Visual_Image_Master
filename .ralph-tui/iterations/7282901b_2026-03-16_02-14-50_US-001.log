the CaptionWindow instance.\"\"\"\n    39\t        window = CaptionWindow([], 0)\n    40\t\n    41\t        # Verify the shortcut's parent is the window\n    42\t        assert window.shortcut_save.parent() is window\n    43\t\n    44\t    def test_setup_shortcuts_save_shortcut_activated_signal(self):\n    45\t        \"\"\"Test that activating the shortcut calls _on_save_requested.\"\"\"\n    46\t        window = CaptionWindow([], 0)\n    47\t\n    48\t        # Mock the _on_save_requested method\n    49\t        with pytest.mock.patch.object(\n    50\t            window, '_on_save_requested'\n    51\t        ) as mock_save:\n    52\t            # Trigger the shortcut\n    53\t            window.shortcut_save.activated.emit()\n    54\t\n    55\t            # Verify _on_save_requested was called\n    56\t            mock_save.assert_called_once()\n    57\t\n    58\t    def test_setup_shortcuts_no_other_shortcuts(self):\n    59\t        \"\"\"Test that only self.shortcut_save is created and no other shortcuts exist.\"\"\"\n    60\t        window = CaptionWindow([], 0)\n    61\t\n    62\t        # Get all attributes that are QShortcut instances\n    63\t        shortcut_attrs = [\n    64\t            attr\n    65\t            for attr in dir(window)\n    66\t            if not attr.startswith('_')\n    67\t            and isinstance(getattr(window, attr, None), QShortcut)\n    68\t        ]\n    69\t\n    70\t        # Verify only shortcut_save exists\n    71\t        assert shortcut_attrs == ['shortcut_save']\n    72\t        assert hasattr(window, 'shortcut_save')","time":{"start":1773588907516,"end":1773588907516}}}}
