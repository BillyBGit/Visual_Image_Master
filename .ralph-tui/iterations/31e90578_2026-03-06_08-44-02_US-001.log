self.global_invert_cb.stateChanged.connect(self.update_filter_settings)\n    89\t        main_layout.addWidget(self.global_invert_cb)\n    90\t\n    91\t        # Buttons\n    92\t        button_layout = QHBoxLayout()\n    93\t        self.apply_btn = QPushButton(\"Apply Filters\")\n    94\t        self.apply_btn.clicked.connect(self.accept)\n    95\t        self.clear_btn = QPushButton(\"Clear All\")\n    96\t        self.clear_btn.clicked.connect(self.clear_all_filters)\n    97\t        self.cancel_btn = QPushButton(\"Cancel\")\n    98\t        self.cancel_btn.clicked.connect(self.reject)\n    99\t\n   100\t        button_layout.addWidget(self.clear_btn)\n   101\t        button_layout.addStretch()\n   102\t        button_layout.addWidget(self.cancel_btn)\n   103\t        button_layout.addWidget(self.apply_btn)\n   104\t\n   105\t        main_layout.addLayout(button_layout)\n   106\t        self.setLayout(main_layout)\n   107\t\n   108\t    def create_face_filter_section(self):\n   109\t        \"\"\"Create face detection filter section.\"\"\"\n   110\t        group = QGroupBox(\"Face Detection\")\n   111\t        layout = QVBoxLayout()\n   112\t\n   113\t        self.face_enable_cb = QCheckBox(\"Filter by faces\")\n   114\t        self.face_enable_cb.stateChanged.connect(self.update_filter_settings)\n   115\t        layout.addWidget(self.face_enable_cb)\n   116\t\n   117\t        # Contains/Does not contain\n   118\t        mode_layout = QHBoxLayout()\n   119\t        self.face_contains_rb = QRadioButton(\"Contains\")\n   120\t        self.face_contains_rb.setChecked(True)\n   121\t        self.face_contains_rb.toggled.connect(self.update_filter_settings)\n   122\t        self.face_not_contains_rb = QRadioButton(\"Does NOT contain\")\n   123\t        self.face_not_contains_rb.toggled.connect(self.update_filter_settings)\n   124\t        mode_layout.addWidget(self.face_contains_rb)\n   125\t        mode_layout.addWidget(self.face_not_contains_rb)\n   126\t        m