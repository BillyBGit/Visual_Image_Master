{"type":"tool_use","timestamp":1773260153741,"sessionID":"ses_adabcfb5d096","part":{"type":"tool","callID":"call_pa8uhju0","tool":"read","state":{"status":"completed","input":{"limit":100,"offset":671,"file_path":"caption_generator.py"},"output":"   671\t    def generate_ollama(\n   672\t        self, image_path: str, url: str, model: str, custom_prompt: str = None\n   673\t    ) -> str:\n   674\t        \"\"\"Generate caption using Ollama API.\n   675\t\n   676\t        Args:\n   677\t            image_path: Path to image file\n   678\t            url: Ollama API URL (e.g., http://localhost:11434)\n   679\t            model: Model name (e.g., llava, bakllava)\n   680\t            custom_prompt: Optional custom prompt (defaults to standard image description prompt)\n   681\t\n   682\t        Returns:\n   683\t            Generated caption string\n   684\t        \"\"\"\n   685\t        import urllib.request\n   686\t        import urllib.error\n   687\t\n   688\t        # Read and encode image\n   689\t        with open(image_path, \"rb\") as f:\n   690\t            image_data = base64.b64encode(f.read()).decode(\"utf-8\")\n   691\t\n   692\t        # Prepare request\n   693\t        api_url = f\"{url.rstrip('/')}/api/generate\"\n   694\t\n   695\t        # Use custom prompt if provided, otherwise use default\n   696\t        if custom_prompt is None:\n   697\t            custom_prompt = \"Describe this image in detail. Focus on the main subjects, actions, setting, and any notable details.\"\n   698\t\n   699\t        payload = {\n   700\t            \"model\": model,\n   701\t            \"prompt\": custom_prompt,\n   702\t            \"images\": [image_data],\n   703\t            \"stream\": False,\n   704\t        }\n   705\t\n   706\t        request = urllib.request.Request(\n   707\t            api_url,\n   708\t            data=json.dumps(payload).encode(\"utf-8\"),\n   709\t            headers={\"Content-Type\": \"application/json\"},\n   710\t            method=\"POST\",\n   711\t        )\n   712\t\n   713\t        try:\n   714\t            with urllib.request.urlopen(request, timeout=120) as response:\n   715\t                result = json.loads(response.read().decode(\"utf-8\"))\n   716\t                return result.get(\"response\", \"\").strip()\n   717\t        except urllib.error.URLError as e:\n   718\t            raise RuntimeError(f\"Failed to connect to Ollama at {url}: {e}\")\n   719\t        except json.JSONDecodeError:\n   720\t            raise RuntimeError(\"Invalid response from Ollama API\")\n   721\t\n   722\t    def test_ollama_connection(self, url: str) -> Tuple[bool, str, list]:\n   723\t        \"\"\"Test connection to Ollama and get available models.\n   724\t\n   725\t        Args:\n   726\t            url: Ollama API URL\n   727\t\n   728\t        Returns:\n   729\t            Tuple of (connected, message, model_list)\n   730\t        \"\"\"\n   731\t        import urllib.request\n   732\t        import urllib.error\n   733\t\n   734\t        api_url = f\"{url.rstrip('/')}/api/tags\"\n   735\t\n   736\t        try:\n   737\t            request = urllib.request.Request(api_url)\n   738\t            with urllib.request.urlopen(request, timeout=10) as response:\n   739\t                result = json.loads(response.read().decode(\"utf-8\"))\n   740\t                models = [m.get(\"name\", \"\") for m in result.get(\"models\", [])]\n   741\t                # Filter to vision-capable models (common ones)\n   742\t                vision_models = [\n   743\t                    m\n   744\t                    for m in models\n   745\t                    if any(\n   746\t                        v in m.lower()\n   747\t                        for v in [\"llava\", \"bakllava\", \"moondream\", \"llama3.2-vision\"]\n   748\t                    )\n   749\t                ]\n   750\t                if vision_models:\n   751\t                    return (\n   752\t                        True,\n   753\t                        f\"Connected. Found {len(vision_models)} vision model(s)\",\n   754\t                        vision_models,\n   755\t                    )\n   756\t                elif models:\n   757\t                    return (\n   758\t                        True,\n   759\t                        f\"Connected but no vision models found. Available: {', '.join(models[:5])}\",\n   760\t                        models,\n   761\t                    )\n   762\t                else:\n   763\t                    return True, \"Connected but no models installed\", []\n   764\t        except urllib.error.URLError as e:\n   765\t            return False, f\"Connection failed: {e}\", []\n   766\t        except Exception as e:\n   767\t            return False, f\"Error: {e}\", []\n   768\t\n   769\t    def generate_ollama_text(self, url: str, model: str, prompt: str) -> str:\n   770\t        \"\"\"Generate text response from Ollama without an image (text-only).","time":{"start":1773260153741,"end":1773260153741}}}}
