m)\n   471\t            detail_level: Key from FLORENCE_DETAIL_LEVELS dict (brief, standard, detailed)\n   472\t\n   473\t        Returns:\n   474\t            Generated caption string\n   475\t        \"\"\"\n   476\t        import torch\n   477\t\n   478\t        _debug(\"=== Starting Florence2 caption generation ===\")\n   479\t        _debug(f\"Image path: {image_path}\")\n   480\t        _debug(f\"Model key: {model_key}, Detail level: {detail_level}\")\n   481\t\n   482\t        # Validate image first\n   483\t        _debug(\"Validating image...\")\n   484\t        valid, message = self.validate_image(image_path)\n   485\t        _debug(f\"Validation result: valid={valid}, message={message}\")\n   486\t        if not valid:\n   487\t            raise RuntimeError(f\"Image validation failed: {message}\")\n   488\t\n   489\t        # Ensure model is loaded (will reload if different model requested)\n   490\t        _debug(\"Ensuring model is loaded...\")\n   491\t        self.load_florence(model_key)\n   492\t\n   493\t        # Load and preprocess image with explicit error handling\n   494\t        _debug(\"Opening image with PIL...\")\n   495\t        try:\n   496\t            image = Image.open(image_path)\n   497\t            _debug(\n   498\t                f\"Image opened: format={image.format}, mode={image.mode}, size={image.size}\"\n   499\t            )","time":{"start":1773260140283,"end":1773260140283}}}}
