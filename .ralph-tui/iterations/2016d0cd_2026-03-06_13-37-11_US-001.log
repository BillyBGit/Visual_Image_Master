{"type":"tool_use","timestamp":1772764793629,"sessionID":"ses_0a6fee6f0d0b","part":{"type":"tool","callID":"call_5orldsjz","tool":"write","state":{"status":"completed","input":{"file_path":"tests/unit/test_advanced_filter_dialog_AdvancedFilterDialog_get_filter_settings.py","content":"\"\"\"Tests for AdvancedFilterDialog.get_filter_settings() method.\"\"\"\n\nimport pytest\nfrom advanced_filter_dialog import AdvancedFilterDialog\n\n\nclass TestAdvancedFilterDialogGetFilterSettings:\n    \"\"\"Test suite for AdvancedFilterDialog.get_filter_settings method.\"\"\"\n\n    def test_get_filter_settings_returns_copy(self):\n        \"\"\"Test that get_filter_settings returns a copy, not the original dict.\"\"\"\n        dialog = AdvancedFilterDialog()\n        settings = dialog.get_filter_settings()\n        \n        assert isinstance(settings, dict), \"Should return a dict\"\n        assert settings is not dialog.filter_settings, \"Should return a copy, not the original\"\n\n    def test_get_filter_settings_default_values(self):\n        \"\"\"Test that get_filter_settings returns default values.\"\"\"\n        dialog = AdvancedFilterDialog()\n        settings = dialog.get_filter_settings()\n        \n        assert settings == dialog.filter_settings, \"Default values should match initial filter_settings\"\n\n    def test_get_filter_settings_after_update(self):\n        \"\"\"Test that get_filter_settings reflects changes after update_filter_settings.\"\"\"\n        dialog = AdvancedFilterDialog()\n        \n        # Update some settings\n        dialog.update_filter_settings(face_detection=True, object_detection=False)\n        settings = dialog.get_filter_settings()\n        \n        assert settings[\"face_detection\"] is True, \"Should reflect updated face_detection\"\n        assert settings[\"object_detection\"] is False, \"Should reflect updated object_detection\"\n\n    def test_get_filter_settings_face_detection(self):\n        \"\"\"Test get_filter_settings with face_detection enabled.\"\"\"\n        dialog = AdvancedFilterDialog()\n        dialog.face_enable_cb = True\n        settings = dialog.get_filter_settings()\n        \n        assert settings[\"face_detection\"] is True, \"face_detection should be True when enabled\"\n\n    def test_get_filter_settings_object_detection(self):\n        \"\"\"Test get_filter_settings with object_detection enabled.\"\"\"\n        dialog = AdvancedFilterDialog()\n        dialog.object_enable_cb = True\n        settings = dialog.get_filter_settings()\n        \n        assert settings[\"object_detection\"] is True, \"object_detection should be True when enabled\"\n\n    def test_get_filter_settings_scene_recognition(self):\n        \"\"\"Test get_filter_settings with scene_recognition enabled.\"\"\"\n        dialog = AdvancedFilterDialog()\n        dialog.scene_enable_cb = True\n        settings = dialog.get_filter_settings()\n        \n        assert settings[\"scene_recognition\"] is True, \"scene_recognition should be True when enabled\"\n\n    def test_get_filter_settings_quality_filter(self):\n        \"\"\"Test get_filter_settings with quality_filter enabled.\"\"\"\n        dialog = AdvancedFilterDialog()\n        dialog.quality_enable_cb = True\n        settings = dialog.get_filter_settings()\n        \n        assert settings[\"quality_filter\"] is True, \"quality_filter should be True when enabled\"\n\n    def test_get_filter_settings_filesize_filter(self):\n        \"\"\"Test get_filter_settings with filesize_filter enabled.\"\"\"\n        dialog = AdvancedFilterDialog()\n        dialog.filesize_enable_cb = True\n        settings = dialog.get_filter_settings()\n        \n        assert settings[\"filesize_filter\"] is True, \"filesize_filter should be True when enabled\"\n"},"output":"Wrote 3341 bytes to tests/unit/test_advanced_filter_dialog_AdvancedFilterDialog_get_filter_settings.py","time":{"start":1772764793629,"end":1772764793629}}}}
