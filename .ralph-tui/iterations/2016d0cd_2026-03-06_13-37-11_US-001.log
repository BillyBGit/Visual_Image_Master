      \"scene_groups\": [],\n    48\t            \"scene_confidence\": 0.3,\n    49\t            \"scene_inverse\": False,  # True = does NOT contain\n    50\t            \"quality_filter\": False,\n    51\t            \"quality_min_score\": 60,\n    52\t            \"quality_sharpness_min\": 40,\n    53\t            \"quality_brightness_min\": 50,\n    54\t            \"quality_brightness_max\": 200,\n    55\t            \"quality_inverse\": False,  # True = does NOT meet criteria\n    56\t            \"filesize_filter\": False,\n    57\t            \"filesize_min_kb\": 0,  # Minimum file size in KB\n    58\t            \"filesize_max_kb\": 10240,  # Maximum file size in KB (10MB default)\n    59\t        }\n    60\t\n    61\t        self.setup_ui()\n    62\t\n    63\t    def setup_ui(self):\n    64\t        \"\"\"Setup the dialog UI.\"\"\"\n    65\t        main_layout = QVBoxLayout()\n    66\t\n    67\t        # Create scroll area for filters\n    68\t        scroll = QScrollArea()\n    69\t        scroll.setWidgetResizable(True)\n    70\t        scroll_widget = QWidget()\n    71\t        scroll_layout = QVBoxLayout(scroll_widget)\n    72\t\n    73\t        # Add filter sections\n    74\t        scroll_layout.addWidget(self.create_face_filter_section())\n    75\t        scroll_layout.addWidget(self.create_object_filter_section())\n    76\t        scroll_layout.addWidget(self.create_scene_filter_section())\n    77\t        scroll_layout.addWidget(self.create_quality_filter_section())\n    78\t        scroll_layout.addWidget(self.create_filesize_filter_section())\n    79\t\n    80\t        scroll.setWidget(scroll_widget)\n    81\t        main_layout.addWidget(scroll)\n    82\t\n    83\t        # Global invert option\n    84\t        self.global_invert_cb = QCheckBox(\n    85\t            \"Invert entire filter (show what does NOT match)\"\n    86\t        )\n    87\t        self.global_invert_cb.setStyleSheet(\"font-weight: bold; color: #FF5722;\")\n    88\t        self.global_invert_cb.stateChanged.connect(self.update_filter_settings)\n    89\t        main_layout.addWidget(self.global_invert_cb)\n    90\t\n    91\t        # Buttons\n    92\t        button_layout = QHBoxLayout()\n    93\t        self.apply_btn = QPushButton(\"Apply Filters\")\n    94\t        self.apply_btn.clicked.connect(self.accept)\n    95\t        self.clear_btn = QPushButton(\"Clear All\")\n    96\t        self.clear_btn.clicked.connect(self.clear_all_filters)\n    97\t        self.cancel_btn = QPushButton(\"Cancel\")\n    98\t        self.cancel_btn.clicked.connect(self.reject)\n    99\t\n   100\t        button_layout.addWidget(self.clear_btn)\n   101\t        button_layout.addStretch()\n   102\t        button_layout.addWidget(self.cancel_btn)\n   103\t        button_layout.addWidget(self.apply_btn)\n   104\t\n   105\t        main_layout.addLayout(button_layout)\n   106\t        self.setLayout(main_layout)\n   107\t\n   108\t    def create_face_filter_section(self):\n   109\t        \"\"\"Create face detection filter section.\"\"\"\n   110\t        group = QGroupBox(\"Face Detection\")\n   111\t        layout = QVBoxLayout()\n   112\t\n   113\t        self.face_enable_cb = QCheckBox(\"Filter by faces\")\n   114\t        self.face_enable_cb.stateChanged.connect(self.update_filter_settings)\n   115\t        layout.addWidget(self.face_enable_cb)\n   116\t\n   117\t        # Contains/Does not contain\n   118\t        mode_layout = QHBoxLayout()\n   119\t        self.face_contains_rb = QRadioButton(\"Contains\")\n   120\t        self.face_contains_rb.setChecked(True)\n   121\t        self.face_contains_rb.toggled.connect(self.update_filter_settings)\n   122\t        self.face_not_contains_rb = QRadioButton(\"Does NOT contain\")\n   123\t        self.face_not_contains_rb.toggled.connect(self.update_filter_settings)\n   124\t        mode_layout.addWidget(self.face_contains_rb)\n   125\t        mode_layout.addWidget(self.face_not_contains_rb)\n   126\t        m