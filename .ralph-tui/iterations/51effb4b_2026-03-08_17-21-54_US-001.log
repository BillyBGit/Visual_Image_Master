        backend_row.addWidget(QLabel(\"Backend:\"))\n    53\t        self.backend_combo = QComboBox()\n    54\t        self.backend_combo.addItem(\"Florence2 (Local)\", \"florence2\")\n    55\t        self.backend_combo.addItem(\"WD14 Tagger (Local)\", \"wd14\")\n    56\t        self.backend_combo.addItem(\"Ollama (Server)\", \"ollama\")\n    57\t        self.backend_combo.currentIndexChanged.connect(self._on_backend_changed)\n    58\t        backend_row.addWidget(self.backend_combo, 1)\n    59\t        backend_layout.addLayout(backend_row)\n    60\t\n    61\t        # Florence2 settings\n    62\t        self.florence_widget = QGroupBox(\"Florence2 Settings\")\n    63\t        florence_layout = QVBoxLayout(self.florence_widget)\n    64\t\n    65\t        model_row = QHBoxLayout()\n    66\t        model_row.addWidget(QLabel(\"Model:\"))\n    67\t        self.florence_model_combo = QComboBox()\n    68\t        self.florence_model_combo.addItem(\"Base (~460MB)\", \"base\")\n    69\t        self.florence_model_combo.addItem(\"Large (~1.5GB)\", \"large\")\n    70\t        self.florence_model_combo.addItem(\"Base Fine-tuned (~460MB)\", \"base-ft\")\n    71\t        self.florence_model_combo.addItem(\"Large Fine-tuned (~1.5GB)\", \"large-ft\")\n    72\t        model_row.addWidget(self.florence_model_combo, 1)\n    73\t        florence_layout.addLayout(model_row)\n    74\t\n    75\t        detail_row = QHBoxLayout()\n    76\t        detail_row.addWidget(QLabel(\"Detail:\"))\n    77\t        self.florence_detail_combo = QComboBox()\n    78\t        self.florence_detail_combo.addItem(\"Brief (short caption)\", \"brief\")\n    79\t        self.florence_detail_combo.addItem(\"Standard\", \"standard\")\n    80\t        self.florence_detail_combo.addItem(\"Detailed (comprehensive)\", \"detailed\")\n    81\t        self.florence_detail_combo.setCurrentIndex(2)\n    82\t        detail_row.addWidget(self.florence_detail_combo, 1)\n    83\t        florence_layout.addLayout(detail_row)\n    84\t\n    85\t        backend_layout.addWidget(self.florence_widget)\n    86\t\n    87\t        # WD14 settings\n    88\t        self.wd14_widget = QGroupBox(\"WD14 Settings\")\n    89\t        wd14_layout = QVBoxLayout(self.wd14_widget)\n    90\t\n    91\t        wd14_model_row = QHBoxLayout()\n    92\t        wd14_model_row.addWidget(QLabel(\"Model:\"))\n    93\t        self.wd14_model_combo = QComboBox()\n    94\t        self.wd14_model_combo.addItem(\"ViT v2 (~350MB)\", \"vit-v2\")\n    95\t        self.wd14_model_combo.addItem(\"SwinV2 v2 (~430MB)\", \"swinv2-v2\")\n    96\t        self.wd14_model_combo.addItem(\"ConvNeXtV2 v2 (~680MB)\", \"convnextv2-v2\")\n    97\t        self.wd14_model_combo.addItem(\"MOAT v2 (~840MB)\", \"moat-v2\")\n    98\t        self.wd14_model_combo.addItem(\"ViT v3 (~350MB)\", \"vit-v3\")\n    99\t        wd14_model_row.addWidget(self.wd14_model_combo, 1)\n   100\t        wd14_layout.addLayout(wd14_model_row)\n   101\t\n   102\t        threshold_row = QHBoxLayout()\n   103\t        threshold_row.addWidget(QLabel(\"Threshold:\"))\n   104\t        self.wd14_threshold = QDoubleSpinBox()\n   105\t        self.wd14_threshold.setRange(0.1, 0.9)\n   106\t        self.wd14_threshold.setSingleStep(0.05)\n   107\t        self.wd14_threshold.setValue(0.35)\n   108\t        self.wd14_threshold.setToolTip(\n   109\t            \"Minimum confidence for tags (lower = more tags)\"\n   110\t        )\n   111\t        threshold_row.addWidget(self.wd14_threshold, 1)\n   112\t        wd14_layout.addLayout(threshold_row)\n   113\t\n   114\t        backend_layout.addWidget(self.wd14_widget)\n   115\t        self.wd14_widget.hide()\n   116\t\n   117\t        # Ollama settings\n   118\t        self.ollama_widget = QGroupBox(\"Ollama Settings\")\n   119\t        ollama_layout = QVBoxLayout(self.ollama_widget)\n   120\t\n   121\t        url_row = QHBoxLayout()\n   122\t        url_row.addWidget(QLabel(\"URL:\"))\n   123\t        self.ollama_url = QLineEdit()\n   124\t        self.ollama_url.setPlaceholderText(\"http://localhost:11434\")\n   125\t        self.ollama_url.setText(\"http://localhost:11434\")\n   126\t        url_row.addWidget(self.ollama_url, 1)\n   127\t        ollama_layout.addLayout(url_row)\n   128\t\n   129\t        ollama_model_row = QHBoxLayout()\n   130\t        ollama_model_row.addWidget(QLabel(\"Model:\"))\n   131\t        self.ollama_model = QLineEdit()\n   132\t        self.ollama_model.setPlaceholderText(\"llava\")\n   133\t        self.ollama_model.setText(\"llava\")\n   134\t        ollama_model_row.addWidget(self.ollama_model, 1)\n   135\t        ollama_layout.addLayout(ollama_model_row)\n   136\t\n   137\t        backend_layout.addWidget(self.ollama_widget)\n   138\t        self.ollama_widget.hide()\n   139\t\n   140\t        layout.addWidget(backend_group)\n   141\t\n   142\t        # Options\n   143\t        options_group = QGroupBox(\"Options\")\n   144\t        options_layout = QVBoxLayout(options_group)\n   145\t\n   146\t        self.overwrite_check = QCheckBox(\"Overwrite existing captions\")\n   147\t        self.overwrite_check.setChecked(False)\n   148\t        options_layout.addWidget(self.overwrite_check)\n   149\t\n   150\t        layout.addWidget(options_group)\n   151\t\n   152\t        # Progress\n   153\t        self.progress_group = QGroupBox(\"Progress\")\n   154\t        progress_layout = QVBoxLayout(self.progress_group)\n   155\t\n   156\t        self.progress_bar = QProgressBar()\n   157\t        self.progress_bar.setRange(0, len(self.image_paths))\n   158\t        self.progress_bar.setValue(0)\n   159\t        progress_layout.addWidget(self.progress_bar)\n   160\t\n   161\t        self.progress_label = QLabel(\n   162\t            f\"Ready to process {len(self.image_paths)} image(s)\"\n   163\t        )\n   164\t        progress_layout.addWidget(self.progress_label)\n   165\t\n   166\t        layout.addWidget(self.progress_group)\n   167\t\n   168\t        # Bu