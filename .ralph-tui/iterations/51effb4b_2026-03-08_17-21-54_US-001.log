{"type":"tool_use","timestamp":1772952430912,"sessionID":"ses_fd1ee3b4b27d","part":{"type":"tool","callID":"call_8eafk4wo","tool":"read","state":{"status":"completed","input":{"file_path":"tests/unit/test_autocaption_dialog_AutoCaptionDialog_closeEvent.py"},"output":"     1\t\"\"\"Tests for AutoCaptionDialog.closeEvent() method.\"\"\"\n     2\t\n     3\tfrom unittest.mock import Mock\n     4\timport pytest\n     5\tfrom autocaption_dialog import AutoCaptionDialog\n     6\t\n     7\t\n     8\tclass TestAutoCaptionDialogCloseEvent:\n     9\t    \"\"\"Test suite for AutoCaptionDialog.closeEvent() method.\"\"\"\n    10\t\n    11\t    def test_closeEvent_with_active_worker(self):\n    12\t        \"\"\"Test closeEvent with active worker - should cleanup worker.\"\"\"\n    13\t        # Create dialog with mock image paths\n    14\t        image_paths = [\"/mock/path1.jpg\", \"/mock/path2.jpg\"]\n    15\t        dialog = AutoCaptionDialog(image_paths)\n    16\t\n    17\t        # Set up mock worker\n    18\t        worker = Mock()\n    19\t        dialog.caption_worker = worker\n    20\t\n    21\t        # Create mock event\n    22\t        event = Mock()\n    23\t\n    24\t        # Call closeEvent\n    25\t        dialog.closeEvent(event)\n    26\t\n    27\t        # Assert worker cleanup\n    28\t        assert worker.wait.called\n    29\t        assert worker.deleteLater.called\n    30\t        assert dialog.caption_worker is None\n    31\t        assert event.accept.called\n    32\t\n    33\t    def test_closeEvent_without_worker(self):\n    34\t        \"\"\"Test closeEvent without worker - should not attempt cleanup.\"\"\"\n    35\t        # Create dialog with mock image paths\n    36\t        image_paths = [\"/mock/path1.jpg\", \"/mock/path2.jpg\"]\n    37\t        dialog = AutoCaptionDialog(image_paths)\n    38\t\n    39\t        # Ensure worker is None\n    40\t        dialog.caption_worker = None\n    41\t\n    42\t        # Create mock event\n    43\t        event = Mock()\n    44\t\n    45\t        # Call closeEvent\n    46\t        dialog.closeEvent(event)\n    47\t\n    48\t        # Assert no worker cleanup occurred\n    49\t        assert not hasattr(dialog, 'caption_worker') or dialog.caption_worker is None\n    50\t        assert event.accept.called\n    51\t\n    52\t    def test_closeEvent_event_accept_called(self):\n    53\t        \"\"\"Test that event.accept() is always called regardless of worker state.\"\"\"\n    54\t        # Test with worker\n    55\t        image_paths = [\"/mock/path1.jpg\"]\n    56\t        dialog = AutoCaptionDialog(image_paths)\n    57\t        dialog.caption_worker = Mock()\n    58\t        event = Mock()\n    59\t        dialog.closeEvent(event)\n    60\t        assert event.accept.called\n    61\t\n    62\t        # Test without worker\n    63\t        image_paths2 = [\"/mock/path1.jpg\"]\n    64\t        dialog2 = AutoCaptionDialog(image_paths2)\n    65\t        dialog2.caption_worker = None\n    66\t        event2 = Mock()\n    67\t        dialog2.closeEvent(event2)\n    68\t        assert event2.accept.called\n    69\t\n    70\t    def test_closeEvent_worker_cleanup_order(self):\n    71\t        \"\"\"Test that worker cleanup happens in correct order: wait -> deleteLater -> None.\"\"\"\n    72\t        image_paths = [\"/mock/path1.jpg\"]\n    73\t        dialog = AutoCaptionDialog(image_paths)\n    74\t\n    75\t        # Set worker\n    76\t        worker = Mock()\n    77\t        dialog.caption_worker = worker\n    78\t\n    79\t        # Call closeEvent\n    80\t        event = Mock()\n    81\t        dialog.closeEvent(event)\n    82\t\n    83\t        # Assert wait is called before deleteLater\n    84\t        assert worker.wait.called\n    85\t        assert worker.deleteLater.called\n    86\t        # Assert worker reference is None\n    87\t        assert dialog.caption_worker is None\n    88\t\n    89\t    def test_closeEvent_multiple_calls(self):\n    90\t        \"\"\"Test that multiple closeEvent calls don't cause errors.\"\"\"\n    91\t        image_paths = [\"/mock/path1.jpg\"]\n    92\t        dialog = AutoCaptionDialog(image_paths)\n    93\t        dialog.caption_worker = Mock()\n    94\t\n    95\t        # First call\n    96\t        event1 = Mock()\n    97\t        dialog.closeEvent(event1)\n    98\t\n    99\t        # Second call - should not raise error\n   100\t        event2 = Mock()\n   101\t        dialog.closeEvent(event2)\n   102\t\n   103\t        # Assert both events accepted\n   104\t        assert event1.accept.called\n   105\t        assert event2.accept.called\n   106\t\n   107\t    def test_closeEvent_with_exception_in_worker(self):\n   108\t        \"\"\"Test that exceptions in worker.wait() are handled gracefully.\"\"\"\n   109\t        image_paths = [\"/mock/path1.jpg\"]\n   110\t        dialog = AutoCaptionDialog(image_paths)\n   111\t\n   112\t        # Create worker that raises exception\n   113\t        worker = Mock()\n   114\t        worker.wait.side_effect = Exception(\"Worker error\")\n   115\t        dialog.caption_worker = worker\n   116\t\n   117\t        event = Mock()\n   118\t\n   119\t        # Should not raise exception - the closeEvent method doesn't handle exceptions\n   120\t        # So this test should actually fail or we need to update the implementation\n   121\t        with pytest.raises(Exception):\n   122\t            dialog.closeEvent(event)\n   123\t\n   124\t    def test_closeEvent_worker_reference_cleanup(self):\n   125\t        \"\"\"Test that worker reference is properly cleaned up to None.\"\"\"\n   126\t        image_paths = [\"/mock/path1.jpg\"]\n   127\t        dialog = AutoCaptionDialog(image_paths)\n   128\t\n   129\t        # Set worker\n   130\t        worker = Mock()\n   131\t        dialog.caption_worker = worker\n   132\t\n   133\t        # Call closeEvent\n   134\t        event = Mock()\n   135\t        dialog.closeEvent(event)\n   136\t\n   137\t        # Assert worker reference is None\n   138\t        assert dialog.caption_worker is None","time":{"start":1772952430912,"end":1772952430912}}}}
