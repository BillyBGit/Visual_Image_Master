url\", \"http://localhost:11434\")\n   234\t        self.ollama_url.setText(ollama_url)\n   235\t\n   236\t        ollama_model = getattr(main_win, \"caption_ollama_model\", \"llava\")\n   237\t        self.ollama_model.setText(ollama_model)\n   238\t\n   239\t    def _save_settings(self):\n   240\t        \"\"\"Save settings to main app.\"\"\"\n   241\t        from utils import find_main_window\n   242\t\n   243\t        main_win = find_main_window()\n   244\t        if not main_win:\n   245\t            return\n   246\t\n   247\t        main_win.caption_backend = self.backend_combo.currentData()\n   248\t        main_win.caption_florence_model = self.florence_model_combo.currentData()\n   249\t        main_win.caption_florence_detail = self.florence_detail_combo.currentData()\n   250\t        main_win.caption_wd14_model = self.wd14_model_combo.currentData()\n   251\t        main_win.caption_wd14_threshold = self.wd14_threshold.value()\n   252\t        main_win.caption_ollama_url = self.ollama_url.text().strip()\n   253\t        main_win.caption_ollama_model = self.ollama_model.text().strip()\n   254\t\n   255\t        if hasattr(main_win, \"write_settings\"):\n   256\t            main_win.write_settings()\n   257\t\n   258\t    def _start_generation(self):\n   259\t        \"\"\"Start the caption generation process.\"\"\"\n   260\t        self._save_settings()\n   261\t\n   262\t        self.current_index = 0\n   263\t        self.results = []\n   264\t\n   265\t        # Update UI\n   266\t        self.generate_btn.setEnabled(False)\n   267\t        self.cancel_btn.setEnabled(True)\n   268\t        self.close_btn.setEnabled(False)\n   269\t        self.backend_combo.setEnabled(False)\n   270\t        self.progress_bar.setValue(0)\n   271\t\n   272\t        # Start processing first image\n   273\t        self._process_next_image()\n   274\t\n   275\t    def _process_next_image(self):\n   276\t        \"\"\"Process the next image in the queue.\"\"\"\n   277\t        if self.current_index >= len(self.image_paths):\n   278\t            self._finish_generation()\n   279\t            return\n   280\t\n   281\t        image_path = self.image_paths[self.current_index]\n   282\t        filename = os.path.basename(image_path)\n   283\t\n   284\t        # Check if caption already exists\n   285\t        base_name = os.path.splitext(image_path)[0]\n   286\t        caption_path = base_name + \".txt\"\n   287\t\n   288\t        if os.path.exists(caption_path) and not self.overwrite_check.isChecked():\n   289\t            # Skip existing\n   290\t            self.results.append((image_path, None, \"skipped\"))\n   291\t            self.current_index += 1\n   292\t            self.progress_bar.setValue(self.current_index)\n   293\t            self.progress_label.setText(f\"Skipped {filename} (caption exists)\")\n   294\t            QTimer.singleShot(10, self._process_next_image)\n   295\t            return\n   296\t\n   297\t        self.progress_label.setText(\n   298\t            f\"Processing {filename}... ({self.current_index + 1}/{len(self.image_paths)})\"\n   299\t        )\n   300\t\n   301\t        # Get settings\n   302\t        backend = self.backend_combo.currentData()\n   303\t        ollama_url = self.ollama_url.text().strip() or \"http://localhost:11434\"\n   304\t        ollama_model = self.ollama_model.text().strip() or \"llava\"\n   305\t        florence_model = self.florence_model_combo.currentData()\n   306\t        florence_detail = self.florence_detail_combo.currentData()\n   307\t        wd14_model = self.wd14_model_combo.currentData()\n   308\t        wd14_threshold = self.wd14_threshold.value()\n   309\t\n   310\t        # Create worker\n   311\t        self.caption_worker = CaptionWorker(\n   312\t            self.generator,\n   313\t            image_path,\n   314\t            backend,\n   315\t            ollama_url,\n   316\t            ollama_model,\n   317\t            florence_model,\n   318\t            florence_detail,\n   319\t            wd14_model,\n   320\t            wd14_threshold,\n   321\t        )\n   322\t        self.caption_worker.finished.connect(self._on_caption_finished)\n   323\t        self.caption_worker.error.connect(self._on_caption_error)\n   324\t        self.caption_worker.start()\n   325\t\n   326\t    def _on_caption_finished(self, caption):\n   327\t        \"\"\"Handle successful caption generation.\"\"\"\n   328\t        image_path = self.image_paths[self.current_index]\n   329\t\n   330\t        # Save caption to file\n   331\t        base_name = os.path.splitext(image_path)[0]\n   332\t        caption_path = base_name + \".txt\"\n   333\t\n   334\t        try:\n   335\t            with open(caption_path, \"w\", encoding=\"utf-8\") as f:\n   336\t                f.write(caption)\n   337\t            self.results.append((image_path, caption, \"success\"))\n   338\t        except OSError as e:\n   339\t            self.results.append((image_path, None, f\"save error: {e}\"))\n   340\t\n   341\t        # Cleanup worker\n   342\t        if self.caption_worker:\n   343\t            self.caption_worker.wait()\n   344\t            self.caption_worker.deleteLater()\n   345\t            self.caption_worker = None\n   346\t\n   347\t        # Move to next\n   348\t        self.current_index += 1\n   349\t        self.progress_bar.setValue(self.current_index)\n   350\t        QTimer.singleShot(10, self._process_next_image)\n   351\t\n   352\t    def _on_caption_error(self, error):\n   353\t        \"\"\"Handle caption generation error.\"\"\"\n   354\t        image_path = self.image_paths[self.current_index]\n   355\t        self.results.append((image_path, None, f\"error: {error}\"))\n   356\t\n   357\t        # Cleanup worker\n   358\t        if self.caption_worker:\n   359\t            self.caption_worker.wait()\n   360\t            self.caption_worker.deleteLater()\n   361\t            self.caption_worker = None\n   362\t\n   363\t        # Move t