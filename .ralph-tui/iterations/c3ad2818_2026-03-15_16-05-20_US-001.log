shortcuts()\n                    \n                    # Mock the handler to verify it's called\n                    window._on_save_requested = MagicMock()\n                    window.shortcut_save.activated.emit()\n                    window._on_save_requested.assert_called_once()\n\n    def test_shortcut_save_key_sequence(self):\n        \"\"\"Test that self.shortcut_save has the correct key sequence.\"\"\"\n        from caption_window import CaptionWindow\n        \n        with patch(\"caption_window.get_caption_generator\") as mock_gen:\n            mock_gen.return_value = MagicMock()\n            with patch(\"caption_window.CaptionGenerator.is_florence_available\", return_value=(False, \"mocked\")):\n                with patch(\"caption_window.CaptionGenerator.is_wd14_available\", return_value=(False, \"mocked\")):\n                    window = CaptionWindow([], 0)\n                    window._setup_shortcuts()\n                    \n                    assert window.shortcut_save.key().toString() == \"Ctrl+S\"\n\n    def test_shortcut_save_parent(self):\n        \"\"\"Test that self.shortcut_save.parent() is the CaptionWindow instance.\"\"\"\n        from caption_window import CaptionWindow\n        \n        with patch(\"caption_window.get_caption_generator\") as mock_gen:\n            mock_gen.return_value = MagicMock()\n            with patch(\"caption_window.CaptionGenerator.is_florence_available\", return_value=(False, \"mocked\")):\n                with patch(\"caption_window.CaptionGenerator.is_wd14_available\", return_value=(False, \"mocked\")):\n                    window = CaptionWindow([], 0)\n                    window._setup_shortcuts()\n                    \n                    assert window.shortcut_save.parent() is window\n\n    def test_shortcut_save_is_enabled(self):\n        \"\"\"Test that self.shortcut_save.isEnabled() returns True.\"\"\"\n        from caption_window import CaptionWindow\n        \n        with patch(\"caption_window.get