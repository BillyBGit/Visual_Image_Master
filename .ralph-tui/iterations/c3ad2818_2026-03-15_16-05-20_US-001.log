{"type":"tool_use","timestamp":1773551357071,"sessionID":"ses_f375f830d7a8","part":{"type":"tool","callID":"call_wwwnzue4","tool":"write","state":{"status":"completed","input":{"content":"\"\"\"Tests for CaptionWindow._setup_shortcuts method.\"\"\"\n\nfrom PySide6.QtWidgets import QShortcut, QApplication\nfrom PySide6.QtGui import QKeySequence\nfrom unittest.mock import MagicMock, patch\nimport pytest\n\n\nclass TestCaptionWindowSetupShortcuts:\n    \"\"\"Test suite for CaptionWindow._setup_shortcuts method.\"\"\"\n\n    def test_shortcut_save_activated(self):\n        \"\"\"Test that self.shortcut_save is a QShortcut instance.\"\"\"\n        from caption_window import CaptionWindow\n        \n        with patch(\"caption_window.get_caption_generator\") as mock_gen:\n            mock_gen.return_value = MagicMock()\n            window = CaptionWindow([], 0)\n            window._setup_shortcuts()\n            \n            assert isinstance(window.shortcut_save, QShortcut)\n\n    def test_shortcut_save_connected_to_handler(self):\n        \"\"\"Test that self.shortcut_save.activated is connected to self._on_save_requested.\"\"\"\n        from caption_window import CaptionWindow\n        \n        with patch(\"caption_window.get_caption_generator\") as mock_gen:\n            mock_gen.return_value = MagicMock()\n            window = CaptionWindow([], 0)\n            window._setup_shortcuts()\n            \n            # Mock the handler to verify it's called\n            window._on_save_requested = MagicMock()\n            window.shortcut_save.activated.emit()\n            window._on_save_requested.assert_called_once()\n\n    def test_shortcut_save_key_sequence(self):\n        \"\"\"Test that self.shortcut_save has the correct key sequence.\"\"\"\n        from caption_window import CaptionWindow\n        \n        with patch(\"caption_window.get_caption_generator\") as mock_gen:\n            mock_gen.return_value = MagicMock()\n            window = CaptionWindow([], 0)\n            window._setup_shortcuts()\n            \n            assert window.shortcut_save.key().toString() == \"Ctrl+S\"\n\n    def test_shortcut_save_parent(self):\n        \"\"\"Test that self.shortcut_save.parent() is the CaptionWindow instance.\"\"\"\n        from caption_window import CaptionWindow\n        \n        with patch(\"caption_window.get_caption_generator\") as mock_gen:\n            mock_gen.return_value = MagicMock()\n            window = CaptionWindow([], 0)\n            window._setup_shortcuts()\n            \n            assert window.shortcut_save.parent() is window\n\n    def test_shortcut_save_is_enabled(self):\n        \"\"\"Test that self.shortcut_save.isEnabled() returns True.\"\"\"\n        from caption_window import CaptionWindow\n        \n        with patch(\"caption_window.get_caption_generator\") as mock_gen:\n            mock_gen.return_value = MagicMock()\n            window = CaptionWindow([], 0)\n            window._setup_shortcuts()\n            \n            assert window.shortcut_save.isEnabled()\n\n    def test_no_other_shortcuts_created(self):\n        \"\"\"Test that only one QShortcut instance is created.\"\"\"\n        from caption_window import CaptionWindow\n        \n        with patch(\"caption_window.get_caption_generator\") as mock_gen:\n            mock_gen.return_value = MagicMock()\n            window = CaptionWindow([], 0)\n            window._setup_shortcuts()\n            \n            # Count all QShortcut instances in the window\n            shortcuts = window.findChildren(QShortcut)\n            assert len(shortcuts) == 1\n            assert shortcuts[0] is window.shortcut_save\n\n    def test_shortcut_save_can_be_triggered(self):\n        \"\"\"Test that self.shortcut_save can be triggered and calls the handler.\"\"\"\n        from caption_window import CaptionWindow\n        \n        with patch(\"caption_window.get_caption_generator\") as mock_gen:\n            mock_gen.return_value = MagicMock()\n            window = CaptionWindow([], 0)\n            window._setup_shortcuts()\n            \n            # Mock the handler\n            window._on_save_requested = MagicMock()\n            \n            # Trigger the shortcut\n            window.shortcut_save.activated.emit()\n            \n            # Verify the handler was called\n            window._on_save_requested.assert_called_once()\n","file_path":"tests/unit/test_caption_window_CaptionWindow__setup_shortcuts.py"},"output":"Wrote 4041 bytes to tests/unit/test_caption_window_CaptionWindow__setup_shortcuts.py","time":{"start":1773551357071,"end":1773551357071}}}}
