{"type":"tool_use","timestamp":1772766309215,"sessionID":"ses_f057d2c814a1","part":{"type":"tool","callID":"call_s6akywne","tool":"write","state":{"status":"completed","input":{"file_path":"tests/unit/test_advanced_filter_dialog_AdvancedFilterDialog_has_active_filters.py","content":"\"\"\"Tests for AdvancedFilterDialog.has_active_filters() method.\"\"\"\n\nfrom advanced_filter_dialog import AdvancedFilterDialog\n\n\nclass TestAdvancedFilterDialogHasActiveFilters:\n    \"\"\"Test suite for AdvancedFilterDialog.has_active_filters() method.\"\"\"\n\n    def test_has_active_filters_no_filters(self):\n        \"\"\"Test that has_active_filters() returns False when no filters are enabled.\"\"\"\n        dialog = AdvancedFilterDialog()\n        assert dialog.has_active_filters() is False\n\n    def test_has_active_filters_face_detection(self):\n        \"\"\"Test that has_active_filters() returns True when face_detection is enabled.\"\"\"\n        dialog = AdvancedFilterDialog()\n        dialog.set_filter_settings({\"face_detection\": True})\n        assert dialog.has_active_filters() is True\n\n    def test_has_active_filters_object_detection(self):\n        \"\"\"Test that has_active_filters() returns True when object_detection is enabled.\"\"\"\n        dialog = AdvancedFilterDialog()\n        dialog.set_filter_settings({\"object_detection\": True})\n        assert dialog.has_active_filters() is True\n\n    def test_has_active_filters_scene_recognition(self):\n        \"\"\"Test that has_active_filters() returns True when scene_recognition is enabled.\"\"\"\n        dialog = AdvancedFilterDialog()\n        dialog.set_filter_settings({\"scene_recognition\": True})\n        assert dialog.has_active_filters() is True\n\n    def test_has_active_filters_quality_filter(self):\n        \"\"\"Test that has_active_filters() returns True when quality_filter is enabled.\"\"\"\n        dialog = AdvancedFilterDialog()\n        dialog.set_filter_settings({\"quality_filter\": True})\n        assert dialog.has_active_filters() is True\n\n    def test_has_active_filters_filesize_filter(self):\n        \"\"\"Test that has_active_filters() returns True when filesize_filter is enabled.\"\"\"\n        dialog = AdvancedFilterDialog()\n        dialog.set_filter_settings({\"filesize_filter\": True})\n        assert dialog.has_active_filters() is True\n\n    def test_has_active_filters_multiple_filters(self):\n        \"\"\"Test that has_active_filters() returns True when multiple filters are enabled.\"\"\"\n        dialog = AdvancedFilterDialog()\n        dialog.set_filter_settings({\"face_detection\": True, \"object_detection\": True})\n        assert dialog.has_active_filters() is True\n"},"output":"Wrote 2310 bytes to tests/unit/test_advanced_filter_dialog_AdvancedFilterDialog_has_active_filters.py","time":{"start":1772766309215,"end":1772766309215}}}}
