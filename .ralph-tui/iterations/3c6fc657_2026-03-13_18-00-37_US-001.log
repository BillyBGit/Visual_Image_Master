{"type":"tool_use","timestamp":1773385968736,"sessionID":"ses_b7f4001051af","part":{"type":"tool","callID":"call_7032nc4d","tool":"read","state":{"status":"completed","input":{"file_path":"tests/unit/test_caption_generator_get_caption_generator.py"},"output":"     1\t\"\"\"Tests for get_caption_generator singleton behavior.\n     2\t\n     3\tTests for the get_caption_generator function which provides\n     4\ta singleton CaptionGenerator instance.\"\"\"\n     5\t\n     6\timport threading\n     7\t\n     8\tfrom caption_generator import get_caption_generator, CaptionGenerator\n     9\t\n    10\t\n    11\tclass TestGetCaptionGenerator:\n    12\t    \"\"\"Test suite for get_caption_generator singleton behavior.\"\"\"\n    13\t\n    14\t    def test_get_caption_generator_returns_instance(self):\n    15\t        \"\"\"Test that get_caption_generator returns a CaptionGenerator instance.\"\"\"\n    16\t        result = get_caption_generator()\n    17\t        assert isinstance(result, CaptionGenerator)\n    18\t\n    19\t    def test_get_caption_generator_singleton(self):\n    20\t        \"\"\"Test that get_caption_generator returns the same instance.\"\"\"\n    21\t        instance1 = get_caption_generator()\n    22\t        instance2 = get_caption_generator()\n    23\t        assert instance1 is instance2\n    24\t\n    25\t    def test_get_caption_generator_initialization(self):\n    26\t        \"\"\"Test that the returned instance has all expected attributes.\"\"\"\n    27\t        instance = get_caption_generator()\n    28\t        assert hasattr(instance, 'florence_model')\n    29\t        assert hasattr(instance, 'wd14_model')\n    30\t        assert instance.florence_model is None\n    31\t        assert instance.wd14_model is None\n    32\t\n    33\t    def test_get_caption_generator_no_side_effects(self):\n    34\t        \"\"\"Test that multiple calls don't create additional instances.\"\"\"\n    35\t        instances = [get_caption_generator() for _ in range(10)]\n    36\t        assert all(instance is instances[0] for instance in instances)\n    37\t\n    38\t    def test_get_caption_generator_thread_safety(self):\n    39\t        \"\"\"Test that get_caption_generator is thread-safe.\"\"\"\n    40\t        instances = []\n    41\t        threads = []\n    42\t\n    43\t        def get_instance():\n    44\t            instances.append(get_caption_generator())\n    45\t\n    46\t        for _ in range(10):\n    47\t            thread = threading.Thread(target=get_instance)\n    48\t            threads.append(thread)\n    49\t            thread.start()\n    50\t\n    51\t        for thread in threads:\n    52\t            thread.join()\n    53\t\n    54\t        assert all(instance is instances[0] for instance in instances)\n    55\t\n    56\t    def test_get_caption_generator_global_state(self):\n    57\t        \"\"\"Test that the function uses a global variable _generator_instance.\"\"\"\n    58\t        # This is implicitly tested by the singleton behavior\n    59\t        # We can verify by checking the module has this attribute\n    60\t        import caption_generator\n    61\t        assert hasattr(caption_generator, '_generator_instance')\n    62\t\n    63\t    def test_get_caption_generator_initial_state(self):\n    64\t        \"\"\"Test that the returned instance has correct initial state.\"\"\"\n    65\t        instance = get_caption_generator()\n    66\t        assert hasattr(instance, '_florence_loaded')\n    67\t        assert hasattr(instance, '_wd14_loaded')\n    68\t        assert instance._florence_loaded is False\n    69\t        assert instance._wd14_loaded is False","time":{"start":1773385968736,"end":1773385968736}}}}
