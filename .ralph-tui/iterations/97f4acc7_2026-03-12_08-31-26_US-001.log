    41\t}\n    42\t\n    43\t\n    44\tclass CaptionWorker(QThread):\n    45\t    \"\"\"Worker thread for caption generation to avoid blocking UI.\"\"\"\n    46\t\n    47\t    finished = Signal(str)  # Caption result\n    48\t    error = Signal(str)  # Error message\n    49\t    progress = Signal(str)  # Progress updates\n    50\t\n    51\t    def __init__(\n    52\t        self,\n    53\t        generator,\n    54\t        image_path: str,\n    55\t        backend: str,\n    56\t        ollama_url: str = \"\",\n    57\t        ollama_model: str = \"\",\n    58\t        florence_model: str = \"base\",\n    59\t        florence_detail: str = \"detailed\",\n    60\t        wd14_model: str = \"vit-v2\",\n    61\t        wd14_threshold: float = 0.35,\n    62\t    ):\n    63\t        super().__init__()\n    64\t        self.generator = generator\n    65\t        self.image_path = image_path\n    66\t        self.backend = backend\n    67\t        self.ollama_url = ollama_url\n    68\t        self.ollama_model = ollama_model\n    69\t        self.florence_model = florence_model\n    70\t        self.florence_detail = florence_detail\n    71\t        self.wd14_model = wd14_model\n    72\t        self.wd14_threshold = wd14_threshold\n    73\t\n    74\t    def run(self):\n    75\t        try:\n    76\t            # Validate image first\n    77\t            self.progress.emit(\"Validating image...\")\n    78\t            valid, message = self.generator.validate_image(self.image_path)\n    79\t            if not valid:\n    80\t                self.error.emit(f\"Image validation failed: {message}\")\n    81\t                return\n    82\t\n    83\t            if self.backend == \"florence2\":\n    84\t                self.progress.emit(\"Loading Florence2 model...\")\n    85\t                caption = self.generator.generate_florence(\n    86\t                    self.image_path,\n    87\t                    model_key=self.florence_model,\n    88\t                    detail_level=self.florence_detail,\n    89\t                )\n    90\t            elif self.backend == \"wd14\":\n    91\t                self.progress.emit(\"Loading WD14 tagger...\")\n    92\t                caption = self.generator.generate_wd14(\n    93\t                    self.image_path,\n    94\t                    model_key=self.wd14_model,\n    95\t                    threshold=self.wd14_threshold,\n    96\t                )\n    97\t            else:  # ollama\n    98\t                self.progress.emit(f\"Connecting to Ollama ({self.ollama_model})...\")\n    99\t                caption = self.generator.generate_ollama(\n   100\t                    self.image_path, self.ollama_url, self.ollama_model\n   101\t                )\n   102\t            self.finished.emit(caption)\n   103\t        except Exception as e:\n   104\t            self.error.emit(str(e))\n   105\t\n   106\t\n   107\tclass BlendWorker(QThread):\n   108\t    \"\"\"Worker thread for caption blending to avoid blocking UI.\"\"\"\n   109\t\n   110\t    finished = Signal(str)  # Blended caption result\n   111\t    error = Signal(str)  # Error message\n   112\t\n   113\t    def __init__(\n   114\t        self,\n   115\t        generator,\n   116\t        ollama_url: str,\n   117\t        model: str,\n   118\t        instructions: str,\n   119\t        generated_caption: str,\n   120\t        saved_caption: str,\n   121\t    ):\n   122\t        super().__init__()\n   123\t        self.generator = generator\n   124\t        self.ollama_url = ollama_url\n   125\t        self.model = model\n   126\t        self.instructions = instructions\n   127\t        self.generated_caption = generated_caption\n   128\t        self.saved_caption = saved_caption\n   129\t\n   130\t    def run(self):\n   131\t        import os\n   132\t\n   133\t        debug = os.environ.get(\"IMG_SORT_DEBUG\") == \"1\"\n   134\t\n   135\t        try:\n   136\t            if debug:\n   137\t                print(f\"[DEBUG] BlendWorker starting with model: {self.model}\")\n   138\t\n   139\t            # Construct the prompt with both captions\n   140\t            prompt = (\n   141\t                f\"{self.instructions}\\n\\n\"\n   142\t                f\"Generated caption:\\n{self.generated_caption}\\n\\n\"\n   143\t                f\"Saved caption:\\n{self.saved_caption}\"\n   144\t            )\n   145\t\n   146\t            if debug:\n   147\t                print(f\"[DEBUG] BlendWorker prompt length: {len(prompt)}\")\n   148\t\n   149\t            # Call Ollama (text-only, no image)\n   150\t            blended = self.generator.generate_ollama_text(\n   151\t                self.ollama_url, self.model, prompt\n   152\t            )\n   153\t\n   154\t            if debug:\n   155\t                print(f\"[DEBUG] BlendWorker received response length: {len(blended)}\")\n   156\t\n   157\t            self.finished.emit(blended)\n   158\t\n   159\t        except Exception as e:\n   160\t            if debug:\n   161\t                print(f\"[DEBUG] BlendWorker error: {e}\")\n   162\t            self.error.emit(str(e))\n   163\t\n   164\t\n   165\tclass CaptionGenerator:\n   166\t    \"\"\"Generates image captions using Florence2, WD14, or Ollama.\"\"\"\n   167\t\n   168\t    def __init__(self):\n   169\t        # Florence2 state\n   170\t        self.florence_model = None\n   171\t        self.florence_processor = None\n   172\t        self.device = None\n   173\t        self._florence_loaded = False\n   174\t        self._current_florence_model = None  # Track which Florence model is loaded\n   175\t        self.custom_model_path = None  # User-specified custom model path\n   176\t\n   177\t        # WD14 state\n   178\t        self.wd14_model = None\n   179\t        self.wd14_tags = None  # Tag names from CSV\n   180\t        self.wd14_format = (\n   181\t            None  # Track model format: \"onnx\", \"safetensors\", or \"pytorch\"\n   182\t        )\n   183\t        self.wd14_img_size = 448  # Model input image size (detected from model)\n   184\t        self._wd14_loaded = False\n   185\t        self._current_wd14_model = None  # Track which WD14 model is loaded\n   186\t        self.wd14_custom_paths = {}  # Dict mapping model_key to custom model file path\n   187\t\n   188\t    def is_florence_available(self) -> Tuple[bool, str]:\n   189\t        \"\"\"Check if Florence2 dependencies are available.\n   190\t\n   191\t        Returns:\n   192\t            Tuple of (available, message)\n   193\t        \"\"\"\n   194\t        try:\n   195\t            import torch  # noqa: F401\n   196\t            import transformers  # noqa: F401\n   197\t\n   198\t            return True, \"Florence2 ready\"\n   199\t        except ImportError as e:\n   200\t       \n... (truncated at 8000 chars)","time":{"start":1773265024033,"end":1773265024033}}}}
