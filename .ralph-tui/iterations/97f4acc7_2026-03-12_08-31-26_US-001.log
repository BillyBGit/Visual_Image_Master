 432\t            )\n   433\t            _debug(f\"Processor type: {type(self.florence_processor)}\")\n   434\t            _debug(f\"Processor class: {self.florence_processor.__class__.__name__}\")\n   435\t\n   436\t            # Load model using native Florence2ForConditionalGeneration class\n   437\t            _debug(\"Loading model (this may take a while)...\")\n   438\t            self.florence_model = Florence2ForConditionalGeneration.from_pretrained(\n   439\t                model_name,\n   440\t                torch_dtype=torch.float16 if self.device == \"cuda\" else torch.float32,\n   441\t                device_map=\"auto\" if self.device != \"cpu\" else None,\n   442\t            )\n   443\t            _debug(f\"Model type: {type(self.florence_model)}\")\n   444\t            _debug(f\"Model class: {self.florence_model.__class__.__name__}\")\n   445\t\n   446\t            # Set to evaluation mode\n   447\t            self.florence_model.eval()\n   448\t            _debug(\"Model set to eval mode\")\n   449\t\n   450\t            self._florence_loaded = True\n   451\t            self._current_florence_model = model_name\n   452\t            _debug(\"=== Florence2 loaded successfully ===\")\n   453\t            return True\n   454\t\n   455\t        except Exception as e:\n   456\t            _debug(\"=== Florence2 load FAILED ===\")\n   457\t            _debug(f\"Error: {e}\")\n   458\t            import traceback\n   459\t\n   460\t            traceback.print_exc()\n   461\t            raise RuntimeError(f\"Failed to load Florence2: {e}\")\n   462\t\n   463\t    def generate_florence(\n   464\t        self, image_path: str, model_key: str = \"base\", detail_level: str = \"detailed\"\n   465\t    ) -> str:\n   466\t        \"\"\"Generate caption using Florence2.\n   467\t\n   468\t        Args:\n   469\t            image_path: Path to image file\n   470\t            model_key: Key from FLORENCE_MODELS dict (base, large, base-ft, large-ft, custom)\n   471\t