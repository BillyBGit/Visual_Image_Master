  import torch\n   836\t\n   837\t                if torch.cuda.is_available():\n   838\t                    torch.cuda.empty_cache()\n   839\t                    _debug(\"PyTorch CUDA cache cleared\")\n   840\t            except Exception:\n   841\t                pass\n   842\t\n   843\t            # Give system time to release resources (helps prevent crashes when switching models)\n   844\t            import time\n   845\t\n   846\t            time.sleep(0.1)\n   847\t\n   848\t            _debug(\"WD14 model unloaded\")\n   849\t\n   850\t    def load_wd14(self, model_key: str = \"vit-v2\") -> bool:\n   851\t        \"\"\"Load WD14 tagger model (lazy loading on first use).\n   852\t\n   853\t        Automatically detects and loads the model in whatever format is available:\n   854\t        - ONNX (.onnx) - preferred, fastest, no PyTorch needed\n   855\t        - SafeTensors (.safetensors) - requires PyTorch/timm\n   856\t        - PyTorch (.bin, .pt, .pth) - requires PyTorch/timm\n   857\t\n   858\t        Args:\n   859\t            model_key: Key from WD14_MODELS dict\n   860\t\n   861\t        Returns:\n   862\t            True if loaded successfully\n   863\t        \"\"\"\n   864\t        import csv\n   865\t\n   866\t        # Resolve model name from key\n   867\t        if model_key in WD14_MODELS:\n   868\t            model_name = WD14_MODELS[model_key][0]  # Tuple: (path, size)\n   869\t        else:\n   870\t            # Fallback to vit-v2\n   871\t            model_name = WD14_MODELS[\"vit-v2\"][0]\n   872\t\n   873\t        # Check if same model is already loaded\n   874\t        if self._wd14_loaded and self._current_wd14_model == model_name:\n   875\t            _debug(f\"WD14 model '{model_name}' already loaded, skipping\")\n   876\t            return True\n   877\t\n   878\t        # Unload current model if a different one is requested\n   879\t        if self._wd14_loaded and self._current_wd14_model != model_name:\n   880\t            _debug(f\"Different model requested, unloading '{self._current_wd14_model}'\")\n   881\t            _debug(\n   882\t                f\"Current model state before unload - loaded: {self._wd14_loaded}, format: {self.wd14_format}\"\n   883\t            )\n   884\t            self.unload_wd14()\n   885\t            _debug(\"Unload complete, continuing with new model load\")\n   886\t\n   887\t        try:\n   888\t            from huggingface_hub import hf_hub_download\n   889\t            import shutil\n   890\t\n   891\t            _debug(\"=== Loading WD14 ===\")\n   892\t            _debug(f\"Model key: {model_key}\")\n   893\t            _debug(f\"Model name: {model_name}\")\n   894\t            _debug(\n   895\t                f\"Current state - _wd14_loaded: {self._wd14_loaded}, model: {self.wd14_model}, tags: {self.wd14_tags}\"\n   896\t            )\n   897\t\n   898\t            # Download and load tags CSV\n   899\t            _debug(\"Step 1: Downloading tags CSV...\")\n   900\t            try:\n   901\t                tags_path = hf_hub_download(model_name, \"selected_tags.csv\")\n   902\t                _debug(f\"Tags CSV downloaded to: {tags_path}\")\n   903\t            except Exception as e:\n   904\t                _debug(f\"Failed to download tags CSV: {e}\")\n   905\t                raise\n   906\t\n   907\t            _debug(\"Step 2: Loading tags from CSV...\")\n   908\t            try:\n   909\t                with open(tags_path, \"r\", encoding=\"utf-8\") as f:\n   910\t                    reader = csv.DictReader(f)\n   911\t                    self.wd14_tags = []\n   912\t                    for row in reader:\n   913\t                        self.wd14_tags.append(\n   914\t                            {\"name\": row[\"name\"], \"category\": int(row[\"category\"])}\n   915\t                        )\n   916\t                _debug(f\"Loaded {len(self.wd14_tags)} tags\")\n   917\t            except Exception as e:\n   918\t                _debug(f\"Failed to load tags: {e}\")\n   919\t                raise\n   920\t\n   921\t            # Check which backends are available\n   922\t            _debug(\"Step 3: Checking available backends...\")\n   923\t            has_onnx = False\n   924\t            has_torch = False\n   925\t            try:\n   926\t                import onnxruntime  # noqa: F401\n   927\t\n   928\t                has_onnx = True\n   929\t                _debug(\"ONNX Runtime available\")\n   930\t            except ImportError:\n   931\t                _debug(\"ONNX Runtime not available\")\n   932\t\n   933\t            try:\n   934\t                import torch  # noqa: F401\n   935\t\n   936\t                has_torch = True\n   937\t                _debug(\"PyTorch available\")\n   938\t            except ImportError:\n   939\t                _debug(\"PyTorch not available\")\n   940\t\n   941\t            if not has_onnx and not has_torch:\n   942\t                raise RuntimeError(\n   943\t                    \"No model backend available. Install onnxruntime or torch: pip install onnxruntime\"\n   944\t                )\n   945\t\n   946\t            # Extract model short name from repository (e.g., \"SmilingWolf/wd-v1-4-vit-tagger-v2\" -> \"wd-v1-4-vit-tagger-v2\")\n   947\t            model_short_name = model_name.split(\"/\")[-1]\n   948\t            _debug(f\"Model short name: {model_short_name}\")\n   949\t\n   950\t            # Check if user has specified a custom path for this model\n   951\t            _debug(\"Step 4: Checking for custom model path...\")\n   952\t            model_path = None\n   953\t            model_format = None\n   954\t\n   955\t            if model_key in self.wd14_custom_paths:\n   956\t                custom_path = self.wd14_custom_paths[model_key]\n   957\t                if os.path.isfile(custom_path):\n   958\t                    _debug(f\"Using custom model path: {custom_path}\")\n   959\t                    model_path = custom_path\n   960\t  