{"type":"tool_use","timestamp":1773385010607,"sessionID":"ses_0cb2a801aad6","part":{"type":"tool","callID":"call_6fltgu5m","tool":"read","state":{"status":"completed","input":{"file_path":"tests/unit/test_caption_generator_get_caption_generator.py"},"output":"     1\t\"\"\"Tests for get_caption_generator singleton behavior.\"\"\"\n     2\t\n     3\timport threading\n     4\t\n     5\tfrom caption_generator import get_caption_generator, CaptionGenerator\n     6\t\n     7\t\n     8\tclass TestGetCaptionGenerator:\n     9\t    \"\"\"Test suite for get_caption_generator singleton behavior.\"\"\"\n    10\t\n    11\t    def test_get_caption_generator_returns_instance(self):\n    12\t        \"\"\"Test that get_caption_generator() returns CaptionGenerator instance.\"\"\"\n    13\t        result = get_caption_generator()\n    14\t        assert isinstance(result, CaptionGenerator)\n    15\t\n    16\t    def test_get_caption_generator_singleton(self):\n    17\t        \"\"\"Test that get_caption_generator() returns same instance on calls.\"\"\"\n    18\t        instance1 = get_caption_generator()\n    19\t        instance2 = get_caption_generator()\n    20\t        assert instance1 is instance2\n    21\t\n    22\t    def test_get_caption_generator_initialization(self):\n    23\t        \"\"\"Test that returned instance has all expected attributes.\"\"\"\n    24\t        instance = get_caption_generator()\n    25\t        assert hasattr(instance, 'florence_model')\n    26\t        assert hasattr(instance, 'wd14_model')\n    27\t        assert instance.florence_model is None\n    28\t        assert instance.wd14_model is None\n    29\t\n    30\t    def test_get_caption_generator_no_side_effects(self):\n    31\t        \"\"\"Test that multiple calls don't create additional instances.\"\"\"\n    32\t        instances = [get_caption_generator() for _ in range(10)]\n    33\t        assert all(instance is instances[0] for instance in instances)\n    34\t\n    35\t    def test_get_caption_generator_thread_safety(self):\n    36\t        \"\"\"Test that get_caption_generator() is thread-safe.\"\"\"\n    37\t        instances = []\n    38\t        threads = []\n    39\t\n    40\t        def get_instance():\n    41\t            instances.append(get_caption_generator())\n    42\t\n    43\t        for _ in range(10):\n    44\t            thread = threading.Thread(target=get_instance)\n    45\t            threads.append(thread)\n    46\t            thread.start()\n    47\t\n    48\t        for thread in threads:\n    49\t            thread.join()\n    50\t\n    51\t        assert all(instance is instances[0] for instance in instances)\n    52\t\n    53\t    def test_get_caption_generator_global_state(self):\n    54\t        \"\"\"Test that the function uses a global variable _generator_instance.\"\"\"\n    55\t        # This is implicitly tested by the singleton behavior\n    56\t        # We can verify by checking the module has this attribute\n    57\t        import caption_generator\n    58\t        assert hasattr(caption_generator, '_generator_instance')\n    59\t\n    60\t    def test_get_caption_generator_initial_state(self):\n    61\t        \"\"\"Test that the returned instance has correct initial state.\"\"\"\n    62\t        instance = get_caption_generator()\n    63\t        assert hasattr(instance, '_florence_loaded')\n    64\t        assert hasattr(instance, '_wd14_loaded')\n    65\t        assert instance._florence_loaded is False\n    66\t        assert instance._wd14_loaded is False","time":{"start":1773385010607,"end":1773385010607}}}}
