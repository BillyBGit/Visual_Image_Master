{"type":"tool_use","timestamp":1773536805785,"sessionID":"ses_3f1a35b2cf79","part":{"type":"tool","callID":"call_8x9slmdt","tool":"write","state":{"status":"completed","input":{"file_path":"tests/unit/test_caption_window_CaptionWindow__setup_menu.py","content":"\"\"\"Tests for CaptionWindow._setup_menu method.\"\"\"\n\nfrom PySide6.QtWidgets import QMenuBar, QMenu, QAction\nfrom caption_window import CaptionWindow\n\n\nclass TestCaptionWindowSetupMenu:\n    \"\"\"Test suite for CaptionWindow._setup_menu method.\"\"\"\n\n    def test_menu_bar_created(self):\n        \"\"\"Test that menuBar() returns a QMenuBar instance.\"\"\"\n        window = CaptionWindow([], 0)\n        menu_bar = window.menuBar()\n        assert isinstance(menu_bar, QMenuBar), \"menuBar() should return a QMenuBar instance\"\n\n    def test_options_menu_created(self):\n        \"\"\"Test that options menu is created in the menu bar.\"\"\"\n        window = CaptionWindow([], 0)\n        menu_bar = window.menuBar()\n        options_menus = menu_bar.findChildren(QMenu, '&Options')\n        assert len(options_menus) == 1, \"Should have exactly one '&Options' menu\"\n\n    def test_fit_to_window_action_created(self):\n        \"\"\"Test that fit to window action is created correctly.\"\"\"\n        window = CaptionWindow([], 0)\n        assert window.fit_act is not None, \"fit_act should be created\"\n        assert isinstance(window.fit_act, QAction), \"fit_act should be a QAction\"\n        assert window.fit_act.text() == '&Fit to Window', \"Action text should be '&Fit to Window'\"\n        assert window.fit_act.isCheckable(), \"Action should be checkable\"\n        assert window.fit_act.isChecked() == window.fit_to_window, \"Checked state should match fit_to_window\"\n\n    def test_native_size_action_created(self):\n        \"\"\"Test that native size action is created correctly.\"\"\"\n        window = CaptionWindow([], 0)\n        assert window.native_act is not None, \"native_act should be created\"\n        assert isinstance(window.native_act, QAction), \"native_act should be a QAction\"\n        assert window.native_act.text() == '&Native Size', \"Action text should be '&Native Size'\"\n        assert window.native_act.isCheckable(), \"Action should be checkable\"\n        assert window.native_act.isChecked() == (not window.fit_to_window), \"Checked state should be opposite of fit_to_window\"\n\n    def test_fit_action_connected_to_toggle_fit_mode(self):\n        \"\"\"Test that fit action is connected to toggle_fit_mode method.\"\"\"\n        window = CaptionWindow([], 0)\n        # Trigger the action and verify the method was called\n        window.fit_act.trigger()\n        # Since we can't directly check signal connections in PySide6,\n        # we verify by checking that the action has a receiver\n        # (This is a workaround as PySide6 doesn't have .receivers() like PyQt5)\n        assert window.fit_act.receivers(window.fit_act.triggered) > 0, \"fit_act.triggered should be connected\"\n\n    def test_native_action_connected_to_set_native_size(self):\n        \"\"\"Test that native size action is connected to set_native_size method.\"\"\"\n        window = CaptionWindow([], 0)\n        # Trigger the action and verify the method was called\n        window.native_act.trigger()\n        # Verify by checking that the action has a receiver\n        assert window.native_act.receivers(window.native_act.triggered) > 0, \"native_act.triggered should be connected\"\n\n    def test_actions_added_to_menu(self):\n        \"\"\"Test that actions are added to the options menu.\"\"\"\n        window = CaptionWindow([], 0)\n        menu_bar = window.menuBar()\n        options_menu = menu_bar.findChildren(QMenu, '&Options')[0]\n        actions = options_menu.actions()\n        assert window.fit_act in actions, \"fit_act should be in options menu actions\"\n        assert window.native_act in actions, \"native_act should be in options menu actions\"\n"},"output":"Wrote 3572 bytes to tests/unit/test_caption_window_CaptionWindow__setup_menu.py","time":{"start":1773536805785,"end":1773536805785}}}}
