ailable()\n            assert available is True\n            assert message == 'WD14 ready (PyTorch)'\n\n    def test_wd14_unavailable_without_backends(self):\n        \"\"\"Test WD14 unavailable when no backends are available.\"\"\"\n        with patch('caption_generator.huggingface_hub'), \\\n             patch('caption_generator.onnxruntime', side_effect=ImportError()), \\\n             patch('caption_generator.torch', side_effect=ImportError()):\n            generator = CaptionGenerator()\n            available, message = generator.is_wd14_available()\n            assert available is False\n            assert message == 'Missing model backend. Install onnxruntime or torch: pip install onnxruntime'\n\n    def test_wd14_unavailable_without_huggingface_hub(self):\n        \"\"\"Test WD14 unavailable when huggingface_hub is not available.\"\"\"\n        with patch('caption_generator.huggingface_hub', side_effect=ImportError()):\n            generator = CaptionGenerator()\n            available, message = generator.is_wd14_available()\n            assert available is False\n            assert message == 'Missing: huggingface_hub. Install with: pip install huggingface-hub'\n\n    def test_wd14_available_with_custom_paths(self):\n        \"\"\"Test WD14 availability with custom paths for WD14 models.\"\"\"\n        with patch('caption_generator.onnxruntime'), \\\n             patch('caption_generator.torch'), \\\n             patch('caption_generator.huggingface_hub'):\n            generator = CaptionGenerator()\n            available, message = generator.is_wd14_available()\n            assert available is True\n            assert message == 'WD14 ready (ONNX, PyTorch)'\n\n    def test_wd14_available_with_mixed_backends(self):\n        \"\"\"Test WD14 availability with mixed backends in different scenarios.\"\"\"\n        # Test with only ONNX\n        with patch('caption_generator.onnxruntime'), \\\n             patch('caption_generator.huggingface_hub'), \\\n       