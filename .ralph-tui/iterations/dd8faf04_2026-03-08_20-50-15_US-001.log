  202\t                False,\n   203\t                f\"Missing '{missing}' \u2014 install with: pip install transformers torch\",\n   204\t            )\n   205\t\n   206\t    def is_wd14_available(self) -> Tuple[bool, str]:\n   207\t        \"\"\"Check if WD14 dependencies are available.\n   208\t\n   209\t        Returns:\n   210\t            Tuple of (available, message)\n   211\t        \"\"\"\n   212\t        # Check for at least one model loading backend\n   213\t        has_onnx = False\n   214\t        has_torch = False","time":{"start":1772963470217,"end":1772963470217}}}}
