{"type":"tool_use","timestamp":1773388582387,"sessionID":"ses_c9bfb522b495","part":{"type":"tool","callID":"call_bs80xza5","tool":"read","state":{"status":"completed","input":{"file_path":"tests/unit/test_caption_generator_get_caption_generator.py"},"output":"     1\t\"\"\"Tests for get_caption_generator singleton behavior.\n     2\t\n     3\tTests for the get_caption_generator function which provides\n     4\ta singleton CaptionGenerator instance.\n     5\t\"\"\"\n     6\t\n     7\timport threading\n     8\t\n     9\tfrom caption_generator import get_caption_generator, CaptionGenerator\n    10\t\n    11\t\n    12\tclass TestGetCaptionGenerator:\n    13\t    \"\"\"Test suite for get_caption_generator singleton behavior.\"\"\"\n    14\t\n    15\t    def test_get_caption_generator_returns_instance(self):\n    16\t        \"\"\"Test that get_caption_generator() returns\n    17\t        a CaptionGenerator instance.\"\"\"\n    18\t        result = get_caption_generator()\n    19\t        assert isinstance(result, CaptionGenerator)\n    20\t\n    21\t    def test_get_caption_generator_singleton(self):\n    22\t        \"\"\"Test that get_caption_generator() returns\n    23\tthe same instance on multiple calls.\"\"\"\n    24\t        instance1 = get_caption_generator()\n    25\t        instance2 = get_caption_generator()\n    26\t        assert instance1 is instance2\n    27\t\n    28\t    def test_get_caption_generator_initialization(self):\n    29\t        \"\"\"Test that the returned instance has all expected attributes.\"\"\"\n    30\t        instance = get_caption_generator()\n    31\t        assert hasattr(instance, 'florence_model')\n    32\t        assert hasattr(instance, 'wd14_model')\n    33\t        assert instance.florence_model is None\n    34\t        assert instance.wd14_model is None\n    35\t\n    36\t    def test_get_caption_generator_no_side_effects(self):\n    37\t        \"\"\"Test that multiple calls don't create additional instances.\"\"\"\n    38\t        instances = [get_caption_generator() for _ in range(10)]\n    39\t        assert all(instance is instances[0] for instance in instances)\n    40\t\n    41\t    def test_get_caption_generator_thread_safety(self):\n    42\t        \"\"\"Test that get_caption_generator() is thread-safe.\"\"\"\n    43\t        instances = []\n    44\t        threads = []\n    45\t\n    46\t        def get_instance():\n    47\t            instances.append(get_caption_generator())\n    48\t\n    49\t        for _ in range(10):\n    50\t            thread = threading.Thread(target=get_instance)\n    51\t            threads.append(thread)\n    52\t            thread.start()\n    53\t\n    54\t        for thread in threads:\n    55\t            thread.join()\n    56\t\n    57\t        assert all(instance is instances[0]\n    58\t                   for instance in instances)\n    59\t\n    60\t    def test_get_caption_generator_global_state(self):\n    61\t        \"\"\"Test that the function uses a global variable _generator_instance.\"\"\"\n    62\t        # This is implicitly tested by the singleton behavior\n    63\t        # We can verify by checking the module has this attribute\n    64\t        import caption_generator\n    65\t        assert hasattr(caption_generator, '_generator_instance')\n    66\t\n    67\t    def test_get_caption_generator_initial_state(self):\n    68\t        \"\"\"Test that the returned instance has correct initial state.\"\"\"\n    69\t        instance = get_caption_generator()\n    70\t        assert hasattr(instance, '_florence_loaded')\n    71\t        assert hasattr(instance, '_wd14_loaded')\n    72\t        assert instance._florence_loaded is False\n    73\t        assert instance._wd14_loaded is False","time":{"start":1773388582387,"end":1773388582387}}}}
