{"type":"tool_use","timestamp":1773592067798,"sessionID":"ses_bdfd550148dd","part":{"type":"tool","callID":"call_tkr7m8sw","tool":"write","state":{"status":"completed","input":{"content":"\"\"\"Tests for CaptionWindow._load_settings method.\"\"\"\n\nfrom unittest.mock import MagicMock, patch\nfrom PySide6.QtWidgets import QApplication, QComboBox, QLineEdit, QDoubleSpinBox, QPlainTextEdit\nfrom caption_window import CaptionWindow\n\n\nclass TestCaptionWindowLoadSettings:\n    \"\"\"Test suite for CaptionWindow._load_settings method.\"\"\"\n\n    def test_load_settings_with_parent_app(self):\n        \"\"\"Test loading settings from parent app with all values set.\"\"\"\n        # Create mock parent app with all settings\n        parent_app = MagicMock()\n        parent_app.caption_backend = \"florence2\"\n        parent_app.caption_florence_model = \"large\"\n        parent_app.caption_florence_detail = \"concise\"\n        parent_app.caption_florence_custom_path = \"/path/to/model\"\n        parent_app.caption_ollama_url = \"http://custom:11434\"\n        parent_app.caption_ollama_model = \"custom-model\"\n        parent_app.caption_wd14_model = \"convnext\"\n        parent_app.caption_wd14_threshold = 0.75\n        parent_app.caption_wd14_custom_paths = {\"custom\": \"/path/to/custom\"}\n        parent_app.caption_blend_instructions = \"Blend instructions\"\n        parent_app.caption_blend_model = \"blend-model\"\n\n        # Create CaptionWindow with parent_app stored separately\n        window = CaptionWindow([], 0, parent=None)\n        window.parent_app = parent_app\n\n        # Call the method\n        window._load_settings()\n\n        # Verify backend selection\n        assert window.backend_combo.currentData() == \"florence2\"\n        # Verify Florence2 settings\n        assert window.florence_model_combo.currentData() == \"large\"\n        assert window.florence_detail_combo.currentData() == \"concise\"\n        assert window.florence_custom_path.text() == \"/path/to/model\"\n        # Verify Ollama settings\n        assert window.ollama_url.text() == \"http://custom:11434\"\n        assert window.ollama_model.text() == \"custom-model\"\n        # Verify WD14 settings\n        assert window.wd14_model_combo.currentData() == \"convnext\"\n        assert window.wd14_threshold.value() == 0.75\n        # Verify blend instructions\n        assert window.blend_instructions.toPlainText() == \"Blend instructions\"\n\n    def test_load_settings_without_parent_app(self):\n        \"\"\"Test that _load_settings returns early when no parent app is provided.\"\"\"\n        # Create CaptionWindow without parent\n        window = CaptionWindow([], 0, parent=None)\n        window.parent_app = None\n\n        # Store initial state\n        initial_backend = window.backend_combo.currentData()\n\n        # Call the method\n        window._load_settings()\n\n        # Verify no modifications were made\n        assert window.backend_combo.currentData() == initial_backend\n\n    def test_load_settings_with_defaults(self):\n        \"\"\"Test loading settings when parent app has no custom settings.\"\"\"\n        # Create mock parent app with no settings\n        parent_app = MagicMock()\n\n        # Create CaptionWindow with parent_app stored separately\n        window = CaptionWindow([], 0, parent=None)\n        window.parent_app = parent_app\n\n        # Call the method\n        window._load_settings()\n\n        # Verify default values are set\n        assert window.backend_combo.currentData() == \"florence2\"\n        assert window.florence_model_combo.currentData() == \"base\"\n        assert window.florence_detail_combo.currentData() == \"detailed\"\n        assert window.florence_custom_path.text() == \"\"\n        assert window.ollama_url.text() == \"http://localhost:11434\"\n        assert window.ollama_model.text() == \"llava\"\n        assert window.wd14_model_combo.currentData() == \"vit-v2\"\n        assert window.wd14_threshold.value() == 0.55\n        assert window.blend_instructions.toPlainText() == \"\"\n\n    def test_load_settings_with_custom_wd14_path(self):\n        \"\"\"Test loading custom WD14 paths.\"\"\"\n        # Create mock parent app with custom paths\n        parent_app = MagicMock()\n        parent_app.caption_wd14_model = \"custom\"\n        parent_app.caption_wd14_custom_paths = {\"custom\": \"/path/to/custom\"}\n\n        # Create CaptionWindow with parent_app stored separately\n        window = CaptionWindow([], 0, parent=None)\n        window.parent_app = parent_app\n\n        # Call the method\n        window._load_settings()\n\n        # Verify custom path is set\n        assert window.wd14_model_combo.currentData() == \"custom\"\n        assert window.wd14_custom_path.text() == \"/path/to/custom\"\n\n    def test_load_settings_with_empty_blend_instructions(self):\n        \"\"\"Test that empty blend instructions don't modify the widget.\"\"\"\n        # Create mock parent app with empty blend instructions\n        parent_app = MagicMock()\n        parent_app.caption_blend_instructions = \"\"\n\n        # Create CaptionWindow with parent_app stored separately\n        window = CaptionWindow([], 0, parent=None)\n        window.parent_app = parent_app\n\n        # Store initial state\n        initial_text = window.blend_instructions.toPlainText()\n\n        # Call the method\n        window._load_settings()\n\n        # Verify the widget wasn't modified\n        assert window.blend_instructions.toPlainText() == initial_text\n\n    def test_load_settings_with_invalid_backend(self):\n        \"\"\"Test that invalid backend doesn't crash the method.\"\"\"\n        # Create mock parent app with invalid backend\n        parent_app = MagicMock()\n        parent_app.caption_backend = \"invalid_backend\"\n\n        # Create CaptionWindow with parent_app stored separately\n        window = CaptionWindow([], 0, parent=None)\n        window.parent_app = parent_app\n\n        # Store initial state\n        initial_backend = window.backend_combo.currentData()\n\n        # Call the method\n        window._load_settings()\n\n        # Verify the method doesn't crash and doesn't change the backend\n        assert window.backend_combo.currentData() == initial_backend\n\n    def test_load_settings_with_invalid_model(self):\n        \"\"\"Test that invalid Florence2 model doesn't crash the method.\"\"\"\n        # Create mock parent app with invalid model\n        parent_app = MagicMock()\n        parent_app.caption_florence_model = \"invalid_model\"\n\n        # Create CaptionWindow with parent_app stored separately\n        window = CaptionWindow([], 0, parent=None)\n        window.parent_app = parent_app\n\n        # Store initial state\n        initial_model = window.florence_model_combo.currentData()\n\n        # Call the method\n        window._load_settings()\n\n        # Verify the method doesn't crash and doesn't change the model\n        assert window.florence_model_combo.currentData() == initial_model\n","file_path":"tests/unit/test_caption_window_CaptionWindow__load_settings.py"},"output":"Wrote 6583 bytes to tests/unit/test_caption_window_CaptionWindow__load_settings.py","time":{"start":1773592067798,"end":1773592067798}}}}
