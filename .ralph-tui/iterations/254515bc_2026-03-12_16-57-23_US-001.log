{"type":"tool_use","timestamp":1773296843373,"sessionID":"ses_20a5430c3f76","part":{"type":"tool","callID":"call_let13hnt","tool":"write","state":{"status":"completed","input":{"content":"\"\"\"Tests for CaptionGenerator._load_wd14_pytorch method.\"\"\"\n\nimport tempfile\nimport os\nfrom unittest.mock import patch, MagicMock\nimport torch\nimport pytest\n\nfrom caption_generator import CaptionGenerator, _debug\n\n\nclass TestCaptionGeneratorLoadWD14PyTorch:\n    \"\"\"Test suite for CaptionGenerator._load_wd14_pytorch method.\"\"\"\n\n    def test_load_wd14_pytorch_with_safetensors(self):\n        \"\"\"Test loading WD14 model with SafeTensors format.\"\"\"\n        # Create CaptionGenerator instance\n        caption_gen = CaptionGenerator()\n        \n        # Mock wd14_tags\n        caption_gen.wd14_tags = [\"tag1\", \"tag2\", \"tag3\", \"tag4\", \"tag5\"]\n        \n        # Create a temporary SafeTensors file\n        with tempfile.NamedTemporaryFile(suffix='.safetensors', delete=False) as f:\n            temp_file = f.name\n        \n        try:\n            # Mock the necessary components\n            with patch('caption_generator._debug') as mock_debug, \\\n                 patch('safetensors.torch.load_file') as mock_load_file, \\\n                 patch('timm.create_model') as mock_create_model, \\\n                 patch.object(caption_gen, '_infer_wd14_architecture_and_size') as mock_infer:\n                \n                # Setup mocks\n                mock_load_file.return_value = {\"key\": torch.randn(10, 10)}\n                mock_infer.return_value = ('vit_base_patch16_224', 448)\n                mock_model = MagicMock()\n                mock_create_model.return_value = mock_model\n                \n                # Call the method\n                result = caption_gen._load_wd14_pytorch(\n                    temp_file, \n                    model_key='vit-v2', \n                    format_type='safetensors'\n                )\n                \n                # Assertions\n                assert result == 448\n                mock_load_file.assert_called_once_with(temp_file)\n                mock_infer.assert_called_once()\n                mock_create_model.assert_called_once()\n                mock_model.load_state_dict.assert_called_once()\n        finally:\n            os.unlink(temp_file)\n\n    def test_load_wd14_pytorch_with_pytorch_format(self):\n        \"\"\"Test loading WD14 model with PyTorch format.\"\"\"\n        # Create CaptionGenerator instance\n        caption_gen = CaptionGenerator()\n        \n        # Mock wd14_tags\n        caption_gen.wd14_tags = [\"tag1\", \"tag2\", \"tag3\", \"tag4\", \"tag5\", \"tag6\", \"tag7\", \"tag8\", \"tag9\", \"tag10\"]\n        \n        # Create a temporary PyTorch file\n        with tempfile.NamedTemporaryFile(suffix='.pth', delete=False) as f:\n            temp_file = f.name\n        \n        try:\n            # Mock the necessary components\n            with patch('caption_generator._debug') as mock_debug, \\\n                 patch('torch.load') as mock_torch_load, \\\n                 patch('timm.create_model') as mock_create_model, \\\n                 patch.object(caption_gen, '_infer_wd14_architecture_and_size') as mock_infer:\n                \n                # Setup mocks\n                mock_torch_load.return_value = {\"key\": torch.randn(10, 10)}\n                mock_infer.return_value = ('swinv2_base_window14_224', 448)\n                mock_model = MagicMock()\n                mock_create_model.return_value = mock_model\n                \n                # Call the method\n                result = caption_gen._load_wd14_pytorch(\n                    temp_file, \n                    model_key='swinv2-v2', \n                    format_type='pytorch'\n                )\n                \n                # Assertions\n                assert result == 448\n                mock_torch_load.assert_called_once_with(temp_file, map_location='cuda')  # Assuming CUDA is available\n                mock_infer.assert_called_once()\n                mock_create_model.assert_called_once()\n                mock_model.load_state_dict.assert_called_once()\n        finally:\n            os.unlink(temp_file)\n\n    def test_load_wd14_pytorch_invalid_format(self):\n        \"\"\"Test loading WD14 model with invalid format.\"\"\"\n        # Create CaptionGenerator instance\n        caption_gen = CaptionGenerator()\n        \n        # Create a temporary file\n        with tempfile.NamedTemporaryFile(suffix='.bin', delete=False) as f:\n            temp_file = f.name\n        \n        try:\n            # Mock the necessary components\n            with patch('caption_generator._debug') as mock_debug:\n                # Call the method with invalid format\n                with pytest.raises(Exception):\n                    caption_gen._load_wd14_pytorch(\n                        temp_file, \n                        model_key='vit-v2', \n                        format_type='invalid'\n                    )\n        finally:\n            os.unlink(temp_file)\n\n    def test_load_wd14_pytorch_missing_file(self):\n        \"\"\"Test loading WD14 model with non-existent file.\"\"\"\n        # Create CaptionGenerator instance\n        caption_gen = CaptionGenerator()\n        \n        # Call the method with non-existent file\n        with pytest.raises(Exception):\n            caption_gen._load_wd14_pytorch(\n                '/non/existent/file.safetensors', \n                model_key='vit-v2', \n                format_type='safetensors'\n            )\n\n    def test_load_wd14_pytorch_device_selection(self):\n        \"\"\"Test device selection when CUDA and MPS are not available.\"\"\"\n        # Create CaptionGenerator instance\n        caption_gen = CaptionGenerator()\n        \n        # Mock wd14_tags\n        caption_gen.wd14_tags = [\"tag1\", \"tag2\", \"tag3\", \"tag4\", \"tag5\"]\n        \n        # Create a temporary SafeTensors file\n        with tempfile.NamedTemporaryFile(suffix='.safetensors', delete=False) as f:\n            temp_file = f.name\n        \n        try:\n            # Mock the necessary components\n            with patch('caption_generator._debug') as mock_debug, \\\n                 patch('safetensors.torch.load_file') as mock_load_file, \\\n                 patch('timm.create_model') as mock_create_model, \\\n                 patch.object(caption_gen, '_infer_wd14_architecture_and_size') as mock_infer, \\\n                 patch('torch.cuda.is_available', return_value=False), \\\n                 patch('torch.backends.mps.is_available', return_value=False):\n                \n                # Setup mocks\n                mock_load_file.return_value = {\"key\": torch.randn(10, 10)}\n                mock_infer.return_value = ('vit_base_patch16_224', 448)\n                mock_model = MagicMock()\n                mock_create_model.return_value = mock_model\n                \n                # Call the method\n                result = caption_gen._load_wd14_pytorch(\n                    temp_file, \n                    model_key='vit-v2', \n                    format_type='safetensors'\n                )\n                \n                # Assertions\n                assert result == 448\n                mock_model.to.assert_called_once_with('cpu')\n        finally:\n            os.unlink(temp_file)\n\n    def test_load_wd14_pytorch_architecture_inference(self):\n        \"\"\"Test architecture inference and image size return.\"\"\"\n        # Create CaptionGenerator instance\n        caption_gen = CaptionGenerator()\n        \n        # Mock wd14_tags\n        caption_gen.wd14_tags = [\"tag1\", \"tag2\", \"tag3\", \"tag4\", \"tag5\"]\n        \n        # Create a temporary SafeTensors file\n        with tempfile.NamedTemporaryFile(suffix='.safetensors', delete=False) as f:\n            temp_file = f.name\n        \n        try:\n            # Mock the necessary components\n            with patch('caption_generator._debug') as mock_debug, \\\n                 patch('safetensors.torch.load_file') as mock_load_file, \\\n                 patch('timm.create_model') as mock_create_model, \\\n                 patch.object(caption_gen, '_infer_wd14_architecture_and_size') as mock_infer:\n                \n                # Setup mocks\n                mock_load_file.return_value = {\"key\": torch.randn(10, 10)}\n                mock_infer.return_value = ('vit_base_patch16_224', 448)\n                mock_model = MagicMock()\n                mock_create_model.return_value = mock_model\n                \n                # Call the method\n                result = caption_gen._load_wd14_pytorch(\n                    temp_file, \n                    model_key='vit-v2', \n                    format_type='safetensors'\n                )\n                \n                # Assertions\n                assert result == 448\n                mock_infer.assert_called_once()\n        finally:\n            os.unlink(temp_file)\n\n    def test_load_wd14_pytorch_weight_loading(self):\n        \"\"\"Test that model weights are loaded correctly.\"\"\"\n        # Create CaptionGenerator instance\n        caption_gen = CaptionGenerator()\n        \n        # Mock wd14_tags\n        caption_gen.wd14_tags = [\"tag1\", \"tag2\", \"tag3\", \"tag4\", \"tag5\"]\n        \n        # Create a temporary SafeTensors file\n        with tempfile.NamedTemporaryFile(suffix='.safetensors', delete=False) as f:\n            temp_file = f.name\n        \n        try:\n            # Mock the necessary components\n            with patch('caption_generator._debug') as mock_debug, \\\n                 patch('safetensors.torch.load_file') as mock_load_file, \\\n                 patch('timm.create_model') as mock_create_model, \\\n                 patch.object(caption_gen, '_infer_wd14_architecture_and_size') as mock_infer:\n                \n                # Setup mocks\n                mock_state_dict = {\"layer1.weight\": torch.randn(10, 10), \"layer1.bias\": torch.randn(10)}\n                mock_load_file.return_value = mock_state_dict\n                mock_infer.return_value = ('vit_base_patch16_224', 448)\n                mock_model = MagicMock()\n                mock_create_model.return_value = mock_model\n                \n                # Call the method\n                result = caption_gen._load_wd14_pytorch(\n                    temp_file, \n                    model_key='vit-v2', \n                    format_type='safetensors'\n                )\n                \n                # Assertions\n                assert result == 448\n                mock_model.load_state_dict.assert_called_once_with(mock_state_dict, strict=False)\n        finally:\n            os.unlink(temp_file)\n","file_path":"tests/unit/test_caption_generator_CaptionGenerator__load_wd14_pytorch.py"},"output":"Wrote 10266 bytes to tests/unit/test_caption_generator_CaptionGenerator__load_wd14_pytorch.py","time":{"start":1773296843373,"end":1773296843373}}}}
