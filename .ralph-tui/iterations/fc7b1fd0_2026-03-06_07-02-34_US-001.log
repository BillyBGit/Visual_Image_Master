{"type":"tool_use","timestamp":1772742128237,"sessionID":"ses_79ffac38a116","part":{"type":"tool","callID":"call_esexwpv0","tool":"read","state":{"status":"completed","input":{"file_path":"advanced_filter_dialog.py","limit":70},"output":"     1\t\"\"\"\n     2\tAdvanced filtering dialog for AI-powered image filtering.\n     3\tCombines face detection, object detection, scene recognition, and quality assessment.\n     4\t\"\"\"\n     5\t\n     6\tfrom PySide6.QtWidgets import (\n     7\t    QDialog,\n     8\t    QVBoxLayout,\n     9\t    QHBoxLayout,\n    10\t    QGroupBox,\n    11\t    QCheckBox,\n    12\t    QLabel,\n    13\t    QPushButton,\n    14\t    QSlider,\n    15\t    QScrollArea,\n    16\t    QWidget,\n    17\t    QRadioButton,\n    18\t    QFileDialog,\n    19\t    QLineEdit,\n    20\t)\n    21\tfrom PySide6.QtCore import Qt\n    22\t\n    23\tfrom object_detection import OBJECT_CATEGORIES\n    24\tfrom scene_recognition import SCENE_GROUPS\n    25\t\n    26\t\n    27\tclass AdvancedFilterDialog(QDialog):\n    28\t    \"\"\"Dialog for configuring advanced AI-powered filters.\"\"\"\n    29\t\n    30\t    def __init__(self, parent=None):\n    31\t        super().__init__(parent)\n    32\t        self.setWindowTitle(\"Advanced AI Filters\")\n    33\t        self.resize(700, 600)\n    34\t\n    35\t        # Store filter settings\n    36\t        self.filter_settings = {\n    37\t            \"global_invert\": False,  # Invert entire filter result\n    38\t            \"face_detection\": False,\n    39\t            \"face_count_min\": 0,\n    40\t            \"face_inverse\": False,  # True = does NOT contain\n    41\t            \"object_detection\": False,\n    42\t            \"object_categories\": [],\n    43\t            \"object_confidence\": 0.5,\n    44\t            \"object_inverse\": False,  # True = does NOT contain\n    45\t            \"custom_model_path\": None,  # Path to custom YOLO model\n    46\t            \"scene_recognition\": False,\n    47\t            \"scene_groups\": [],\n    48\t            \"scene_confidence\": 0.3,\n    49\t            \"scene_inverse\": False,  # True = does NOT contain\n    50\t            \"quality_filter\": False,\n    51\t            \"quality_min_score\": 60,\n    52\t            \"quality_sharpness_min\": 40,\n    53\t            \"quality_brightness_min\": 50,\n    54\t            \"quality_brightness_max\": 200,\n    55\t            \"quality_inverse\": False,  # True = does NOT meet criteria\n    56\t            \"filesize_filter\": False,\n    57\t            \"filesize_min_kb\": 0,  # Minimum file size in KB\n    58\t            \"filesize_max_kb\": 10240,  # Maximum file size in KB (10MB default)\n    59\t        }\n    60\t\n    61\t        self.setup_ui()\n    62\t\n    63\t    def setup_ui(self):\n    64\t        \"\"\"Setup the dialog UI.\"\"\"\n    65\t        main_layout = QVBoxLayout()\n    66\t\n    67\t        # Create scroll area for filters\n    68\t        scroll = QScrollArea()\n    69\t        scroll.setWidgetResizable(True)\n    70\t        scroll_widget = QWidget()","time":{"start":1772742128237,"end":1772742128237}}}}
