{"type":"tool_use","timestamp":1772741710352,"sessionID":"ses_79ffac38a116","part":{"type":"tool","callID":"call_v8abwslf","tool":"bash","state":{"status":"completed","input":{"command":"cat tests/unit/test_advanced_filter_dialog_AdvancedFilterDialog___init__.py"},"output":"\"\"\"Tests for AdvancedFilterDialog.__init__ method.\"\"\"\nimport pytest\nfrom unittest.mock import patch\nfrom PyQt6.QtWidgets import QWidget\nfrom advanced_filter_dialog import AdvancedFilterDialog\n\n\nclass TestAdvancedFilterDialogInit:\n    \"\"\"Test suite for AdvancedFilterDialog initialization.\"\"\"\n\n    def test_init_sets_window_title(self):\n        \"\"\"Test that AdvancedFilterDialog sets the correct window title.\"\"\"\n        dialog = AdvancedFilterDialog()\n        assert dialog.windowTitle() == \"Advanced AI Filters\"\n\n    def test_init_sets_window_size(self):\n        \"\"\"Test that AdvancedFilterDialog sets the correct window size.\"\"\"\n        dialog = AdvancedFilterDialog()\n        assert dialog.width() == 700\n        assert dialog.height() == 600\n\n    def test_init_initializes_filter_settings(self):\n        \"\"\"Test that AdvancedFilterDialog initializes filter_settings with required keys.\"\"\"\n        dialog = AdvancedFilterDialog()\n        assert isinstance(dialog.filter_settings, dict)\n        \n        # Check all required keys exist\n        required_keys = [\n            \"global_invert\", \"face_detection\", \"face_count_min\", \"face_inverse\",\n            \"object_detection\", \"object_categories\", \"object_confidence\", \"object_inverse\",\n            \"custom_model_path\", \"scene_recognition\", \"scene_groups\", \"scene_confidence\",\n            \"scene_inverse\", \"quality_filter\", \"quality_min_score\", \"quality_sharpness_min\",\n            \"quality_brightness_min\", \"quality_brightness_max\", \"quality_inverse\",\n            \"filesize_filter\", \"filesize_min_kb\", \"filesize_max_kb\"\n        ]\n        \n        for key in required_keys:\n            assert key in dialog.filter_settings, f\"Missing key: {key}\"\n\n    def test_init_calls_setup_ui(self):\n        \"\"\"Test that AdvancedFilterDialog calls setup_ui during initialization.\"\"\"\n        with patch.object(AdvancedFilterDialog, 'setup_ui', return_value=None) as mock_setup:\n            dialog = AdvancedFilterDialog()\n            mock_setup.assert_called_once()\n\n    def test_init_with_parent(self):\n        \"\"\"Test that AdvancedFilterDialog can be created with a parent widget.\"\"\"\n        parent = QWidget()\n        dialog = AdvancedFilterDialog(parent=parent)\n        assert dialog.parent() is parent\n\n    def test_filter_settings_defaults(self):\n        \"\"\"Test that filter_settings has correct default values.\"\"\"\n        dialog = AdvancedFilterDialog()\n        \n        # Verify all default values match the source code\n        assert dialog.filter_settings[\"global_invert\"] is False\n        assert dialog.filter_settings[\"face_detection\"] is False\n        assert dialog.filter_settings[\"face_count_min\"] == 0\n        assert dialog.filter_settings[\"face_inverse\"] is False\n        assert dialog.filter_settings[\"object_detection\"] is False\n        assert dialog.filter_settings[\"object_categories\"] == []\n        assert dialog.filter_settings[\"object_confidence\"] == 0.5\n        assert dialog.filter_settings[\"object_inverse\"] is False\n        assert dialog.filter_settings[\"custom_model_path\"] is None\n        assert dialog.filter_settings[\"scene_recognition\"] is False\n        assert dialog.filter_settings[\"scene_groups\"] == []\n        assert dialog.filter_settings[\"scene_confidence\"] == 0.3\n        assert dialog.filter_settings[\"scene_inverse\"] is False\n        assert dialog.filter_settings[\"quality_filter\"] is False\n        assert dialog.filter_settings[\"quality_min_score\"] == 60\n        assert dialog.filter_settings[\"quality_sharpness_min\"] == 40\n        assert dialog.filter_settings[\"quality_brightness_min\"] == 50\n        assert dialog.filter_settings[\"quality_brightness_max\"] == 200\n        assert dialog.filter_settings[\"quality_inverse\"] is False\n        assert dialog.filter_settings[\"filesize_filter\"] is False\n        assert dialog.filter_settings[\"filesize_min_kb\"] == 0\n        assert dialog.filter_settings[\"filesize_max_kb\"] == 10240\n\n    def test_filter_settings_keys(self):\n        \"\"\"Test that filter_settings contains all expected keys.\"\"\"\n        dialog = AdvancedFilterDialog()\n        \n        expected_keys = [\n            \"global_invert\", \"face_detection\", \"face_count_min\", \"face_inverse\",\n            \"object_detection\", \"object_categories\", \"object_confidence\", \"object_inverse\",\n            \"custom_model_path\", \"scene_recognition\", \"scene_groups\", \"scene_confidence\",\n            \"scene_inverse\", \"quality_filter\", \"quality_min_score\", \"quality_sharpness_min\",\n            \"quality_brightness_min\", \"quality_brightness_max\", \"quality_inverse\",\n            \"filesize_filter\", \"filesize_min_kb\", \"filesize_max_kb\"\n        ]\n        \n        actual_keys = list(dialog.filter_settings.keys())\n        assert sorted(actual_keys) == sorted(expected_keys)\n","time":{"start":1772741710351,"end":1772741710352}}}}
