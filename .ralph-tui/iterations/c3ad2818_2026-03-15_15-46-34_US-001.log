{"type":"tool_use","timestamp":1773550147232,"sessionID":"ses_a1b6b40938b5","part":{"type":"tool","callID":"call_uqt61sv4","tool":"write","state":{"status":"completed","input":{"file_path":"tests/unit/test_caption_window_CaptionWindow__setup_shortcuts.py","content":"\"\"\"Tests for CaptionWindow._setup_shortcuts method.\"\"\"\n\nfrom PySide6.QtWidgets import QShortcut, QApplication\nfrom PySide6.QtGui import QKeySequence\nfrom caption_window import CaptionWindow\nfrom unittest.mock import MagicMock, patch\n\n\nclass TestCaptionWindowSetupShortcuts:\n    \"\"\"Test suite for CaptionWindow._setup_shortcuts method.\"\"\"\n\n    def test_shortcut_save_activated(self):\n        \"\"\"Test that self.shortcut_save is a QShortcut instance.\"\"\"\n        window = CaptionWindow([], 0)\n        window._setup_shortcuts()\n        assert isinstance(window.shortcut_save, QShortcut)\n\n    def test_shortcut_save_connected_to_handler(self):\n        \"\"\"Test that self.shortcut_save.activated is connected to self._on_save_requested.\"\"\"\n        window = CaptionWindow([], 0)\n        window._setup_shortcuts()\n        # Verify connection by checking if the signal is connected\n        # Since PySide6 doesn't have .receivers(), we'll test by triggering\n        mock_handler = MagicMock()\n        window._on_save_requested = mock_handler\n        window.shortcut_save.activated.emit()\n        mock_handler.assert_called_once()\n\n    def test_shortcut_save_key_sequence(self):\n        \"\"\"Test that self.shortcut_save has the correct key sequence.\"\"\"\n        window = CaptionWindow([], 0)\n        window._setup_shortcuts()\n        assert window.shortcut_save.key().toString() == \"Ctrl+S\"\n\n    def test_shortcut_save_parent(self):\n        \"\"\"Test that self.shortcut_save.parent() is the CaptionWindow instance.\"\"\"\n        window = CaptionWindow([], 0)\n        window._setup_shortcuts()\n        assert window.shortcut_save.parent() is window\n\n    def test_shortcut_save_is_enabled(self):\n        \"\"\"Test that self.shortcut_save.isEnabled() returns True.\"\"\"\n        window = CaptionWindow([], 0)\n        window._setup_shortcuts()\n        assert window.shortcut_save.isEnabled()\n\n    def test_no_other_shortcuts_created(self):\n        \"\"\"Test that only one QShortcut instance is created.\"\"\"\n        window = CaptionWindow([], 0)\n        window._setup_shortcuts()\n        # Count all QShortcut instances in the window\n        shortcuts = window.findChildren(QShortcut)\n        assert len(shortcuts) == 1\n        assert shortcuts[0] is window.shortcut_save\n\n    def test_shortcut_save_can_be_triggered(self):\n        \"\"\"Test that triggering the shortcut calls the handler.\"\"\"\n        window = CaptionWindow([], 0)\n        window._setup_shortcuts()\n        \n        # Mock the handler\n        mock_handler = MagicMock()\n        window._on_save_requested = mock_handler\n        \n        # Trigger the shortcut\n        window.shortcut_save.activated.emit()\n        \n        # Verify the handler was called\n        mock_handler.assert_called_once()\n"},"output":"Wrote 2728 bytes to tests/unit/test_caption_window_CaptionWindow__setup_shortcuts.py","time":{"start":1773550147232,"end":1773550147232}}}}
