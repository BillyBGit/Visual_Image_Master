nt(self):\n    36\t        \"\"\"Test that self.shortcut_save.parent() is the CaptionWindow instance.\"\"\"\n    37\t        window = CaptionWindow([], 0)\n    38\t        window._setup_shortcuts()\n    39\t        assert window.shortcut_save.parent() is window\n    40\t\n    41\t    def test_shortcut_save_is_enabled(self):\n    42\t        \"\"\"Test that self.shortcut_save.isEnabled() returns True.\"\"\"\n    43\t        window = CaptionWindow([], 0)\n    44\t        window._setup_shortcuts()\n    45\t        assert window.shortcut_save.isEnabled()\n    46\t\n    47\t    def test_no_other_shortcuts_created(self):\n    48\t        \"\"\"Test that self.shortcut_save is created and exists.\"\"\"\n    49\t        window = CaptionWindow([], 0)\n    50\t        window._setup_shortcuts()\n    51\t        # Just verify that self.shortcut_save exists and is a QShortcut\n    52\t        assert isinstance(window.shortcut_save, QShortcut)\n    53\t        assert window.shortcut_save is not None\n    54\t\n    55\t    def test_shortcut_save_can_be_triggered(self):\n    56\t        \"\"\"Test that triggering the shortcut calls the handler.\"\"\"\n    57\t        window = CaptionWindow([], 0)\n    58\t        window._setup_shortcuts()\n    59\t\n    60\t        # Mock the handler\n    61\t        mock_handler = MagicMock()\n    62\t        window._on_save_requested = mock_handler\n    63\t\n    64\t        # Trigger the shortcut\n    65\t        window.shortcut_save.activated.emit()\n    66\t\n    67\t        # Verify the handler was called\n    68\t        mock_handler.assert_called_once()","time":{"start":1773550584700,"end":1773550584700}}}}
